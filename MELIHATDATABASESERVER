                          $wparts[] = "`".$cname."` LIKE ".$pdo->quote('%'.$qstr.'%');
                      }
                      $where = " WHERE ".implode(' OR ',$wparts);
                  }
              }
              // count
              $totalStmt = $pdo->query("SELECT COUNT(*) FROM `".$table."`".$where);
              $total = $totalStmt->fetchColumn();
              $offset = ($page-1)*$per;
              // make safe integers
              $per = max(1, (int)$per);
              $offset = max(0, (int)$offset);
              $rowsStmt = $pdo->query("SELECT * FROM `".$table."`".$where." LIMIT ".$per." OFFSET ".$offset);
              $rows = $rowsStmt->fetchAll(PDO::FETCH_ASSOC);
          } catch (Exception $e){ flash('Error: '.$e->getMessage()); redirect(basename(__FILE__)); }

          echo '<div class="card"><div style="display:flex;justify-content:space-between;align-items:center">';
          echo '<div><div style="font-weight:800">Table: '.h($table).'</div><div class="small muted">'.h($db).'</div></div>';
          echo '<div class="actions-inline"><form method="post" onsubmit="return confirm(\'Drop table? This is irreversible\')"><input type="hidden" name="action" value="drop_table"><input type="hidden" name="db" value="'.h($db).'"><input type="hidden" name="table" value="'.h($table).'"><button class="secondary" type="submit">Drop table</button></form></div></div>';

          // structure
          echo '<div style="margin-top:10px"><div style="font-weight:700">Structure</div>';
          echo '<table class="table"><thead><tr><th>Column</th><th>Type</th><th>Null</th><th>Key</th><th>Default</th></tr></thead><tbody>';
          foreach($cols as $c){
              echo '<tr><td>'.h($c['COLUMN_NAME']).'</td><td>'.h($c['COLUMN_TYPE']).'</td><td>'.h($c['IS_NULLABLE']).'</td><td>'.h($c['COLUMN_KEY']).'</td><td>'.h($c['COLUMN_DEFAULT']).'</td></tr>';
          }
          echo '</tbody></table></div>';

          // browse
          echo '<div style="margin-top:12px"><div style="display:flex;justify-content:space-between;align-items:center"><div style="font-weight:700">Browse</div><div class="small muted">Rows: '.h($total).'</div></div>';
          echo '<div style="margin-top:8px" class="search-row"><form method="get" style="flex:1"><input type="hidden" name="view" value="table"><input type="hidden" name="db" value="'.h($db).'"><input type="hidden" name="table" value="'.h($table).'"><input class="input" name="q" placeholder="Search (text columns)..." value="'.h($qstr).'"><input class="input" name="limit" style="width:110px" value="'.h($per).'"><button class="btn" type="submit">Apply</button></form></div>';

          // actions: insert, export, import
          echo '<div style="margin-top:8px;display:flex;gap:8px;align-items:center">';
          echo '<a class="secondary" href="'.basename(__FILE__).'?view=insert&db='.urlencode($db).'&table='.urlencode($table).'">Insert row</a>';
          echo '<form method="post" style="display:inline"><input type="hidden" name="action" value="export_csv"><input type="hidden" name="db" value="'.h($db).'"><input type="hidden" name="table" value="'.h($table).'"><button class="secondary" type="submit">Export CSV</button></form>';
          echo '<form method="post" enctype="multipart/form-data" style="display:inline"><input type="hidden" name="action" value="import_csv"><input type="hidden" name="db" value="'.h($db).'"><input type="hidden" name="table" value="'.h($table).'"><input type="file" name="csvfile" required style="display:inline-block"><button class="secondary" type="submit">Import CSV</button></form>';
          echo '</div>';

          // rows table
          if ($rows) {
              echo '<table class="table"><thead><tr>';
              foreach(array_keys($rows[0]) as $c) echo '<th>'.h($c).'</th>';
              echo '<th>Actions</th></tr></thead><tbody>';
              foreach($rows as $r){
                  echo '<tr>';
                  foreach($r as $v) echo '<td>'.h((string)$v).'</td>';
                  // pk json
                  $pkvals = array();
                  foreach($pk as $k) $pkvals[$k] = isset($r[$k]) ? $r[$k] : null;
                  echo '<td>';
                  echo '<a class="secondary" href="'.basename(__FILE__).'?view=edit&db='.urlencode($db).'&table='.urlencode($table).'&pk='.urlencode(base64_encode(json_encode($pkvals))).'">Edit</a> ';
                  echo '<form method="post" style="display:inline" onsubmit="return confirm(\'Delete row?\')">';
                  echo '<input type="hidden" name="action" value="delete_row"><input type="hidden" name="db" value="'.h($db).'"><input type="hidden" name="table" value="'.h($table).'">';
                  echo '<input type="hidden" name="pk_json" value="'.h(json_encode($pkvals)).'">';
                  echo '<button class="secondary" type="submit">Delete</button></form>';
                  echo '</td>';
                  echo '</tr>';
              }
              echo '</tbody></table>';

              // pagination
              $pages = max(1, ceil($total / $per));
              echo '<div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">';
              for($i=1;$i<=$pages && $i<=200;$i++){
                  $style = $i==$page ? 'background:var(--cyan);color:#022;padding:6px 8px;border-radius:6px' : 'background:transparent;border:1px solid rgba(255,255,255,0.03);padding:6px 8px;border-radius:6px';
                  echo '<a class="small" style="'.h($style).'" href="'.basename(__FILE__).'?view=table&db='.urlencode($db).'&table='.urlencode($table).'&p='.$i.'&limit='.$per.'&q='.urlencode($qstr).'">'.h($i).'</a>';
              }
              echo '</div>';
          } else {
              echo '<div class="muted" style="margin-top:8px">No rows</div>';
          }

          echo '</div></div>';
      }

      // insert view
      if ($view === 'insert' && !empty($_GET['db']) && !empty($_GET['table'])) {
          $db = $_GET['db']; $table = $_GET['table']; $_SESSION['dbcfg']['db']=$db; $pdo = pdo_from_session();
          $cols = get_table_columns($pdo,$db,$table);
          echo '<div class="card"><div style="font-weight:800">Insert into '.h($table).'</div>';
          echo '<form method="post"><input type="hidden" name="action" value="insert_row"><input type="hidden" name="db" value="'.h($db).'"><input type="hidden" name="table" value="'.h($table).'">';
          foreach($cols as $c){
              echo '<div class="form-row"><label class="small">'.h($c['COLUMN_NAME']).' <span class="muted">('.h($c['COLUMN_TYPE']).')</span></label>';
              echo '<input class="input" name="col__'.h($c['COLUMN_NAME']).'"></div>';
          }
          echo '<div style="margin-top:8px"><button class="btn" type="submit">Insert</button> <a class="secondary" href="'.basename(__FILE__).'?view=table&db='.urlencode($db).'&table='.urlencode($table).'">Cancel</a></div></form></div>';
      }

      // edit view
      if ($view === 'edit' && !empty($_GET['db']) && !empty($_GET['table']) && !empty($_GET['pk'])) {
          $db = $_GET['db']; $table = $_GET['table']; $pk = json_decode(base64_decode($_GET['pk']), true); $_SESSION['dbcfg']['db']=$db; $pdo = pdo_from_session();
          $cols = get_table_columns($pdo,$db,$table);
          $where=array(); $params=array();
          foreach($pk as $col=>$val){ $where[] = "`".$col."` = :pk_".$col; $params[":pk_".$col] = $val; }
          $stmt = $pdo->prepare("SELECT * FROM `".$table."` WHERE ".implode(' AND ',$where)." LIMIT 1");
          $stmt->execute($params);
          $row = $stmt->fetch(PDO::FETCH_ASSOC);
          if (!$row) { flash('Row not found'); redirect(basename(__FILE__).'?view=table&db='.urlencode($db).'&table='.urlencode($table)); }
          echo '<div class="card"><div style="font-weight:800">Edit row '.h($table).'</div>';
          echo '<form method="post"><input type="hidden" name="action" value="update_row"><input type="hidden" name="db" value="'.h($db).'"><input type="hidden" name="table" value="'.h($table).'">';
          echo '<input type="hidden" name="pk_json" value="'.h(json_encode($pk)).'">';
          foreach($cols as $c){
              $col = $c['COLUMN_NAME'];
              $val = isset($row[$col]) ? $row[$col] : '';
              echo '<div class="form-row"><label class="small">'.h($col).' <span class="muted">('.h($c['COLUMN_TYPE']).')</span></label>';
              echo '<input class="input" name="col__'.h($col).'" value="'.h($val).'"></div>';
          }
          echo '<div style="margin-top:8px"><button class="btn" type="submit">Save</button> <a class="secondary" href="'.basename(__FILE__).'?view=table&db='.urlencode($db).'&table='.urlencode($table).'">Cancel</a></div></form></div>';
      }

      // SQL console
      if ($view === 'sql') {
          echo '<div class="card"><div style="font-weight:800">SQL Console</div>';
          $sql = isset($_SESSION['_last_sql']) ? $_SESSION['_last_sql'] : '';
          if (isset($_SESSION['_last_sql'])) unset($_SESSION['_last_sql']);
          echo '<form method="post"><input type="hidden" name="action" value="run_sql"><textarea name="sql" rows="8" class="input">'.h($sql).'</textarea><div style="margin-top:8px"><button class="btn" type="submit">Run</button></div></form>';
          if ($sql !== '') {
              echo '<div style="margin-top:10px" class="small muted">Query: <code>'.h($sql).'</code></div>';
              try {
                  $pdo = pdo_from_session();
                  $stmt = $pdo->prepare($sql);
                  $stmt->execute();
                  if ($stmt->columnCount() > 0) {
                      $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
                      if ($rows) {
                          echo '<div style="margin-top:8px"><table class="table"><thead><tr>';
                          foreach(array_keys($rows[0]) as $c) echo '<th>'.h($c).'</th>';
                          echo '</tr></thead><tbody>';
                          foreach($rows as $r){ echo '<tr>'; foreach($r as $v) echo '<td>'.h((string)$v).'</td>'; echo '</tr>'; }
                          echo '</tbody></table></div>';
                      } else echo '<div class="muted">No rows</div>';
                  } else {
                      $cnt = $stmt->rowCount();
                      echo '<div class="muted" style="margin-top:8px">Query executed. Affected: '.h($cnt).'</div>';
                  }
              } catch (Exception $e) {
                  echo '<div class="muted" style="margin-top:8px">Error: '.h($e->getMessage()).'</div>';
              }
          }
          echo '</div>';
      }

      // import SQL form (global)
      echo '<div class="card" style="margin-top:12px"><div style="font-weight:700">Import SQL</div>';
      echo '<form method="post" enctype="multipart/form-data" style="margin-top:8px"><input type="hidden" name="action" value="import_sql"><div class="small muted">Target DB:</div><input class="input" name="db" value="'.h(isset($_SESSION['dbcfg']['db'])?$_SESSION['dbcfg']['db']:'').'"><div style="margin-top:8px"><input type="file" name="sqlfile" required></div><div style="margin-top:8px"><button class="secondary" type="submit">Import SQL</button></div></form></div>';

      ?>
    </div>
  </div>

  <div class="footer">phpmyct — single-file MySQL manager · Use only in secure environment</div>
</div>
</body></html>
