/* ---------- TOKEN LIST PARSER (JSON atau YAML mentah) ---------- */
function fum_token_data($result, $raw) {
    $tokens = array();
    if (is_array($result)) {
        $res = isset($result['result']) ? $result['result'] : $result;
        $data = null;
        if (isset($res['data'])) $data = $res['data'];
        elseif (isset($result['data'])) $data = $result['data'];
        if (is_array($data)) {
            if (isset($data['tokens']) && is_array($data['tokens'])) $data = $data['tokens'];
            foreach ($data as $k => $v) {
                if (is_array($v)) {
                    $name = isset($v['name']) ? $v['name'] : (is_string($k) ? $k : '');
                    if ($name != '') {
                        $tokens[] = array('name' => $name,
                            'created' => isset($v['create_time']) ? $v['create_time'] : '',
                            'note' => isset($v['note']) ? $v['note'] : '');
                    }
                } elseif (is_string($v) && preg_match('/^[A-Za-z0-9_-]+$/', strval($k))) {
                    $tokens[] = array('name' => strval($k), 'created' => '', 'note' => '');
                }
            }
        }
        if (count($tokens) > 0) return $tokens;
    }
    // YAML mentah: ambil blok "data:" sampai sebelum errors/messages/metadata/status
    $raw = strval($raw);
    $block = '';
    if (preg_match('/data:\s*\n(.*?)(?=\n\s*(?:errors|messages|metadata|status|warnings):)/s', $raw, $m)) {
        $block = $m[1];
    }
    if ($block != '') {
        // gaya list: "- create_time: ... \n name: lpXXX"
        $names = array();
        $times = array();
        if (preg_match_all('/\bname:\s*[\'"]?([A-Za-z0-9_.-]+)[\'"]?\s*$/m', $block, $mm))
            $names = $mm[1];
        if (preg_match_all('/\bcreate_time:\s*[\'"]?(\d+)[\'"]?/m', $block, $mt))
            $times = $mt[1];
        if (count($names) > 0) {
            for ($i = 0; $i < count($names); $i++) {
                $tokens[] = array('name' => $names[$i],
                    'created' => isset($times[$i]) ? $times[$i] : '', 'note' => '');
            }
            return $tokens;
        }
        // gaya map: "  lpXXX:" sebagai key
        $skip = array('data', 'result', 'errors', 'messages', 'metadata', 'status', 'warnings', 'token', 'create_time', 'whitelists_ip');
        if (preg_match_all('/^\s+([A-Za-z0-9_.-]+):\s*$/m', $block, $mk)) {
            foreach ($mk[1] as $nm) {
                if (!in_array(strtolower($nm), $skip))
                    $tokens[] = array('name' => $nm, 'created' => '', 'note' => '');
            }
        }
    }
    return $tokens;
}

