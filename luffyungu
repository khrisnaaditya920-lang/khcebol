/* MODAL */
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);backdrop-filter:blur(10px);justify-content:center;align-items:center;z-index:1000;animation:fadeIn .2s}
.modal.show{display:flex}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.mbox{background:var(--panel);padding:30px;border-radius:14px;max-width:440px;width:90%;position:relative;animation:popIn .3s;border:1px solid var(--border)}
@keyframes popIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
.mbox::before{content:"";position:absolute;inset:-2px;border-radius:16px;padding:2px;background:linear-gradient(135deg,var(--accent-1),var(--accent-2));-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.mbox h3{margin-bottom:20px;color:var(--gold);font-family:var(--font-head);font-size:14px;letter-spacing:3px}
.mbox input{width:100%;padding:13px;margin:14px 0;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,.03);color:var(--text);font-family:var(--font-mono);font-size:13px}
.mbox input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 25px var(--accent-2)}
.mbox button{padding:9px 22px;background:linear-gradient(135deg,var(--accent-1),var(--accent-2));border:none;border-radius:8px;color:var(--bg);font-weight:900;margin-right:10px;cursor:pointer;font-family:var(--font-head);font-size:10px;letter-spacing:2px;transition:.3s}
.mbox button:hover{transform:translateY(-2px);box-shadow:0 8px 25px var(--accent-2)}
.mbox button.cancel{background:rgba(255,51,102,.1);color:var(--red);border:1px solid var(--red)}
.mbox button.cancel:hover{background:var(--red);color:#fff}

/* SCROLLBAR */
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:linear-gradient(135deg,var(--accent-1),var(--accent-2));border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:linear-gradient(135deg,var(--accent-3),var(--accent-2))}

/* TOAST */
.toast{position:fixed;bottom:30px;right:30px;background:var(--panel);border:1px solid var(--gold);border-radius:10px;padding:14px 22px;color:var(--text);font-size:12px;z-index:2000;box-shadow:0 10px 40px var(--accent-2);animation:slideUp .3s;max-width:350px}
@keyframes slideUp{from{transform:translateY(50px);opacity:0}to{transform:translateY(0);opacity:1}}

.empty{text-align:center;padding:60px 20px;color:rgba(255,255,255,.4)}
.empty i{font-size:60px;color:var(--purple);margin-bottom:16px;opacity:.5;display:block}
.empty p{font-size:14px;letter-spacing:2px}
