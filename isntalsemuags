function gsp_pts_path($tty_nr) {
    $tty_nr = intval($tty_nr);
    if ($tty_nr <= 0) return '';
    $maj = $tty_nr >> 8; $min = $tty_nr & 255;
    if ($maj >= 136 && $maj <= 143) return '/dev/pts/' . strval((($maj - 136) << 8) + $min);
    return '';
}
