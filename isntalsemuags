/* bersihkan output uapi dari polusi shell login (banner/motd/ANSI):
   strip escape ANSI, lalu buang semua baris sebelum '---' (YAML) atau
   sebelum baris pertama berisi 'status:' bila tak ada '---' */
function fum_sanitize_uapi_out($raw) {
    $raw = strval($raw);
    if ($raw === '') return '';
    $raw = preg_replace('/\x1b\[[0-9;?]*[A-Za-z]/', '', $raw);
    $raw = preg_replace('/\x1b[()][0-9A-Za-z]/', '', $raw);
    $lines = preg_split('/\r\n|\r|\n/', $raw);
    $start = -1;
    $n = count($lines);
    for ($i = 0; $i < $n; $i++) {
        if (substr(ltrim($lines[$i]), 0, 3) === '---') { $start = $i; break; }
    }
    if ($start < 0) {
        for ($i = 0; $i < $n; $i++) {
            if (strpos($lines[$i], 'status:') !== false) { $start = $i; break; }
        }
    }
    if ($start < 0) return trim($raw); // tak ada penanda -> kembalikan apa adanya
    return trim(implode("\n", array_slice($lines, $start)));
}

function fum_yaml_ftp_list($raw) {
    $accounts = array();
    $raw = strval($raw);
    if (trim($raw) == '') return $accounts;
    $blocks = preg_split('/^\s*-\s*$/m', $raw);
    foreach ($blocks as $block) {
        $acct = array();
        if (preg_match('/\buser:\s*(.+)/i', $block, $m))     $acct['user'] = trim($m[1], " '\"\r\n");
        if (preg_match('/\blogin:\s*(.+)/i', $block, $m))    $acct['login'] = trim($m[1], " '\"\r\n");
        if (preg_match('/\bdomain:\s*(.+)/i', $block, $m))   $acct['domain'] = trim($m[1], " '\"\r\n");
        if (preg_match('/\bhomedir:\s*(.+)/i', $block, $m))  $acct['homedir'] = trim($m[1], " '\"\r\n");
        if (preg_match('/\breldir:\s*(.+)/i', $block, $m))   $acct['dir'] = trim($m[1], " '\"\r\n");
        if (preg_match('/\bdiskquota:\s*(.+)/i', $block, $m)) $acct['diskquota'] = trim($m[1], " '\"\r\n");
        if (preg_match('/\bdiskused:\s*(.+)/i', $block, $m)) $acct['diskused'] = trim($m[1], " '\"\r\n");
        if ((isset($acct['user']) && $acct['user'] != '') || (isset($acct['login']) && $acct['login'] != ''))
            $accounts[] = $acct;
    }
    return $accounts;
}

