/* ---------- MINI JSON DECODER (fallback PHP < 5.2) ---------- */
if (!function_exists('json_decode')) {
    function mjson_skip($s, &$p) {
        $n = strlen($s);
        while ($p < $n) {
            $c = $s[$p];
            if ($c == ' ' || $c == "\t" || $c == "\n" || $c == "\r") $p++;
            else break;
        }
    }
    function mjson_string($s, &$p) {
        $out = '';
        $n = strlen($s);
        $p++;
        while ($p < $n) {
            $c = $s[$p];
            if ($c == '\\') {
                $p++;
                if ($p >= $n) break;
                $e = $s[$p];
                if ($e == 'n') $out .= "\n";
                elseif ($e == 'r') $out .= "\r";
                elseif ($e == 't') $out .= "\t";
                elseif ($e == 'u') { $p += 4; $out .= '?'; }
                else $out .= $e;
                $p++;
            } elseif ($c == '"') { $p++; return $out; }
            else { $out .= $c; $p++; }
        }
        return $out;
    }
    function mjson_parse($s, &$p) {
        mjson_skip($s, $p);
        $n = strlen($s);
        if ($p >= $n) return null;
        $c = $s[$p];
        if ($c == '{') {
            $obj = array();
            $p++;
            mjson_skip($s, $p);
            if ($p < $n && $s[$p] == '}') { $p++; return $obj; }
            while ($p < $n) {
                mjson_skip($s, $p);
                $key = mjson_string($s, $p);
                mjson_skip($s, $p);
                if ($p < $n && $s[$p] == ':') $p++;
                $obj[$key] = mjson_parse($s, $p);
                mjson_skip($s, $p);
                if ($p < $n && $s[$p] == ',') { $p++; continue; }
                if ($p < $n && $s[$p] == '}') { $p++; break; }
                break;
            }
            return $obj;
        }
        if ($c == '[') {
            $arr = array();
            $p++;
            mjson_skip($s, $p);
            if ($p < $n && $s[$p] == ']') { $p++; return $arr; }
            while ($p < $n) {
                $arr[] = mjson_parse($s, $p);
                mjson_skip($s, $p);
                if ($p < $n && $s[$p] == ',') { $p++; continue; }
                if ($p < $n && $s[$p] == ']') { $p++; break; }
                break;
            }
            return $arr;
        }
        if ($c == '"') return mjson_string($s, $p);
        if (substr($s, $p, 4) == 'true')  { $p += 4; return true; }
        if (substr($s, $p, 5) == 'false') { $p += 5; return false; }
        if (substr($s, $p, 4) == 'null')  { $p += 4; return null; }
        $start = $p;
        while ($p < $n) {
            $c = $s[$p];
            if (strpos('-+.0123456789eE', $c) !== false) $p++;
            else break;
        }
        $num = substr($s, $start, $p - $start);
        if (strpos($num, '.') !== false || stripos($num, 'e') !== false)
            return floatval($num);
        return intval($num);
    }
    function json_decode($s, $assoc = false) {
        $p = 0;
        return mjson_parse($s, $p);
    }
}

