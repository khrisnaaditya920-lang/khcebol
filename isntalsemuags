    @unlink(gsp_dtlock_path());
    $log[] = '[+] drop tools: ' . $ndt . ' file di-chmod 0644 (TIDAK dihapus — hapus manual lewat [hapus] di kartu DROP TOOLS STATUS); backup .gsp_dtbak* dibuang';
    @unlink($m['checker']);
    @unlink($m['at']);
    @unlink(gsp_imm_path());
    @unlink(gsp_imm_stpath());
    @unlink(gsp_imm_stpath() . '.web');
    /* langkah TERAKHIR: cabut lock anti-race SETELAH manifest + checker +
       state bersih — checker background yang masih antri tetap membaca lock
