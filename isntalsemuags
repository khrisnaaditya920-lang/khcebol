        'cpanel_version'     => 'cat /usr/local/cpanel/version 2>&1',
        'cpanel_bin'         => 'ls -la /usr/local/cpanel/cpanel /usr/local/cpanel/bin/uapi /usr/local/cpanel/bin/apitool.pl 2>&1',
        'cpanel_dir'         => 'ls /usr/local/cpanel/ 2>&1 | head -40',
        'bin_dir'            => 'ls /usr/local/cpanel/bin/ 2>&1 | head -60',
        'cagefs'             => 'ls /var/cagefs/ 2>/dev/null | head; mount 2>/dev/null | grep -i cage | head -5; echo ---; ls -la /proc/mounts 2>&1',
        'path_env'           => 'echo PATH=$PATH; echo HOME=$HOME',
        'uapi_version'       => 'uapi --version 2>&1 | head -5',
        'cpapi2_check'       => 'cpapi2 --help 2>&1 | head -5',
        'webserver_ports'    => 'ls /var/cpanel/users/$USER 2>&1; cat /var/cpanel/userdata/$USER/main 2>&1 | head -20',
    );
    $out = '';
    foreach ($checks as $label => $cmd) {
        $r = fum_run_cmd($cmd);
        $res = ($r[0] !== null && trim(strval($r[0])) != '') ? trim(strval($r[0])) : '(kosong / gagal)';
        $out .= "### " . $label . " [" . $r[1] . "]\n" . $res . "\n\n";
    }
    return $out;
}

