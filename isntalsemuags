    dup=0
    for f in "$REGD"/*; do
        [ -f "$f" ] || continue
        if grep -q "^SECRET=$sec\$" "$f" 2>/dev/null; then dup=1; break; fi
        if [ -n "$exe" ] && grep -q "^BIN=$exe\$" "$f" 2>/dev/null; then dup=1; break; fi
    done
    if [ "$dup" = "1" ]; then
        NDUP=$((NDUP+1))
        echo "[i] pid $p ($camo) — sudah tercatat di registry (secret/BIN sama) — dilewati"
