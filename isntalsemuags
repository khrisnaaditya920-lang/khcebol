   diabaikan host -> mode rusak tak berpengaruh), 'skip' (exec nonaktif). */
function gsp_breaker_selftest($so) {
    if (!gsp_shell_ok()) return 'skip';
    $o = gsp_sh('LD_PRELOAD=' . escapeshellarg($so) . ' /bin/true >/dev/null 2>&1; echo GSPBRK:$?');
