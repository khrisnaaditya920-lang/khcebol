        'upload.php'       => 'c7af3b6a4dd96d31e12bcc02678d26b0',
        'rusak_toggle.php' => '7339eb4b3870cf74ece807874a493e6c',
    );
    $out = array();
    $dirty = false;
    foreach ($def as $lbl => $legacy) {
        $m5 = (isset($st['_md5']) && is_array($st['_md5']) && isset($st['_md5'][$lbl]) && preg_match('/^[0-9a-f]{32}$/', $st['_md5'][$lbl]))
            ? $st['_md5'][$lbl] : $legacy;
        $p = (isset($st[$lbl]) && is_string($st[$lbl])) ? $st[$lbl] : '';
