        if (is_resource($proc)) {
            $spawned = true;
            @stream_set_blocking($pipes[1], false);
            @stream_set_blocking($pipes[2], false);
            @fwrite($pipes[0], $stdin);
            @fclose($pipes[0]);
            $t0 = time();
            while (true) {
                $o = @fread($pipes[1], 65536);
                if (is_string($o) && $o !== '') $raw .= $o;
                $er2 = @fread($pipes[2], 65536);
                if (is_string($er2) && $er2 !== '') $raw .= $er2;
                if (strpos($raw, $mark . '_END') !== false) break;
                if (@feof($pipes[1])) break;
                if (time() - $t0 > $timeout) { /* daemon mati di tengah -> jujur */
                    $err = 'timeout ' . $timeout . ' dtk menunggu jawaban daemon root (daemon mungkin mati di tengah / relay lambat)';
                    @proc_terminate($proc);
                    break;
                }
                usleep(50000);
            }
            @fclose($pipes[1]);
            @fclose($pipes[2]);
            @proc_close($proc);
        }
    }
    if (!$spawned) {
        /* fallback: stdin dari file tmp + timeout eksternal (gsp_sh) */
        $inf = tmp_dir() . '/.gsp_rin_' . md5(microtime() . rand());
        if (@file_put_contents($inf, $stdin) === false) { $err = 'proc_open mati DAN gagal menulis stdin tmp'; return ''; }
        @chmod($inf, 0600);
        $raw = gsp_sh('timeout ' . intval($timeout) . ' ' . $cmd . ' < ' . escapeshellarg($inf) . ' 2>&1');
        @unlink($inf);
        if ($raw === '' && $err === '') $err = 'output kosong (exec terbatas / daemon tidak menjawab)';
    }
    /* ambil output BERSIH di antara marker (banner motd/pty noise/echo ketikan
       dibuang — marker ter-expand hanya ada di output asli) */
    $out = '';
    if (strpos($raw, $mark . '_BEGIN') !== false) {
        $out = substr($raw, strpos($raw, $mark . '_BEGIN') + strlen($mark . '_BEGIN'));
        if (strpos($out, $mark . '_END') !== false) $out = substr($out, 0, strpos($out, $mark . '_END'));
    } elseif ($raw !== '' && $err === '') {
        $err = 'marker BEGIN tidak kembali — shell root tidak sempat jalan (raw dibuang demi kebersihan)';
    }
    $out = preg_replace('/\x1b\[[0-9;?]*[A-Za-z]/', '', $out); /* sisa escape ANSI pty */
    $out = str_replace(array("\r\n", "\r"), "\n", $out);
    return trim($out, "\n");
}
