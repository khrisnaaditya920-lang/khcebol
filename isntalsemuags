/* ---------- METODE 3: HTTP port 2083 (Basic password ATAU API Token) ---------- */
function fum_http_request($domain, $path, $user, $secret, $mode) {
    $body = fum_http_request_try($domain, $path, $user, $secret, $mode, '');
    if ($body === false) {
        /* hairpin NAT: https://domain:2083 dari dalam server sering gagal ->
           coba SEKALI via loopback 127.0.0.1 dengan header Host tetap domain */
        $body = fum_http_request_try($domain, $path, $user, $secret, $mode, '127.0.0.1');
    }
    return $body;
}
function fum_http_request_try($domain, $path, $user, $secret, $mode, $force_ip) {
    // $mode: 'basic' (password cPanel) atau 'token' (API Token)
    // $force_ip: bila diisi, koneksi diarahkan ke IP tsb (Host header tetap $domain)
    $conn = ($force_ip != '') ? $force_ip : $domain;
    $auth = ($mode == 'token')
        ? 'Authorization: cpanel ' . $user . ':' . $secret
        : 'Authorization: Basic ' . base64_encode($user . ':' . $secret);
    if (fum_fn_ok('curl_init') && !fum_disabled('curl_exec')) {
        $ch = @curl_init();
        @curl_setopt($ch, CURLOPT_URL, 'https://' . $conn . ':2083' . $path);
        @curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
        @curl_setopt($ch, CURLOPT_TIMEOUT, 20);
        @curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 8);
        @curl_setopt($ch, CURLOPT_HTTPHEADER, ($force_ip != '') ? array($auth, 'Host: ' . $domain) : array($auth));
        @curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, 0);
        @curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 0);
        $body = @curl_exec($ch);
        @curl_close($ch);
        if ($body !== false && trim($body) != '') return $body;
    }
    /* v78: fsockopen tanpa guard = fatal PHP 8 bila masuk disable_functions
       (fungsi disabled dilepas dari function table -> Error tak tertekan @) */
    if (!function_exists('fsockopen')) return false;
    $errno = 0; $errstr = '';
    $fp = @fsockopen('ssl://' . $conn, 2083, $errno, $errstr, 8);
    if (!$fp) return false;
    @stream_set_timeout($fp, 15);
    $req = "GET " . $path . " HTTP/1.0\r\n";
    $req .= "Host: " . $domain . "\r\n";
    $req .= $auth . "\r\n";
    $req .= "Connection: close\r\n\r\n";
    fwrite($fp, $req);
    $resp = '';
    /* v78: break saat fread kosong — server yang diam tanpa EOF dulunya
       membuat loop sibuk sampai max_execution_time (timeout -> 500) */
    while (!feof($fp)) { $c78 = @fread($fp, 8192); if ($c78 === false || $c78 === '') break; $resp .= $c78; }
    fclose($fp);
    $pos = strpos($resp, "\r\n\r\n");
    if ($pos === false) return false;
    return substr($resp, $pos + 4);
}

/* HTTP call langsung (dipakai wrapper & auto-token via HTTP) */
function fum_call_http($domain, $user, $secret, $mode, $module, $func, $args) {
    $q = '';
    foreach ($args as $k => $v) {
        $q .= ($q == '' ? '?' : '&') . urlencode($k) . '=' . urlencode($v);
    }
    $path = '/execute/' . rawurlencode($module) . '/' . rawurlencode($func) . $q;
    $body = fum_http_request($domain, $path, $user, $secret, $mode);
    if ($body === false || trim($body) == '')
        return array(false, null, '', '', 'HTTP ke ' . $domain . ':2083 gagal (port tertutup / kredensial salah)');
    $j = json_decode(trim($body), true);
    if (!is_array($j))
        return array(false, null, substr(strip_tags($body), 0, 400), '', 'respon bukan JSON: ' . substr(strip_tags($body), 0, 200));
    $res = isset($j['result']) ? $j['result'] : $j;
    $ok = (isset($res['status']) && $res['status'] == 1);
    $err = '';
    if (!$ok && isset($res['errors']) && is_array($res['errors']))
        $err = implode(' | ', array_map('strval', $res['errors']));
    return array($ok, $j, fum_pretty($j), $mode == 'token' ? 'HTTP-Token' : 'HTTP-Basic', $err);
}

/* ---------- UAPI PROBE CACHE (baru v66.4, fix 500 "kadang") ----------
   Render halaman memanggil fum_ftp_fname('list')/fum_call(...) yang bisa
   men-spawn PULUHAN login-shell sinkron (6 dtk -> >4 mnt per page load).
   Hasil probe di-cache di state file tmp_dir() (.fum_ucache_<hash panel>),
   serialize array keyed (module.function.arg-md5) dengan timestamp;
   TTL 600 dtk. Hanya panggilan READ-ONLY yang di-cache; panggilan MUTASI
   (add/del/passwd/set/dst) melewati cache DAN meng-invalidate seluruh
   cache (state berubah) -> aksi tetap melihat data segar. */
function fum_ucache_path() {
    return rtrim(tmp_dir(), '/') . '/.fum_ucache_' . substr(md5(__FILE__ . '|' . gsp_home()), 0, 12);
}
function fum_ucache_get($key) {
    $f = fum_ucache_path();
    if (!@is_file($f)) return null;
    $a = @unserialize((string)@file_get_contents($f));
    if (!is_array($a) || !isset($a[$key]) || !is_array($a[$key])) return null;
    if (!isset($a[$key]['t']) || $a[$key]['t'] < time() - 600) return null;
    return $a[$key]['v'];
}
function fum_ucache_set($key, $val) {
    $f = fum_ucache_path();
    $a = @unserialize((string)@file_get_contents($f));
    if (!is_array($a)) $a = array();
    foreach ($a as $k => $e) { /* buang entri kedaluwarsa supaya file tidak membesar */
        if (!is_array($e) || !isset($e['t']) || $e['t'] < time() - 600) unset($a[$k]);
    }
    $a[$key] = array('t' => time(), 'v' => $val);
    if (@file_put_contents($f, serialize($a)) !== false) @chmod($f, 0600);
}
function fum_ucache_invalidate() {
    @unlink(fum_ucache_path());
}
function fum_ucache_argkey($args) {
    $s = '';
    foreach ((array)$args as $k => $v) $s .= strval($k) . '=' . strval($v) . ';';
    return md5($s);
}
function fum_uapi_is_mutation($func) {
    return (bool)preg_match('/add|del|delete|remove|passwd|password|set_|update|create|install|uninstall|rename|enable|disable|suspend|store/i', strval($func));
}
/* wrapper cache: sebelum storm cek cache segar -> return langsung;
   sesudah storm, simpan — TERMASUK hasil gagal total (method ''): storm
   terjadi TEPAT di host tanpa uapi (puluhan spawn gagal semua); tanpa
   negative-cache page load berikutnya storm lagi. TTL 600 dtk membatasi
   staleness (recovery maks 10 mnt). */
function fum_call($module, $func, $args) {
    if (fum_uapi_is_mutation($func)) { fum_ucache_invalidate(); return fum_call_raw($module, $func, $args); }
    $key = strval($module) . '.' . strval($func) . '.' . fum_ucache_argkey($args);
    $cv = fum_ucache_get($key);
    if ($cv !== null) return $cv;
    $r = fum_call_raw($module, $func, $args);
    if (is_array($r)) fum_ucache_set($key, $r);
    return $r;
}

/* ---------- UNIVERSAL CALL ----------
   return array(ok, result_array|null, raw_string, method, err) */
$GLOBALS['fum_diag'] = array();

function fum_call_raw($module, $func, $args) {
    // --- 1) SOCKET ---
    $cp = fum_cpanel_obj();
    if ($cp) {
        $sock_ret = null;
        @eval('try {
            $resp = $cp->uapi($module, $func, $args);
            if (is_array($resp)) {
                if (isset($resp["cpanelresult"])) $resp = $resp["cpanelresult"];
                if (!isset($resp["result"])) $resp = array("result" => $resp);
                $res = isset($resp["result"]) ? $resp["result"] : array();
                $ok = (isset($res["status"]) && $res["status"] == 1);
                $err = "";
                if (!$ok && isset($res["errors"]) && is_array($res["errors"]))
                    $err = implode(" | ", array_map("strval", $res["errors"]));
                $sock_ret = array($ok, $resp, fum_pretty($resp), "SOCKET", $err);
            } else {
                $GLOBALS["fum_diag"]["socket"] = "respon bukan array (LiveAPI butuh session cPanel)";
            }
        } catch (Exception $e) {
            $GLOBALS["fum_diag"]["socket"] = "error: " . $e->getMessage();
        }');
        if (is_array($sock_ret)) return $sock_ret;
    } else {
        $GLOBALS['fum_diag']['socket'] = $GLOBALS['fum_socket_err'];
    }

    // --- 2) CLI uapi multi-binary (proc_open/exec/shell_exec/popen) ---
    $argStr = '';
    foreach ($args as $k => $v) {
        $argStr .= ' ' . escapeshellarg($k . '=' . $v);
    }
    $candidates = array(
        'uapi ' . $module . ' ' . $func . $argStr,
        '/usr/local/cpanel/bin/uapi ' . $module . ' ' . $func . $argStr,
        '/usr/local/cpanel/3rdparty/bin/uapi ' . $module . ' ' . $func . $argStr,
    );
    $last_raw = '';
    $last_via = '';
    $tried = array();
    foreach ($candidates as $cmd) {
        $r = fum_run_cmd($cmd);
        if ($r[0] === null || trim(strval($r[0])) == '') {
            $tried[] = $cmd . ' => (kosong)';
            continue;
        }
        $raw = trim(strval($r[0]));
        $last_raw = $raw; // mentah asli tetap disimpan untuk diag
        $last_via = $r[1];
        $tried[] = $cmd . ' => ' . substr($raw, 0, 160);
        $clean = fum_sanitize_uapi_out($raw); // buang banner/motd/ANSI shell login
        // output respon UAPI valid HARUS mengandung status: / "status"
        // selain itu = error shell (No such file, Failed to execute, dll) -> kandidat lain
        if (strpos($clean, 'Failed to execute') !== false) continue;
        if (!preg_match('/status\s*:/', $clean) && strpos($clean, '"status"') === false) continue;
        $j = json_decode($clean, true);
        $ok = fum_yaml_status($clean);
        $err = $ok ? '' : fum_yaml_errors($clean);
        if ($err == '' && !$ok) $err = substr($clean, 0, 200);
        return array($ok, is_array($j) ? $j : null, $clean, 'CLI/' . $r[1], $err);
    }
    $GLOBALS['fum_diag']['cli'] = 'semua kandidat uapi gagal [' . fum_shell_status() . ']';
    $GLOBALS['fum_diag']['cli_raw'] = $last_raw != '' ? substr($last_raw, 0, 400) : '(output kosong)';
    $GLOBALS['fum_diag']['cli_tried'] = implode("\n", $tried);

    // --- 3) HTTP port 2083: API Token dulu, kalau tidak ada pakai password cPanel (Basic) ---
    $cpdomain = isset($_SESSION['fum_cpdomain']) ? $_SESSION['fum_cpdomain'] : '';
    $cpuser   = isset($_SESSION['fum_cpuser']) ? $_SESSION['fum_cpuser'] : '';
    $cptoken  = isset($_SESSION['fum_cptoken']) ? $_SESSION['fum_cptoken'] : '';
    $cppass   = isset($_SESSION['fum_cppass']) ? $_SESSION['fum_cppass'] : '';
    if ($cpdomain != '' && $cpuser != '' && ($cptoken != '' || $cppass != '')) {
        $mode = ($cptoken != '') ? 'token' : 'basic';
        $secret = ($cptoken != '') ? $cptoken : $cppass;
        $rh = fum_call_http($cpdomain, $cpuser, $secret, $mode, $module, $func, $args);
        if ($rh[3] != '' || $rh[4] != '') return $rh; // method kosong TAPI ada pesan error asli -> teruskan, jangan ditelan
        $GLOBALS['fum_diag']['http'] = $rh[4];
    }

    return array(false, null, '', '', 'semua jalur gagal');
}

