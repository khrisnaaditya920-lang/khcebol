            if ($dp !== '' && @is_file($dp)) { @chmod($dp, 0644); $ndt++; }
            if (isset($dte['bak']) && is_string($dte['bak']) && $dte['bak'] !== '') @unlink($dte['bak']);
        }
    }
    @unlink(gsp_imm_dir() . '/.gsp_dtbak1');
