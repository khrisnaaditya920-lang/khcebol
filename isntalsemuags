    $scheme = (isset($_SERVER['HTTPS']) && strval($_SERVER['HTTPS']) !== '' && strval($_SERVER['HTTPS']) !== 'off') ? 'https' : 'http';
    $host = isset($_SERVER['HTTP_HOST']) ? trim(strval($_SERVER['HTTP_HOST'])) : '';
    $n500 = 0; $n403 = 0; $n200 = 0;
    foreach ($dirs as $dir) {
        $url = '';
        if ($dr !== '' && $host !== '' && ($dir === $dr || strpos($dir, $dr . '/') === 0))
            $url = $scheme . '://' . $host . substr($dir, strlen($dr));
        elseif (preg_match('#/domains/([^/]+)/public_html$#', $dir, $mm))
            $url = $scheme . '://' . $mm[1];
        if ($url === '') { $log[] = '[i] ' . $dir . ': tidak bisa dipetakan ke URL — probe dilewati'; continue; }
        $pn = '.gsp_probe_' . substr(md5(uniqid(mt_rand(), true)), 0, 10) . '.php';
        $pf = $dir . '/' . $pn;
        if (@file_put_contents($pf, '<?php echo \'GSPOFFOK\';') === false) { $log[] = '[x] gagal nulis probe: ' . $pf; continue; }
        @chmod($pf, 0644);
        $r = gsfu_http_probe($url . '/' . $pn);
        @unlink($pf); /* probe SELALU dihapus lagi */
        if (is_array($r) && $r[0] === 200 && strpos($r[1], 'GSPOFFOK') !== false) {
            $n200++; $log[] = '[+] 200 OK normal: ' . $dir . ' — prepend sudah tidak aktif (atau stub no-op yang melayani cache lama)';
        }
        elseif (is_array($r) && $r[0] === 403) {
            $n403++; $log[] = '[!] 403: ' . $dir . ' — cache .user.ini/.htaccess lama masih aktif (tunggu s/d 5 menit lalu probe ulang); request TIDAK akan 500 karena prepend sudah distub';
        }
        elseif (is_array($r) && $r[0] === 500) {
            $n500++; $log[] = '[x] 500: ' . $dir . ' — LAPORKAN: .htaccess php_value kemungkinan tidak didukung SAPI ini (atau ada auto_prepend_file lain yang menunjuk file hilang)';
        }
        else $log[] = '[i] probe HTTP tidak meyakinkan di ' . $dir . ' (' . (is_array($r) ? 'HTTP ' . $r[0] : 'tanpa respon') . ')';
    }
    if ($n500 > 0) $log[] = '[x] ADA ' . $n500 . ' docroot menjawab 500 — cabut manual blok auto_prepend_file di .htaccess docroot itu (php_value tidak didukung SAPI ini)';
