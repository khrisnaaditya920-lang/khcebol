   di pts-nya lalu dibunuh. Peta proses dibangun dari /proc murni PHP. */
function gsp_proc_stat($pid) {
    $s = @file_get_contents('/proc/' . intval($pid) . '/stat');
    if (!is_string($s) || $s === '') return false;
    $r = strrpos($s, ')');
    if ($r === false) return false;
    $f = preg_split('/\s+/', trim(substr($s, $r + 1)));
    if (count($f) < 5) return false;
    return array('ppid' => intval($f[1]), 'tty' => intval($f[4]));
