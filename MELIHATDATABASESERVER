<?php
/**
 * phpmyct.php - Single-file lightweight phpMyAdmin-like tool (MySQL only)
 * Compatible with PHP 5.3+ (works on PHP 5.6, 7.x, 8.x)
 *
 * SECURITY: Use only in secure/trusted environment.
 */

/* ====== CONFIG: minimal defaults ====== */
$DEFAULT_HOST = '127.0.0.1';
$DEFAULT_PORT = '3306';
$DEFAULT_USER = 'root';
$DEFAULT_PASS = '';
$DEFAULT_DB   = '';
$DEFAULT_LIMIT = 50;
/* ====== END CONFIG ====== */

session_start();
error_reporting(E_ALL & ~E_NOTICE);
@ini_set('display_errors', 1);

// helper functions (compatible)
function h($s){
    // ENT_QUOTES is widely supported; avoid ENT_SUBSTITUTE for older PHP
    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
}
function flash($m){
    $_SESSION['_flash'] = $m;
}
function get_flash(){
    $m = isset($_SESSION['_flash']) ? $_SESSION['_flash'] : null;
    if (isset($_SESSION['_flash'])) unset($_SESSION['_flash']);
    return $m;
}
function redirect($u){
    header("Location: $u");
    exit;
}

// PDO from session creds
function pdo_from_session($withDb = true){
    if (empty($_SESSION['dbcfg'])) throw new Exception("Not connected.");
    $cfg = $_SESSION['dbcfg'];
    $host = $cfg['host']; $port = $cfg['port']; $user = $cfg['user']; $pass = $cfg['pass'];
    $db = ($withDb && !empty($cfg['db'])) ? $cfg['db'] : null;
    $dsn = "mysql:host={$host};port={$port};charset=utf8mb4";
    if ($db) $dsn .= ";dbname={$db}";
    // options: not all PHP versions support all constants, but these are safe on 5.3+
    $opts = array(PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC);
    return new PDO($dsn, $user, $pass, $opts);
}

// handle logout / disconnect
if (isset($_GET['action']) && $_GET['action'] === 'logout') {
    unset($_SESSION['dbcfg']);
    flash('Disconnected.');
    redirect(basename(__FILE__));
}

// handle login (store creds in session)
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'connect') {
    $host = isset($_POST['host']) ? trim($_POST['host']) : $DEFAULT_HOST;
    $port = isset($_POST['port']) ? trim($_POST['port']) : $DEFAULT_PORT;
    $user = isset($_POST['user']) ? trim($_POST['user']) : $DEFAULT_USER;
    $pass = isset($_POST['pass']) ? $_POST['pass'] : $DEFAULT_PASS;
    $db   = isset($_POST['db']) ? trim($_POST['db']) : $DEFAULT_DB;
    try {
        // test connect (without DB if empty)
        $dsn = "mysql:host={$host};port={$port};charset=utf8mb4" . ($db ? ";dbname={$db}" : "");
        $pdo = new PDO($dsn, $user, $pass, array(PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION));
        $_SESSION['dbcfg'] = array('host'=>$host,'port'=>$port,'user'=>$user,'pass'=>$pass,'db'=>$db);
        flash('Connected.');
        redirect(basename(__FILE__));
    } catch (Exception $e) {
        $login_error = $e->getMessage();
    }
}

// POST actions (CRUD, import, export, run SQL)
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action'])) {
    $act = $_POST['action'];
    try {
        if ($act === 'run_sql') {
            $_SESSION['_last_sql'] = isset($_POST['sql']) ? $_POST['sql'] : '';
            redirect(basename(__FILE__) . '?view=sql');
        }

        if ($act === 'export_csv') {
            if (empty($_POST['db']) || empty($_POST['table'])) throw new Exception("Parameters missing.");
            $_SESSION['dbcfg']['db'] = $_POST['db'];
            $pdo = pdo_from_session();
            $table = $_POST['table'];
            $stmt = $pdo->query("SELECT * FROM `".$table."`");
            $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
            header('Content-Type: text/csv; charset=utf-8');
            header('Content-Disposition: attachment; filename="'.preg_replace('/[^a-z0-9_.-]/i','_',$table).'.csv"');
            $out = fopen('php://output','w');
            if ($rows) {
                fputcsv($out, array_keys($rows[0]));
                foreach($rows as $r) fputcsv($out, array_values($r));
            }
            fclose($out);
            exit;
        }

        if ($act === 'export_sql') {
            if (empty($_POST['db'])) throw new Exception("DB missing.");
            $_SESSION['dbcfg']['db'] = $_POST['db'];
            $pdo = pdo_from_session();
            $db = $_POST['db'];
            // simple dump: tables + CREATE + INSERTs
            $tables = $pdo->query("SHOW FULL TABLES WHERE Table_type='BASE TABLE'")->fetchAll(PDO::FETCH_COLUMN);
            header('Content-Type: application/sql; charset=utf-8');
            header('Content-Disposition: attachment; filename="'.preg_replace('/[^a-z0-9_.-]/i','_',$db).'_dump.sql"');
            foreach($tables as $t) {
                echo "-- Table: {$t}\n";
                $createRow = $pdo->query("SHOW CREATE TABLE `".$t."`")->fetch(PDO::FETCH_ASSOC);
                // some drivers return different keys; try to find the CREATE column
                $createSql = '';
                if (isset($createRow['Create Table'])) $createSql = $createRow['Create Table'];
                else {
                    foreach($createRow as $val) { $createSql = $val; break; }
                }
                echo $createSql . ";\n\n";
                $rows = $pdo->query("SELECT * FROM `".$t."`")->fetchAll(PDO::FETCH_NUM);
                if ($rows) {
                    foreach ($rows as $r) {
                        $vals = array();
                        foreach ($r as $v) {
                            if ($v === null) $vals[] = 'NULL';
                            else $vals[] = $pdo->quote($v);
                        }
                        echo "INSERT INTO `{$t}` VALUES (".implode(',', $vals).");\n";
                    }
                    echo "\n";
                }
            }
            exit;
        }

        if ($act === 'import_csv') {
            if (!isset($_FILES['csvfile'])) throw new Exception("No file uploaded.");
            $db = isset($_POST['db']) ? $_POST['db'] : '';
            $table = isset($_POST['table']) ? $_POST['table'] : '';
            $_SESSION['dbcfg']['db'] = $db;
            $pdo = pdo_from_session();
            $tmp = $_FILES['csvfile']['tmp_name'];
            if (!is_uploaded_file($tmp)) throw new Exception("Upload failed.");
            $fh = fopen($tmp,'r');
            $headers = fgetcsv($fh);
            if (!$headers) throw new Exception("Empty CSV or invalid.");
            $placeholders = array();
            for ($i=0;$i<count($headers);$i++) $placeholders[] = '?';
            $place = '(' . implode(',', $placeholders) . ')';
            $cols = '`'.implode('`,`',$headers).'`';
            $sql = "INSERT INTO `{$table}` ({$cols}) VALUES {$place}";
            $stmt = $pdo->prepare($sql);
            $count = 0;
            while(($row = fgetcsv($fh)) !== false) {
                // ensure row has correct length: pad with nulls if shorter
                if (count($row) < count($headers)) {
                    $row = array_pad($row, count($headers), null);
                }
                $stmt->execute($row);
                $count++;
            }
            fclose($fh);
            flash("Imported {$count} rows.");
            redirect(basename(__FILE__) . '?view=table&db='.urlencode($db).'&table='.urlencode($table));
        }

        if ($act === 'import_sql') {
            if (!isset($_FILES['sqlfile'])) throw new Exception("No SQL file uploaded.");
            $db = isset($_POST['db']) ? $_POST['db'] : '';
            $_SESSION['dbcfg']['db'] = $db;
            $pdo = pdo_from_session();
            $sql = file_get_contents($_FILES['sqlfile']['tmp_name']);
            if ($sql === false) throw new Exception("Cannot read file.");
            // split by semicolon naive-ly (works for most simple dumps)
            $queries = array_filter(array_map('trim', preg_split('/;\s*[\r\n]+/', $sql)));
            $count = 0;
            foreach ($queries as $q) {
                if ($q === '') continue;
                $pdo->exec($q);
                $count++;
            }
            flash("Imported SQL (approx statements: {$count}).");
            redirect(basename(__FILE__));
        }

        if ($act === 'delete_row') {
            $db = isset($_POST['db']) ? $_POST['db'] : '';
            $table = isset($_POST['table']) ? $_POST['table'] : '';
            $pk = isset($_POST['pk_json']) ? json_decode($_POST['pk_json'], true) : null;
            if (!$pk) throw new Exception("PK missing.");
            $_SESSION['dbcfg']['db'] = $db;
            $pdo = pdo_from_session();
            $where=array(); $params=array();
            foreach($pk as $col=>$val){ $where[] = "`".$col."` = :pk_".$col; $params[":pk_".$col]=$val; }
            $sql = "DELETE FROM `{$table}` WHERE ".implode(' AND ',$where)." LIMIT 1";
            $stmt = $pdo->prepare($sql); $stmt->execute($params);
            flash("Row deleted.");
            redirect(basename(__FILE__) . '?view=table&db='.urlencode($db).'&table='.urlencode($table));
        }

        if ($act === 'insert_row' || $act === 'update_row') {
            $db = isset($_POST['db']) ? $_POST['db'] : '';
            $table = isset($_POST['table']) ? $_POST['table'] : '';
            $_SESSION['dbcfg']['db'] = $db;
            $pdo = pdo_from_session();
            $data = array();
            foreach($_POST as $k=>$v){
                if (strpos($k,'col__')===0){
                    $col = substr($k,5); $data[$col] = $v;
                }
            }
            if ($act === 'insert_row') {
                $cols = array_keys($data);
                $placeholders = array();
                for ($i=0;$i<count($cols);$i++) $placeholders[] = '?';
                $sql = "INSERT INTO `{$table}` (`".implode('`,`',$cols)."`) VALUES (".implode(',', $placeholders).")";
                $stmt = $pdo->prepare($sql);
                $stmt->execute(array_values($data));
                flash("Row inserted.");
            } else {
                $pk = isset($_POST['pk_json']) ? json_decode($_POST['pk_json'], true) : null;
                if (!$pk) throw new Exception("PK missing for update.");
                $sets=array(); $params=array(); $whereArr=array();
                foreach($data as $c=>$v){ $sets[] = "`".$c."` = :set_".$c; $params[":set_".$c]=$v; }
                foreach($pk as $c=>$v){ $params[":pk_".$c]=$v; $whereArr[] = "`".$c."` = :pk_".$c; }
                $sql = "UPDATE `{$table}` SET ".implode(',', $sets)." WHERE ".implode(' AND ', $whereArr)." LIMIT 1";
                $stmt = $pdo->prepare($sql);
                $stmt->execute($params);
                flash("Row updated.");
            }
            redirect(basename(__FILE__) . '?view=table&db='.urlencode($db).'&table='.urlencode($table));
        }

        if ($act === 'create_db') {
            $name = isset($_POST['dbname']) ? trim($_POST['dbname']) : '';
            if (!$name) throw new Exception("DB name missing.");
            $pdo = pdo_from_session(false);
            $pdo->exec("CREATE DATABASE `".str_replace('`','',$name)."`");
            flash("Database created.");
            redirect(basename(__FILE__));
        }

        if ($act === 'drop_db') {
            $name = isset($_POST['dbname']) ? trim($_POST['dbname']) : '';
            if (!$name) throw new Exception("DB name missing.");
            $pdo = pdo_from_session(false);
            $pdo->exec("DROP DATABASE `".str_replace('`','',$name)."`");
            flash("Database dropped.");
            redirect(basename(__FILE__));
        }

        if ($act === 'drop_table') {
            $db = isset($_POST['db']) ? $_POST['db'] : '';
            $table = isset($_POST['table']) ? $_POST['table'] : '';
            $_SESSION['dbcfg']['db'] = $db;
            $pdo = pdo_from_session();
            $pdo->exec("DROP TABLE `".$table."`");
            flash("Table dropped.");
            redirect(basename(__FILE__) . '?view=use_db&db='.urlencode($db));
        }
    } catch (Exception $e) {
        flash('Error: '.$e->getMessage());
        redirect(basename(__FILE__));
    }
}

// helpers: list dbs, list tables
function list_databases($pdo){
    return $pdo->query("SHOW DATABASES")->fetchAll(PDO::FETCH_COLUMN);
}
function list_tables($pdo, $db){
    // explicit USE ensures INFORMATION_SCHEMA queries don't interfere
    $pdo->exec("USE `".str_replace('`','',$db)."`");
    return $pdo->query("SHOW FULL TABLES WHERE Table_type='BASE TABLE'")->fetchAll(PDO::FETCH_COLUMN);
}
function get_table_columns($pdo, $db, $table){
    $sql = "SELECT COLUMN_NAME, COLUMN_TYPE, IS_NULLABLE, COLUMN_KEY, COLUMN_DEFAULT FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA = ".$pdo->quote($db)." AND TABLE_NAME = ".$pdo->quote($table)." ORDER BY ORDINAL_POSITION";
    return $pdo->query($sql)->fetchAll(PDO::FETCH_ASSOC);
}
function detect_primary_key_cols($cols){
    $pk=array();
    foreach($cols as $c) if (isset($c['COLUMN_KEY']) && $c['COLUMN_KEY']==='PRI') $pk[]=$c['COLUMN_NAME'];
    return $pk;
}

