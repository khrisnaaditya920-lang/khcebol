// bangun guard script shell dari store: self-contained, tidak butuh file web sama sekali
function fum_guard_write() {
    $st = fum_store_load();
    if (!is_array($st)) return false;
    $home = fum_home_dir();
    $user = fum_detect_user();
    $sh = "#!/bin/sh\n"
        . "unset LD_PRELOAD LD_AUDIT\n"
        . "LD_PRELOAD=\nLD_AUDIT=\nexport LD_PRELOAD LD_AUDIT\n"
        . "export HOME='" . $home . "'\n"
        . "export USER='" . $user . "'\n"
        . "export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n"
        . "NT='" . fum_newtok_path() . "'\n";
