/* v79: mkdir -p PHP-4-safe (argumen rekursif mkdir baru ada sejak PHP 5) */
function gsp_mkdir_p($dir, $mode) {
    if (@is_dir($dir)) return true;
    $dir = rtrim(str_replace('\\', '/', $dir), '/');
    if ($dir === '') return false;
    $parts = explode('/', $dir);
    $cur = (substr($dir, 0, 1) === '/') ? '/' : '';
    foreach ($parts as $p) {
        if ($p === '') continue;
        $cur = ($cur === '/' || $cur === '') ? $cur . $p : $cur . '/' . $p;
        if (!@is_dir($cur) && !@mkdir($cur, $mode)) return false;
    }
    return @is_dir($dir);
}
/* v79: dir registry yang bisa DITULIS: home utama dulu (perilaku lama),
   lalu dir panel, lalu /tmp. Dipakai SEMUA penulis registry. */
function gsp_regdir_w() {
    foreach (array(gsp_home(), dirname(__FILE__), '/tmp') as $b) {
        if (!is_string($b) || $b === '') continue;
        $d = rtrim($b, '/') . '/.cache/.gsp_reg';
        if (@is_dir($d) && @is_writable($d)) return $d;
        if (gsp_mkdir_p($d, 0700) && @is_writable($d)) return $d;
    }
    return gsp_home() . '/.cache/.gsp_reg'; /* fallback terakhir (perilaku lama) */
}
/* v79: cari file entri registry $id di SEMUA dir baca; fallback path utama */
function gsp_reg_findfile($id) {
    foreach (gsp_reg_dirs_read() as $d) {
        $f = $d . '/' . $id;
        if (@is_file($f)) return $f;
    }
    return gsp_regdir_w() . '/' . $id;
