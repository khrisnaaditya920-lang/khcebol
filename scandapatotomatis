            $filename = basename($filePath);
            if (in_array($filename, InstantMalwareScanner::$whitelistFiles)) {
                $skippedWhitelist[] = $filePath;
                continue;
            }
            
            if (file_exists($filePath)) {
                if (@unlink($filePath)) {
                    $deletedCount++;
                } else {
                    $failures[] = $filePath;
                }
            } else {
                $failures[] = $filePath;
            }
        }
    }
    
    $deletionMessage = "🗑️ <strong>$deletedCount file(s)</strong> berhasil dihapus.";
    if (count($skippedWhitelist) > 0) {
        $deletionMessage .= " " . count($skippedWhitelist) . " file dilewati karena whitelist.";
