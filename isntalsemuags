    reg_secret "$s" "" "file startup" "root"
done
echo "------------------------------------------------------------"
echo "[OK] CATAT ROOT selesai: proses -> $NOK tercatat, $NDUP duplikat, $NNOSEC tanpa secret — ditambah hasil scan disk (baris tercatat/disk di atas)"
echo "[i] REFRESH panel sekarang — entri ROOT baru muncul LENGKAP dengan secret"
exit 0
';
    return gsp_root_tpl($tpl, array(
        'REGD' => gsp_sh_sq($o['regd']),
        'PHOME' => gsp_sh_sq($o['phome']),
    ));
}
