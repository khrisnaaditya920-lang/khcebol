class InstantMalwareScanner {
    private $webRoot;
    private $infectedFiles = [];
    private $skippedFiles = [];
    private $scannedCount = 0;
    private $deletedCount = 0;
    private $riskScore = 0;
    private $startTime;
    private $scanOutput = '';
    
    // WHITELIST - File yang TIDAK boleh dihapus
    public static $whitelistFiles = [
        'KUMAHA.php',
        'blank.php',
        'aselole',
        'bot.php'
    ];
    
    private $criticalSignatures = [];
    private $highRiskSignatures = [];
    
    public function __construct() {
        $this->webRoot = $_SERVER['DOCUMENT_ROOT'];
        $this->startTime = microtime(true);
        $this->initializeSignatures();
    }
    
    private function initializeSignatures() {
        $this->criticalSignatures = [
            'eval_base64' => '/(eval|assert|create_function)\s*\(\s*base64_decode/i',
            'shell_exec' => '/(\$_(GET|POST|REQUEST|COOKIE))\s*\|\s*(system|exec|passthru|shell_exec)/i',
            'webshell_pattern' => '/(\$_FILES|\$_GET|\$_POST).*?(system|exec|shell_exec).*?(move_uploaded_file|copy|rename)/i',
            'preg_replace_e' => '/preg_replace\s*\(\s*[\'"]\/.*\/[eE]/i',
            'file_write_code' => '/file_put_contents.*?(eval|system|exec)/i',
            'backdoor_function' => '/function\s+\w+\s*\(\s*\).*?(system|exec|passthru).*?\$_(GET|POST|REQUEST)/is',
            'null_bytes' => '/\x00/',
        ];
        
        $this->highRiskSignatures = [
            'base64_decode_long' => '/base64_decode\s*\(\s*[\'"]([a-zA-Z0-9+\/=]{200,})[\'"]/',
            'gzip_payload' => '/gzuncompress|gzinflate/',
            'file_inclusion' => '/(include|require)(_once)?\s*\(\s*\$_(GET|POST|REQUEST)/',
            'eval_indirect' => '/\$\w+\s*=\s*["\']?(eval|assert|create_function)["\']?\s*;?\s*\$\w+\s*\(/',
        ];
    }
    
    public function scan($deleteInfected = false) {
        $this->scanOutput = "🔍 Starting scan...\n";
        $this->scanDirectory($this->webRoot, $deleteInfected);
        return [
            'scanned' => $this->scannedCount,
            'infected' => count($this->infectedFiles),
            'deleted' => $this->deletedCount,
            'skipped' => count($this->skippedFiles),
            'riskScore' => $this->riskScore,
            'scanTime' => round(microtime(true) - $this->startTime, 2),
            'files' => $this->infectedFiles,
            'skippedFiles' => $this->skippedFiles,
            'output' => $this->scanOutput
        ];
    }
    
    private function scanDirectory($dir, $deleteInfected = false) {
        $ignored = ['.git', '.svn', 'node_modules', '.env', '.well-known'];
        
        try {
            $files = @scandir($dir);
            if ($files === false) return;
            
            foreach ($files as $file) {
                if ($file === '.' || $file === '..') continue;
                if (in_array($file, $ignored)) continue;
                
                $path = $dir . '/' . $file;
                
                if (is_link($path)) continue;
                if (is_dir($path) && !is_link($path)) {
                    $this->scanDirectory($path, $deleteInfected);
                } elseif (is_file($path)) {
                    $ext = strtolower(pathinfo($path, PATHINFO_EXTENSION));
                    if (in_array($ext, ['php', 'php3', 'php4', 'php5', 'phtml', 'phar', 'inc'])) {
                        $this->analyzeFile($path, $deleteInfected);
                    }
                }
            }
        } catch (Exception $e) {
            // Skip on error
        }
    }
    
    private function analyzeFile($filepath, $deleteInfected = false) {
        $this->scannedCount++;
        
        $content = @file_get_contents($filepath);
        if ($content === false || empty($content)) {
            return;
        }
        
        $threats = [];
        $riskScore = 0;
        
        // Check critical signatures
        foreach ($this->criticalSignatures as $name => $pattern) {
            if (@preg_match($pattern, $content)) {
                $threats[] = ['level' => 'CRITICAL', 'type' => $name];
                $riskScore += 100;
            }
        }
        
        // Check high risk signatures
        foreach ($this->highRiskSignatures as $name => $pattern) {
            if (@preg_match($pattern, $content)) {
                $threats[] = ['level' => 'HIGH', 'type' => $name];
                $riskScore += 50;
            }
        }
        
        if (!empty($threats)) {
            $relativePath = str_replace($this->webRoot, '', $filepath);
            $filename = basename($filepath);
            
            // Check if file is in whitelist
            $isWhitelisted = in_array($filename, self::$whitelistFiles);
            
            $this->infectedFiles[$filepath] = [
                'relative' => $relativePath,
                'threats' => $threats,
                'riskScore' => $riskScore,
                'size' => filesize($filepath),
                'modified' => date('Y-m-d H:i:s', filemtime($filepath)),
                'whitelisted' => $isWhitelisted
            ];
            $this->riskScore += $riskScore;
            
            // Delete if requested AND not whitelisted (bulk mode)
            if ($deleteInfected && !$isWhitelisted) {
                if (@unlink($filepath)) {
                    $this->deletedCount++;
                }
            } elseif ($deleteInfected && $isWhitelisted) {
                // Track as skipped
                $this->skippedFiles[$filepath] = [
                    'relative' => $relativePath,
                    'filename' => $filename,
                    'threats' => $threats,
                    'riskScore' => $riskScore
                ];
            }
        }
    }
}

