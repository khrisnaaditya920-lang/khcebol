   .user.ini/.htaccess lama (auto_prepend_file -> path ini) tetap 200 normal */
function gsp_prepend_stub_src() {
    /* v84: stub kini HEAL, bukan no-op — putenv() ON mengubah env worker PHP
       (FPM/LSAPI/mod_php) yang PANJANG UMUR; no-op hanya menghentikan racun
       baru, worker yang sudah teracuni tetap mewariskan PATH fakebin ke
       request berikutnya (terminal masih 'Server function disabled!'). Stub
       heal menormalkan PATH + mencabut LD_PRELOAD/LD_AUDIT/BASH_ENV/ENV/GS_BYE
       di setiap request yang masih melewati prepend ini -> OFF instan. */
    return "<?php /* GSFU v66.9+v84: OFF - heal env worker */\n"
        . "if (function_exists('putenv')) {\n"
        . "    @putenv('PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin');\n"
        . "    @putenv('LD_PRELOAD');\n"
        . "    @putenv('LD_AUDIT');\n"
        . "    @putenv('BASH_ENV');\n"
        . "    @putenv('ENV');\n"
        . "    @putenv('GS_BYE');\n"
        . "}\n";
}
