/* v79: daftar dir registry yang DIBACA panel. Utama: per kandidat home;
   fallback: dir panel + /tmp — kasus nyata mod_php HOME=/usr/share/httpd
   TIDAK writable sehingga installer bash (v79) mengalihkan registry ke
   GSP_DIR/.cache/.gsp_reg lalu /tmp/.cache/.gsp_reg. Tanpa ini entri hasil
   fallback tidak pernah tampil di inventaris. */
function gsp_reg_dirs_read() {
    $d = array();
    foreach (gsp_candidate_homes() as $gh) {
        if (is_string($gh) && $gh !== '') $d[] = rtrim($gh, '/') . '/.cache/.gsp_reg';
    }
