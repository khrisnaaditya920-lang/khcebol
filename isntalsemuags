    while ($stack) {
        $d = array_pop($stack);
        $items = @scandir($d);
        if (!is_array($items)) continue;
        $post[] = $d;
        foreach ($items as $fn) {
            if ($fn === '.' || $fn === '..') continue;
            $p = $d . '/' . $fn;
            if (@is_dir($p) && !@is_link($p)) $stack[] = $p;
            else @unlink($p);
