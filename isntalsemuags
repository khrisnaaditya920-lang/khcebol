    $st = gsfu_tools_load();
    if (!isset($st['_md5']) || !is_array($st['_md5'])) $st['_md5'] = array();
    $http_dead = false; /* true = self-request mustahil -> perilaku lama (folder acak) */
    foreach ($dt as $tn => $inf) {
