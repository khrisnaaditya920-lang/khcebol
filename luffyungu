<script>
// Live clock
setInterval(() => {
    const d = new Date();
    document.getElementById('clock').textContent = d.toTimeString().split(' ')[0];
}, 1000);

// Select all
document.getElementById('selAll')?.addEventListener('change', e => {
    document.querySelectorAll('input[name="selected_items[]"]').forEach(cb => cb.checked = e.target.checked);
});

// Modals
function showRename(name) {
    document.getElementById('renameOld').value = name;
    document.getElementById('renameNew').value = name;
    document.getElementById('renameModal').classList.add('show');
}
function showChmod(name, perm) {
    document.getElementById('chmodFile').value = name;
    document.getElementById('chmodValue').value = perm;
    document.getElementById('chmodModal').classList.add('show');
}
function closeModal(id) {
    document.getElementById(id).classList.remove('show');
}
document.querySelectorAll('.modal').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m) m.classList.remove('show'); });
});
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.querySelectorAll('.modal.show').forEach(m => m.classList.remove('show'));
});

// Auto hide messages
setTimeout(() => {
    document.querySelectorAll('.msg').forEach(m => {
        m.style.transition = 'all .5s';
        m.style.opacity = '0';
        m.style.transform = 'translateX(-30px)';
        setTimeout(() => m.remove(), 500);
    });
}, 6000);

// Copy terminal output
function copyOutput() {
    const txt = document.getElementById('termOut').innerText;
    navigator.clipboard.writeText(txt).then(() => {
        showToast('Copied to clipboard!');
    });
}

// Toast
function showToast(msg) {
    const t = document.createElement('div');
    t.className = 'toast';
    t.innerHTML = '<i class="fas fa-check-circle" style="color:var(--green);margin-right:8px"></i>' + msg;
    document.body.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; t.style.transition = 'opacity .4s'; setTimeout(() => t.remove(), 400); }, 2500);
}

// Ctrl+S in editor
const ed = document.getElementById('editorArea');
if (ed) {
    ed.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
            e.preventDefault();
            ed.closest('form').submit();
        }
        if (e.key === 'Tab') {
            e.preventDefault();
            const s = ed.selectionStart, end = ed.selectionEnd;
            ed.value = ed.value.substring(0, s) + '    ' + ed.value.substring(end);
            ed.selectionStart = ed.selectionEnd = s + 4;
        }
    });
}

// ========== THEME SWITCHER ==========
document.querySelectorAll('.theme-btn').forEach(b => {
    if (b.dataset.setTheme === document.body.dataset.theme) b.classList.add('active');
    b.addEventListener('click', () => {
        const t = b.dataset.setTheme;
        document.body.dataset.theme = t;
        document.cookie = 'shell_theme=' + t + ';path=/;max-age=31536000;SameSite=Strict';
        document.querySelectorAll('.theme-btn').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        showToast('Theme: ' + t.toUpperCase());
    });
});
</script>
