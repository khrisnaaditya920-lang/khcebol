    if (is_array($om) && isset($om['dtools']) && is_array($om['dtools'])) {
        foreach ($om['dtools'] as $oe) {
            if (isset($oe['path']) && is_string($oe['path']) && $oe['path'] !== '') $oldp[] = $oe['path'];
        }
    }
    foreach (array_unique($oldp) as $op) {
        if (strpos($op, $doc . '/') === 0 && @is_file($op)) {
