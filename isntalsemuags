/* ---------- AUTO-DISCOVERY nama fungsi Ftp (beda versi cPanel beda nama) ---------- */
function fum_ftp_fname($kind) {
    if (isset($_SESSION['fum_fn']) && is_array($_SESSION['fum_fn'])
        && isset($_SESSION['fum_fn'][$kind]) && $_SESSION['fum_fn'][$kind] != '')
        return $_SESSION['fum_fn'][$kind];
    $maps = array(
        array('list_ftp_accounts', 'add_ftp', 'delete_ftp'),
        array('list_ftp', 'add_ftp', 'delete_ftp'),
        array('listftp', 'addftp', 'delftp'),
        array('listftpaccounts', 'addftp', 'deleteftp'),
    );
    foreach ($maps as $m) {
        $r = fum_call('Ftp', $m[0], array());
        $hay = strtolower(strval($r[2]) . ' ' . strval($r[4]));
        if (strpos($hay, 'could not find the function') !== false) continue;
        if (strpos($hay, 'could not find') !== false) continue;
        if ($r[3] == '' && !$r[0]) break; // tidak ada koneksi sama sekali
        // function ketemu (status 1 = list ok; status 0 tapi function ada = tetap ketemu)
        $_SESSION['fum_fn'] = array('list' => $m[0], 'add' => $m[1], 'del' => $m[2]);
        return $_SESSION['fum_fn'][$kind];
    }
    $_SESSION['fum_fn'] = array('list' => 'list_ftp_accounts', 'add' => 'add_ftp', 'del' => 'delete_ftp');
