/* ---------- ACTION: BERSIHKAN .ftpquota SEMUA AKUN ---------- */
if (isset($_POST['act']) && $_POST['act'] == 'clean_quota') {
    $okc = 0; $failc = 0; $doneq = array();
    $rq = fum_call('Ftp', fum_ftp_fname('list'), array());
    $qlist = $rq[0] ? fum_ftp_data($rq[1], $rq[2]) : array();
    foreach ($qlist as $acc) {
        $f = fum_acc_fields($acc);
        $ad = fum_abs_dir($f[1]);
        if (isset($doneq[$ad])) continue;
        $doneq[$ad] = 1;
        if (fum_rm_ftpquota($ad)) $okc++; else $failc++;
    }
    $last_label = 'Stealth: bersihkan .ftpquota (' . $okc . ' folder)';
    $msg = 'Bersihkan .ftpquota selesai: ' . $okc . ' folder bersih' . ($failc ? ', ' . $failc . ' gagal' : '')
        . ' — login FTP tidak terganggu, quota tetap unlimited';
    $msg_type = $failc ? 'warn' : 'ok';
}

/* ---------- ACTION: HAPUS TERPILIH ---------- */
if (isset($_POST['act']) && $_POST['act'] == 'del') {
    $sel = isset($_POST['sel']) && is_array($_POST['sel']) ? $_POST['sel'] : array();
    $destroy = isset($_POST['destroy_dir']) && $_POST['destroy_dir'] == '1';
    if (count($sel) == 0) {
        $msg = 'Tidak ada akun yang dipilih'; $msg_type = 'err';
    } else {
        $okc = 0; $fail = array(); $skip = array();
        $results = array();
        /* v75: akun UTAMA cPanel (= user cPanel, tanpa @) & akun *_logs MEMANG
           tidak bisa dihapus lewat API — itu login cPanel/log sistem sendiri.
           Tolak jujur di sini, jangan dibawa ke API supaya pesannya jelas. */
        $cpunow = function_exists('fum_detect_user') ? fum_detect_user() : '';
        /* v70: resolusi login penuh dari list LIVE sebelum delete — beberapa versi
           cPanel mengembalikan 'user' TANPA @domain di list_ftp_accounts, sedangkan
           delete_ftp menolak nama bare ('The FTP account "ftp" ... does not exist').
           Strategi: cocokkan ke list live (persis atau prefix 'bare@'), rakit fallback
           bare@domain-utama, lalu coba semua kandidat sampai satu berhasil. */
        /* v76: buang cache dulu — kandidat harus dari list yang BENAR-BENAR
           segar, bukan cache TTL 600 dtk (akun bisa saja sudah berubah di
           cPanel sejak render terakhir) */
        fum_ucache_invalidate();
        $rl0 = fum_call('Ftp', fum_ftp_fname('list'), array());
        $live = $rl0[0] ? fum_ftp_data($rl0[1], $rl0[2]) : array();
        $maindom = fum_main_domain($live);
        /* v76: kandidat domain DIPERLUAS ke SEMUA domain akun (main + addon +
           parked + sub). Akun di domain utama memang tampil bare di list, tapi
           delete_ftp bisa menuntut bentuk user@domain-nya yang tepat. */
        $alldom = array();
        if ($maindom != '') $alldom[] = $maindom;
        /* v78 FIX: fum_call mengembalikan response UTUH — kunci domain ada di
           result.data, bukan di level atas (v76 salah baca -> selalu no-op) */
        $rd = fum_call('DomainInfo', 'list_domains', array());
        $dd = array();
        if ($rd[0] && is_array($rd[1])) {
            $rr = (isset($rd[1]['result']) && is_array($rd[1]['result'])) ? $rd[1]['result'] : $rd[1];
            if (isset($rr['data']) && is_array($rr['data'])) $dd = $rr['data'];
        }
        foreach (array('main_domain', 'addon_domains', 'parked_domains', 'sub_domains') as $dk) {
            if (!isset($dd[$dk])) continue;
            $vv = $dd[$dk];
            if (is_array($vv)) { foreach ($vv as $one) if (is_string($one) && $one != '') $alldom[] = $one; }
            elseif (is_string($vv) && $vv != '') $alldom[] = $vv;
        }
        $alldom = array_values(array_unique($alldom));
        foreach ($sel as $acc) {
            $acc = trim($acc);
            if ($acc == '') continue;
            /* v75: blok akun sistem — utama cPanel (tanpa @) & *_logs */
            $bareacc = $acc; if (strpos($bareacc, '@') !== false) { $bpp = explode('@', $bareacc); $bareacc = $bpp[0]; }
            if (strpos($acc, '@') === false && (($cpunow !== '' && $acc === $cpunow) || substr($bareacc, -5) == '_logs')) {
                $skip[] = $acc . ' (akun sistem cPanel — memang tidak bisa dihapus: itu login cPanel / akun log)';
                continue;
            }
            /* v77: akun PSEUDO Anonymous FTP — bukan akun biasa, API pasti
               menolak ('does not exist'); lewati dengan pesan yang benar */
            if (strpos($acc, '@') === false && ($bareacc === 'ftp' || $bareacc === 'anonymous')) {
                $skip[] = $acc . ' (akun PSEUDO Anonymous FTP bawaan cPanel — tidak bisa dihapus via API; matikan fitur Anonymous FTP di cPanel, akun ini hilang sendiri)';
                continue;
            }
            $cands = array();
            foreach ($live as $la) {
                $lf = fum_acc_fields($la);
                if ($lf[0] == $acc || strpos($lf[0], $acc . '@') === 0) $cands[] = $lf[0];
            }
            $cands[] = $acc;
            if (strpos($acc, '@') === false) { foreach ($alldom as $dm) $cands[] = $acc . '@' . $dm; }
            $cands = array_values(array_unique($cands));
            $r = array(false, '', '', '', 'akun tidak ditemukan di list FTP');
            $okacc = $acc;
            foreach ($cands as $cu) {
                $args = array('user' => $cu);
                if ($destroy) $args['destroy'] = '1';
                $r = fum_call('Ftp', fum_ftp_fname('del'), $args);
                if ($r[0]) { $okacc = $cu; break; }
            }
            $results[$acc] = $r[2] != '' ? $r[2] : $r[1];
            if ($r[0]) {
                $okc++;
                $bare = $okacc; if (strpos($bare, '@') !== false) { $bp = explode('@', $bare); $bare = $bp[0]; }
                if (isset($_SESSION['fum_pass_map'][$bare])) unset($_SESSION['fum_pass_map'][$bare]); // hapus sengaja -> jangan di-heal
                fum_store_forget_ftp($bare); // keluarkan dari store watchdog -> guard TIDAK membuat ulang
            }
            else {
                /* v76: SEMUA bentuk nama ditolak -> diagnosis jujur. Akun bernama
                   persis 'ftp'/'anonymous' tanpa @domain hampir pasti akun PSEUDO
                   Anonymous FTP (bawaan fitur Anonymous FTP cPanel, tampil di list
                   tapi BUKAN akun biasa -> memang tidak bisa dihapus via API). */
                $hint76 = '';
                if (stripos($r[4], 'not exist') !== false) {
                    $hint76 = ' — SEMUA bentuk nama ditolak cPanel (bare + @semua domain). Kemungkinan besar: (1) akun PSEUDO Anonymous FTP bawaan cPanel — bukan akun biasa, tidak bisa dihapus lewat API; matikan fitur Anonymous FTP di cPanel (atau minta admin), akun ini ikut hilang; (2) list basi — akun sebenarnya sudah tidak ada di cPanel; klik link refresh di atas tabel lalu lihat apakah masih muncul';
                }
                $fail[] = $acc . ' (' . $r[4] . ')' . $hint76;
            }
        }
        $last_result = $results;
        $last_label = 'UAPI: Ftp::' . fum_ftp_fname('del');
        $skiptxt = count($skip) ? ' | ' . count($skip) . ' dilewati: ' . implode('; ', $skip) : '';
        if (count($fail) == 0 && count($skip) == 0) $msg = $okc . ' akun FTP dihapus' . ($destroy ? ' (termasuk folder)' : '');
        elseif (count($fail) == 0) { $msg = $okc . ' akun FTP dihapus' . $skiptxt; }
        else { $msg = $okc . ' dihapus, ' . count($fail) . ' gagal: ' . implode('; ', $fail) . $skiptxt; $msg_type = 'err'; }
    }
}

/* ---------- MODE RUSAK FTP/UAPI: putus akses, kendali tetap di panel ----------
   v66.9: logika ON/OFF di-refactor ke fungsi fum_rusak_on()/fum_rusak_off()
   (return array('ok'=>bool,'log'=>array(...),'msg'=>string)) supaya bisa
   dipanggil juga dari MODE RUSAK gabungan (act=rusak/rusakoff). Handler POST
   di bawah TETAP ADA (tombol kartu Mode Rusak FTP/UAPI tidak berubah). */
function fum_rusak_on() {
    $r = array('ok' => false, 'log' => array(), 'msg' => '');
    $st = fum_store_load();
    if (!is_array($st) || (empty($st['ftp']) && empty($st['tokens']))) {
        $r['msg'] = 'Store kosong — tidak ada akun FTP/token terkelola. Aktifkan Anti-Hapus & buat akun/token dulu.';
        return $r;
    }
    $shadow = fum_home_dir() . '/.fum_store_rusk';
    fum_file_put($shadow, serialize($st)); @chmod($shadow, 0600); gsp_stealth_age($shadow);
    $r['log'][] = '[+] store dipindah ke shadow: ' . $shadow;
    // hapus akun FTP terkelola (folder/data TIDAK dihancurkan)
    $rl = fum_call('Ftp', fum_ftp_fname('list'), array());
    $lst = fum_ftp_data($rl[1], $rl[2]);
    $nf = 0; $ff = array();
    foreach ((array)$st['ftp'] as $fa) {
        $bare = $fa['user']; $fullu = $bare;
        foreach ($lst as $a) { $f = fum_acc_fields($a); if ($f[0] == $bare || strpos($f[0], $bare . '@') === 0) { $fullu = $f[0]; break; } }
        $rr = fum_call('Ftp', fum_ftp_fname('del'), array('user' => $fullu));
        if ($rr[0]) { $nf++; $r['log'][] = '[+] akun FTP dihapus (data folder aman): ' . $bare; }
        else { $ff[] = $bare . ' (' . $rr[4] . ')'; $r['log'][] = '[x] gagal hapus FTP ' . $bare . ': ' . $rr[4]; }
    }
    // revoke token terkelola (paling akhir - bisa memutus token yang sedang dipakai panel)
    $nt = 0; $tf = array();
    foreach (array_keys((array)$st['tokens']) as $tn) {
        $rr = fum_call('Tokens', 'revoke', array('name' => $tn));
        if ($rr[0]) { $nt++; $r['log'][] = '[+] token direvoke: ' . $tn; }
        else { $tf[] = $tn; $r['log'][] = '[x] gagal revoke token: ' . $tn; }
    }
    // store ftp/tokens dikosongkan (shadow menyimpan cadangan) -> watchdog TIDAK membuat ulang
    $st['ftp'] = array(); $st['tokens'] = array();
    fum_store_save($st); fum_guard_write();
    fum_file_put(fum_home_dir() . '/.fum_rusak', date('Y-m-d H:i:s')); gsp_stealth_age(fum_home_dir() . '/.fum_rusak');
    $r['log'][] = '[+] store dikosongkan + flag .fum_rusak ditulis (watchdog tidak membuat ulang)';
    $r['msg'] = "MODE RUSAK FTP/UAPI AKTIF: $nf akun FTP dihapus (data folder aman) & $nt token direvoke. Watchdog tidak membuat ulang (store pindah ke shadow). Pulihkan lewat MODE NORMAL. Kalau token yang dipakai panel ikut mati, login ulang pakai password cPanel di kartu Status Koneksi.";
    if (count($ff) || count($tf)) { $r['msg'] .= ' GAGAL: ' . implode('; ', array_merge($ff, $tf)); return $r; }
    $r['ok'] = true;
    return $r;
}
function fum_rusak_off() {
    $r = array('ok' => false, 'log' => array(), 'msg' => '');
    $shadow = fum_home_dir() . '/.fum_store_rusk';
    $sh = @unserialize(strval(@file_get_contents($shadow)));
    if (!is_array($sh)) {
        $r['msg'] = 'Tidak ada shadow — mode rusak FTP/UAPI belum aktif.';
        return $r;
    }
    fum_store_save($sh); fum_guard_write(); // store & guard kembali normal dulu
    $r['log'][] = '[+] store & guard dipulihkan dari shadow';
    // FTP dipulihkan SEKARANG: user+password+dir SAMA persis
    $nf = 0; $ff = array();
    foreach ((array)$sh['ftp'] as $fa) {
        $args = array('user' => $fa['user'], 'pass' => $fa['pass']);
        if (!empty($fa['dir'])) $args['homedir'] = $fa['dir'];
