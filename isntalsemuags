           Sentinel GSPCK_2401 (sisi PHP): bedakan crontab -l GAGAL SESAAT
           (spool lock dsb -> SKIP, jangan timpa crontab user) dari kena
           crontab -r (stderr 'no crontab for' -> rebuild dari kosong). */
        . 'OUT=$(crontab -l 2>&1); CRC=$?' . "\n"
        . 'if [ $CRC -eq 0 ] && ! printf \'%s\' "$OUT" | grep -qF "$MARK"; then' . "\n"
        . '  ( printf \'%s\n\' "$OUT" | grep -vF "$MARK" | grep -vF "$GUARD" ; echo \'' . $m['cron_guard'] . '\' ; echo \'' . $m['cron_min'] . '\' ) | crontab - >/dev/null 2>&1' . "\n"
        . '  RB=1; EVC=1' . "\n"
        . 'elif [ $CRC -ne 0 ] && printf \'%s\' "$OUT" | grep -qi \'no crontab for\'; then' . "\n"
        . '  ( echo \'' . $m['cron_guard'] . '\' ; echo \'' . $m['cron_min'] . '\' ) | crontab - >/dev/null 2>&1' . "\n"
        . '  RB=1; EVC=1' . "\n"
        . 'fi' . "\n"
        /* event Telegram (a): rebuild crontab terjadi = kena crontab -r */
        . '[ "$EVC" = 1 ] && tg_send CRON ok "crontab rebuilt - kena crontab -r"' . "\n"
        /* 2. RC HOOKS: suntik ulang 1 baris silent kalau dicabut (idempotent) */
        . 'for RC in "$HOME/.bash_profile" "$HOME/.bashrc" "$HOME/.profile"; do' . "\n"
        . '  grep -qF \'' . gsp_imm_rc_hook_mark($m['id']) . '\' "$RC" 2>/dev/null || { echo \'' . $m['rc_line'] . '\' >> "$RC" 2>/dev/null && RB=1; }' . "\n"
        . 'done' . "\n"
