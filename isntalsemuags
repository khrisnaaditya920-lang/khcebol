/* argumen grep dari pola: [0] = " -e 'p1' -e 'p2'" (untuk grep -vF),
   [1] = regex gabungan preg_quote + sentinel GSPNOMATCH_x9z (untuk grep
   -vE) — sentinel memastikan regex tak pernah kosong sehingga grep tidak
   exit 1 saat output memang bersih */
function gsp_sil_grep_args($pats) {
    $clean = array();
    foreach ((array)$pats as $s) {
        $s = str_replace("'", '', strval($s));
        if ($s !== '' && !in_array($s, $clean, true)) $clean[] = $s;
    }
    if (!count($clean)) $clean[] = 'GSPNOMATCH_x9z';
    $fa = '';
    foreach ($clean as $s) $fa .= " -e '" . $s . "'";
    $rx = array();
    foreach ($clean as $s) $rx[] = preg_quote($s, '/');
    return array($fa, implode('|', $rx) . '|GSPNOMATCH_x9z');
