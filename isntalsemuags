    rh=$(printf "%s\n" "$env" | sed -n "s/^GSOCKET_HOST=//p;s/^GS_HOST=//p" | head -1)
    rp=$(printf "%s\n" "$env" | sed -n "s/^GSOCKET_PORT=//p;s/^GS_PORT=//p" | head -1)
    RLY=default
    [ -n "$rh" ] && RLY="$rh:${rp:-443}"
