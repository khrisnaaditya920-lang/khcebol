            const warning = '🚨 WARNING!\n\n' +
                'Mode DELETE akan menghapus SEMUA file yang terdeteksi sebagai malware!\n\n' +
                'Pastikan Anda YAKIN sebelum melanjutkan.\n\n' +
                'Lanjutkan?';
            
            if (confirm(warning)) {
                document.querySelector('input[name="delete_infected"]').checked = true;
                alert('✅ Delete mode AKTIF. Klik "MULAI SCAN" untuk menjalankan dengan auto-delete.');
            }
        }
        
        function toggleSelectAll() {
            const selectAllCheckbox = document.getElementById('selectAll');
            const fileCheckboxes = document.querySelectorAll('.file-select-checkbox:not([disabled])');
            fileCheckboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
        }
    </script>
</body>
</html>
