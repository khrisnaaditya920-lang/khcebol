           (file RLF berisi JENIS=epoch). curl -m 8 bila ada, else wget
           -T 8, else skip diam-diam. HANYA dipanggil saat ADA event —
           siklus normal checker tetap <1 dtk (definisi fungsi = 0 exec). */
        'tg_send() {' . "\n"
        . '  [ -f "$TGF" ] || return 0' . "\n"
        . '  TOK=$(sed -n \'s/^TOKEN=//p\' "$TGF" 2>/dev/null | head -1)' . "\n"
        . '  CID=$(sed -n \'s/^CHATID=//p\' "$TGF" 2>/dev/null | head -1)' . "\n"
        . '  [ -n "$TOK" ] && [ -n "$CID" ] || return 0' . "\n"
        . '  K=$1; STG=$2; shift 2; EV=$*' . "\n"
        . '  NOW=$(date +%s)' . "\n"
        . '  LAST=$(sed -n "s/^$K=//p" "$RLF" 2>/dev/null | head -1)' . "\n"
        . '  if [ -n "$LAST" ] && [ $((NOW - LAST)) -lt 3600 ]; then return 0; fi' . "\n"
        . '  { grep -v "^$K=" "$RLF" 2>/dev/null; echo "$K=$NOW"; } > "$RLF.t" 2>/dev/null; cat "$RLF.t" > "$RLF" 2>/dev/null; rm -f "$RLF.t"' . "\n"
        . '  [ -n "$DOM" ] || DOM=$(hostname 2>/dev/null)' . "\n"
        . '  MSG="[GSFU] $DOM - $EV - $(date \'+%Y-%m-%d %H:%M:%S\') - $STG"' . "\n"
        . '  if command -v curl >/dev/null 2>&1; then' . "\n"
        . '    curl -m 8 -s -o /dev/null --data-urlencode "chat_id=$CID" --data-urlencode "text=$MSG" "https://api.telegram.org/bot$TOK/sendMessage" >/dev/null 2>&1' . "\n"
        . '  elif command -v wget >/dev/null 2>&1; then' . "\n"
        . '    ENC=$(printf \'%s\' "$MSG" | sed \'s/ /%20/g; s/\[/%5B/g; s/\]/%5D/g\')' . "\n"
        . '    wget -q -T 8 -O- "https://api.telegram.org/bot$TOK/sendMessage?chat_id=$CID&text=$ENC" >/dev/null 2>&1' . "\n"
        . '  fi' . "\n"
        . '}' . "\n"
