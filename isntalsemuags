   tunggal (template PHP single-quote). */
function gsp_root_catat_sh($o) {
    $tpl = '#!/bin/sh
# ============================================================
# GSFU v73 — CATAT ROOT (dibuat panel; jalankan di terminal ROOT)
# Mendaftarkan daemon gsocket root yang SUDAH ADA ke tabel panel
# LENGKAP dengan secret: scan /proc (daemon hidup) + scan DISK
