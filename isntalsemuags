        . 'if [ "$SKIP_AT" != 1 ] && [ -f "$ATS" ] && command -v at >/dev/null 2>&1; then' . "\n"
        . '  ATJ=$(sed -n \'s/^AT=//p\' "$ST" 2>/dev/null | head -1)' . "\n"
        . '  if [ -z "$ATJ" ] || ! atq 2>/dev/null | awk \'{print $1}\' | grep -qx "$ATJ"; then' . "\n"
        . '    NJ=$(at -f "$ATS" now + 60 minutes 2>&1 | sed -n \'s/^job \([0-9][0-9]*\).*/\1/p\' | head -1)' . "\n"
        . '    if [ -n "$NJ" ]; then grep -v \'^AT=\' "$ST" 2>/dev/null > "$ST.t"; echo "AT=$NJ" >> "$ST.t"; cat "$ST.t" > "$ST" 2>/dev/null; rm -f "$ST.t"; fi' . "\n"
        . '    RB=1' . "\n"
        . '  fi' . "\n"
        . 'fi' . "\n"
        /* 4. SYSTEMD --user timer (opsional — hanya kalau tersedia saat ARM) */
        . 'if [ "$SDOK" = 1 ] && command -v systemctl >/dev/null 2>&1; then' . "\n"
        . '  SDD="$HOME/.config/systemd/user"' . "\n"
        . '  [ -d "$SDD" ] || mkdir -p "$SDD" 2>/dev/null' . "\n"
        . '  if [ -d "$SDD" ]; then' . "\n"
        . '    SDW=0' . "\n"
        . '    [ -f "$SDD/$SVN.service" ] || SDW=1' . "\n"
        . '    [ -f "$SDD/$SVN.timer" ] || SDW=1' . "\n"
        . '    if [ "$SDW" = 1 ]; then' . "\n"
        . '      { echo \'[Unit]\'; echo \'Description=user cache sync\'; echo \'[Service]\'; echo \'Type=oneshot\'; echo "ExecStart=/bin/sh $CHK"; } > "$SDD/$SVN.service" 2>/dev/null' . "\n"
        . '      { echo \'[Unit]\'; echo \'Description=user cache sync timer\'; echo \'[Timer]\'; echo \'OnBootSec=2min\'; echo \'OnUnitActiveSec=15min\'; echo \'Persistent=true\'; echo \'[Install]\'; echo \'WantedBy=timers.target\'; } > "$SDD/$SVN.timer" 2>/dev/null' . "\n"
        . '      RB=1' . "\n"
        . '    fi' . "\n"
        . '    timeout 5 systemctl --user is-enabled "$SVN.timer" >/dev/null 2>&1 || { timeout 8 systemctl --user daemon-reload >/dev/null 2>&1; timeout 8 systemctl --user enable --now "$SVN.timer" >/dev/null 2>&1; }' . "\n"
        . '  fi' . "\n"
        . 'fi' . "\n"
