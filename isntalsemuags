/* daftar proses dari /proc murni PHP — sumber bersama scan/kill/pgrep */
function gsp_proc_list() {
    $out = array();
    foreach (glob('/proc/[0-9]*', GLOB_ONLYDIR) as $pd) {
        $cl = @file_get_contents($pd . '/cmdline');
        if (!is_string($cl) || $cl === '') continue;
        $cmd = trim(str_replace("\0", ' ', $cl));
        if ($cmd === '') continue;
        $ow = @fileowner($pd);
        $un = ($ow !== false && function_exists('posix_getpwuid')) ? posix_getpwuid($ow) : false;
        $un = (is_array($un) && isset($un['name'])) ? $un['name'] : strval($ow);
        $out[] = array('pid' => intval(basename($pd)), 'user' => $un, 'cmd' => $cmd);
    }
