/* v79: dir staging paket installer (.tgz). HOME bisa tidak writable
   (mod_php HOME=/usr/share/httpd) sehingga staging gagal diam-diam dan
   installer jatuh ke jalur download (butuh egress). Urutan: home, dir
   panel, sys temp. Return '' bila semua gagal (installer pakai download). */
function gsp_stage_dir() {
    $cand = array(gsp_home() . '/.fum_queue', dirname(__FILE__) . '/.fum_queue');
    $td = function_exists('sys_get_temp_dir') ? sys_get_temp_dir() : '/tmp';
    if (!is_string($td) || $td === '') $td = '/tmp';
    $cand[] = rtrim($td, '/') . '/.fum_queue';
    foreach ($cand as $d) {
        if (@is_dir($d) && @is_writable($d)) return $d;
        if (gsp_mkdir_p($d, 0700) && @is_writable($d)) return $d;
