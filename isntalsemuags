NOK=0; NDUP=0; NNOSEC=0
for pdir in /proc/[0-9]*; do
    p=${pdir#/proc/}
    [ -r "$pdir/environ" ] || continue
    env=$(tr "\0" "\n" < "$pdir/environ" 2>/dev/null)
    cmd=$(tr "\0" " " < "$pdir/cmdline" 2>/dev/null)
    exe=$(readlink "$pdir/exe" 2>/dev/null | sed "s/ (deleted)$//")
    comm=$(cat "$pdir/comm" 2>/dev/null)
    iscand=0
    case "$env" in *GS_SECRET=*) iscand=1 ;; esac
    case " $cmd $exe $comm " in
        *gs-netcat*|*gsnc*|*gs-sftp*|*gs-mount*|*/.gsp-*|*gsocket*) iscand=1 ;;
    esac
    [ "$iscand" = "1" ] || continue
