    if [ -n "$cmd" ]; then camo=$(basename "$(printf "%s" "$cmd" | cut -d" " -f1)" 2>/dev/null); fi
    if [ -z "$sec" ]; then
        NNOSEC=$((NNOSEC+1))
        echo "[!] pid $p ($camo) — secret TIDAK terbaca (argv tertimpa + tanpa GS_SECRET di environ + tanpa .sec)"
        echo "    opsi: restart daemon ini lewat INSTALL ROOT, atau catat manual di panel kalau secret diketahui"
        continue
    fi
