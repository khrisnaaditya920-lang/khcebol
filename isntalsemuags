function fum_probe_port21($host) {
    /* v78: guard fsockopen (fatal PHP 8 bila disabled — jalur RENDER panel) */
    if (!function_exists('fsockopen')) return array(false, 'fsockopen di-disable hosting');
    $errno = 0; $errstr = '';
    $fp = @fsockopen($host, 21, $errno, $errstr, 4);
    if (!$fp) return array(false, $errstr != '' ? $errstr : 'timeout / port 21 tertutup');
    @stream_set_timeout($fp, 4);
    $banner = @fgets($fp, 512);
    fclose($fp);
    $banner = trim(strval($banner));
    if (strpos($banner, '220') === 0) return array(true, $banner);
    return array(false, $banner != '' ? $banner : 'tidak ada banner FTP');
}
