# --- scan DISK (baru v73): daemon root yang SEDANG MATI pun ikut tercatat ---
# lokasi sistem sebelum public_html: /usr/lib, /var, /etc, /root + systemd +
# cron root + rc.local + history root. Dedupe by SECRET terhadap registry.
reg_secret() {
    s=$1; b=$2; src=$3; ty=$4
